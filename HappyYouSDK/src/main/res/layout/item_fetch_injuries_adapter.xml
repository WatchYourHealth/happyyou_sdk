<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <RelativeLayout
                android:id="@+id/rlInjury1"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight="1"
                android:background="@drawable/ic_light_pink_button_bg"
                android:clipChildren="true"
                android:clipToPadding="true">

                <ImageView
                    android:id="@+id/ivImageInjury1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginVertical="16dp"
                    android:layout_marginLeft="16dp"
                    android:src="@drawable/ic_dog_bite"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvInjuryName1"
                    style="@style/textViewWhite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="@dimen/margin_16dp"
                    android:text="Dog Bite"
                    android:textAllCaps="false" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlInjury2"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/ic_light_blue_button_bg"
                android:clipChildren="true"
                android:clipToPadding="true">

                <ImageView
                    android:id="@+id/ivImageInjury2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginVertical="16dp"
                    android:layout_marginLeft="16dp"
                    android:src="@drawable/ic_dog_bite"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvInjuryName2"
                    style="@style/textViewWhite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="@dimen/margin_16dp"
                    android:text="Dog Bite"
                    android:textAllCaps="false" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlInjury3"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight="1"
                android:background="@drawable/ic_light_orange_button_bg"
                android:clipChildren="true"
                android:clipToPadding="true">

                <ImageView
                    android:id="@+id/ivImageInjury3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginVertical="16dp"
                    android:layout_marginLeft="16dp"
                    android:src="@drawable/ic_dog_bite"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvInjuryName3"
                    style="@style/textViewWhite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="@dimen/margin_16dp"
                    android:text="Dog Bite"
                    android:textAllCaps="false" />

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>
</layout>
