<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".SpinWheel.Activities.SpinWheelActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wheel_screen_bg"
        android:orientation="vertical"
        android:weightSum="8">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3"
            android:weightSum="2"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/logoImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1.">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="30dp"
                    android:layout_marginHorizontal="42dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/bg_policy_kgi_bottom"
                    android:backgroundTint="@color/white"
                    android:src="@drawable/new_icon" />

            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_alignParentEnd="true"
                android:src="@drawable/new_login_bear" />


        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5.8"
            android:weightSum="2"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="42dp"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:background="@drawable/golden_border_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_margin="4dp"
                    android:background="@drawable/spin_wheel_layout_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal">


                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:id="@+id/ivSpinArrowout"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginTop="16dp"
                                android:src="@drawable/spin_arrow"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/ivOuterCircler"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginHorizontal="16dp"
                                android:src="@drawable/ic_spin_circle_background_shadow"
                                android:outlineAmbientShadowColor="#FFF655"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/ivSpinArrowout" />

                            <com.wyh.happyyousdk.utils.wheelview.LuckyWheel
                                android:id="@+id/lwv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="32dp"
                                app:background_color="@android:color/transparent"
                                app:layout_constraintBottom_toBottomOf="@id/ivOuterCircler"
                                app:layout_constraintEnd_toEndOf="@id/ivOuterCircler"
                                app:layout_constraintStart_toStartOf="@id/ivOuterCircler"
                                app:layout_constraintTop_toTopOf="@id/ivOuterCircler" />


                        </androidx.constraintlayout.widget.ConstraintLayout>



                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:id="@+id/spin_layout"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/spin_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="32dp"
                            android:textAlignment="center"
                            android:textSize="16sp"
                            android:visibility="gone"
                            android:textColor="@color/black">

                        </TextView>

                        <Button
                            android:id="@+id/click_to_spin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:text="@string/click_to_spin"
                            android:textAllCaps="false"
                            android:background="@drawable/spin_btn_img">

                        </Button>

                        <Button
                            android:id="@+id/click_to_disabled_spin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:hint="@string/click_to_spin"
                            android:textAllCaps="false"
                            android:visibility="gone"
                            android:background="@drawable/spin_btn_disabled_bg">

                        </Button>

                        <LinearLayout
                            android:id="@+id/skip_to_login"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="22dp"
                            android:background="@drawable/skip_btn_img">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/skip_to_login"
                                android:textSize="14sp"
                                android:textColor="@color/black"
                                android:textAlignment="center"
                                android:padding="16dp">

                            </TextView>

                        </LinearLayout>




                    </LinearLayout>

                </LinearLayout>



            </LinearLayout>

        </LinearLayout>








    </LinearLayout>

</layout>