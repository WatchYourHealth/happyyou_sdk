<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="32dp"
            android:elevation="30dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_red_bg"
            android:visibility="gone" />

        <dev.skymansandy.scratchcardlayout.ui.ScratchCardLayout
            android:id="@+id/scratchView"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:background="@color/transparent"
            android:backgroundTint="@color/transparent"
            app:cardElevation="0dp"
            app:scratchDrawable="@drawable/scratch_card_orange_new"
            app:scratchEnabled="true"
            app:scratchRevealFullAtPercent="60"
            app:scratchWidth="50dp">

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/one_sided_curved_border_reward_new"
                android:padding="@dimen/margin_16dp">

                <ImageView
                    android:id="@+id/ivVendorLogo"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tvValue"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ivVendorLogo"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginTop="8dp"
                    android:text="0"
                    android:textColor="@color/black"
                    android:textSize="18dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvEarned"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvValue"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginTop="8dp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:text="Successfully Earned"
                    android:textColor="@color/black"
                    android:textSize="18dp" />

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvEarned"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginTop="8dp"
                    android:text="sample"
                    android:textColor="@color/black"
                    android:textSize="16dp" />

                <TextView
                    android:id="@+id/tvDescription"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvTitle"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="sample"
                    android:textColor="@color/grayLight"
                    android:textSize="14dp" />
                <LinearLayout
                    android:id="@+id/ll_scratchview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvDescription"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/TextStyleBlack16sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="How to use" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Click on view button and visit hobby tribe" />

                </LinearLayout>
                <TextView
                    android:id="@+id/tvAmount"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ll_scratchview"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="sample"
                    android:visibility="gone"
                    android:textColor="@color/grayLight"
                    android:textSize="14dp" />



                <RelativeLayout
                    android:id="@+id/llCopy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="@dimen/margin_8dp"
                    android:layout_marginTop="16dp"
                    android:layout_below="@+id/tvAmount"
                    android:background="@drawable/gray_rc_bg_16dp"
                    android:paddingStart="@dimen/margin_16dp">

                    <TextView
                        android:id="@+id/tvCouponCode"
                        style="@style/font_16sp_roboto_regular_black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="4dp"
                        android:layout_toStartOf="@+id/view_voucher"
                        android:ellipsize="end"
                        android:text="sample Code" />

                    <ImageView
                        android:id="@+id/view_voucher"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:layout_centerVertical="true"
                        android:visibility="gone"
                        android:layout_toStartOf="@+id/tvCopy"
                        android:src="@drawable/baseline_remove_red_eye_24">

                    </ImageView>

                    <TextView
                        android:id="@+id/tvCopy"
                        style="@style/font_15sp_roboto_regular_white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/blue_rc_bg_16dp"
                        android:paddingHorizontal="@dimen/margin_16dp"
                        android:paddingVertical="4dp"
                        android:text="Copy" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/voucher_expiry_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textAlignment="center"
                    android:padding="8dp"
                    android:layout_below="@+id/llCopy"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:textColor="@color/red">

                </TextView>

                <LinearLayout
                    android:id="@+id/llActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/margin_16dp"
                    android:gravity="center"
                    android:weightSum="1"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@+id/voucher_expiry_tv"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRedeem"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_weight="0.5"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/blue_rc_bg_8dp"
                        android:fontFamily="@font/roboto_medium"
                        android:text="View"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16dp" />


                    <Button
                        android:id="@+id/btnNegative"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_weight="0.5"
                        android:layout_marginStart="@dimen/margin_10dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/margin_10dp"
                        android:background="@drawable/pink_rc_bg_8dp"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Close"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16dp"
                        android:visibility="visible" />

                </LinearLayout>

            </RelativeLayout>
            </ScrollView>

        </dev.skymansandy.scratchcardlayout.ui.ScratchCardLayout>

    </RelativeLayout>

</layout>
