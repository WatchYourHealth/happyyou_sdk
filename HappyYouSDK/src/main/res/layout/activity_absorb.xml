<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".absorb.HealthHacksActivity">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="40dp"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/rl_top_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="340dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_activity_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:src="@drawable/bg_steps_without_bear" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:padding="16dp">


                        <LinearLayout
                            android:id="@+id/search_parent_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2"
                            android:layout_marginTop="32dp">

                            <com.devlomi.hidely.hidelyviews.HidelyLinearLayout
                                android:id="@+id/health_hacks_search_layout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:visibility="invisible"
                                android:background="@drawable/corner_back_white"
                                android:layout_weight="1.8"
                                android:layout_marginEnd="18dp"
                                android:orientation="horizontal">

                                <EditText
                                    android:id="@+id/health_hacks_search_et"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.8"
                                    android:hint="@string/search_bar_txt"
                                    android:layout_margin="12dp"
                                    android:maxLines="1"
                                    android:inputType="text"
                                    android:textSize="16sp"
                                    android:background="@color/transparent"
                                    android:fontFamily="@font/roboto_medium"/>

                                <ImageView
                                    android:id="@+id/health_hack_cancel"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:visibility="gone"
                                    android:layout_margin="12dp"
                                    android:src="@drawable/search_cancel">

                                </ImageView>


                            </com.devlomi.hidely.hidelyviews.HidelyLinearLayout>

                            <ImageView
                                android:id="@+id/health_hacks_search_img"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"
                                android:tint="@color/white"
                                android:src="@drawable/ic_round_search_24px"
                                android:layout_toEndOf="@id/search_bar_layout" />

                        </LinearLayout>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/search_view_card"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:layout_marginRight="32dp"
                            android:visibility="gone"
                            android:layout_marginTop="@dimen/margin_8dp"
                            android:layout_below="@+id/search_parent_layout"
                            app:cardCornerRadius="16dp">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/search_recycler_list"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginTop="4dp">

                            </androidx.recyclerview.widget.RecyclerView>


                        </androidx.cardview.widget.CardView>




                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/la_bear"
                            android:layout_width="wrap_content"
                            android:layout_height="120dp"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/bear_rocking_chair_reading_book" />
                    </RelativeLayout>

                    <include
                        android:id="@+id/includeToolbar"
                        layout="@layout/layout_back" />

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rl_top_layout"
                    android:layout_marginHorizontal="@dimen/margin_16dp"
                    android:layout_marginTop="-32dp"
                    android:orientation="vertical">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_tags"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/margin_8dp"
                                android:layout_marginTop="@dimen/margin_8dp" />

                            <!--    <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rv_tags_indicator"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginHorizontal="@dimen/margin_16dp"
                                    android:layout_marginTop="8dp" />-->
                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:id="@+id/rl_quick_read"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/margin_8dp"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:background="?attr/selectableItemBackground">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_quick_read" />

                                <TextView
                                    style="@style/font_15sp_roboto_medium_black"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="30dp"
                                    android:text="Quick Reads" />

                                <ImageView
                                    android:id="@+id/qr_more"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_arrow_forward" />

                            </RelativeLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_quick_reads"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/margin_8dp"
                                android:layout_marginTop="@dimen/margin_8dp" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_quick_reads_indicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginHorizontal="@dimen/margin_8dp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llHealthTv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:id="@+id/rl_health_tv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/margin_8dp"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:background="?attr/selectableItemBackground">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_health_tv" />

                                <TextView
                                    style="@style/font_15sp_roboto_medium_black"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="30dp"
                                    android:text="Health TV" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_arrow_forward" />
                            </RelativeLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_health_tv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/margin_8dp" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_health_tv_indicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginHorizontal="@dimen/margin_8dp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_health_tv_bookmark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:id="@+id/rl_health_tv_bookmark"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/margin_8dp"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:background="?attr/selectableItemBackground">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_health_tv" />

                                <TextView
                                    style="@style/font_15sp_roboto_medium_black"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="30dp"
                                    android:text="Bookmark Health TV Video" />

                                <ImageView
                                    android:id="@+id/ivBookmarkHealthTvMore"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_arrow_forward" />
                            </RelativeLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_health_tv_bookmark"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_health_tv_indicator_bookmark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_music_lib"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:id="@+id/rl_music_lib"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/margin_8dp"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:background="?attr/selectableItemBackground">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/music_libary" />

                                <TextView
                                    style="@style/font_15sp_roboto_medium_black"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="30dp"
                                    android:text="Music Library" />

                                <ImageView
                                    android:id="@+id/ivMusicLibraryMore"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_arrow_forward" />
                            </RelativeLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_music_lib"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_music_lib_indicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginHorizontal="@dimen/margin_8dp"
                                android:layout_marginTop="8dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:id="@+id/llWebinar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/margin_8dp"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:background="?attr/selectableItemBackground">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_webinar" />

                                <TextView
                                    style="@style/font_15sp_roboto_medium_black"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="30dp"
                                    android:text="Webinar" />

                            </RelativeLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_webinar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/margin_8dp" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_webinar_indicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginHorizontal="@dimen/margin_16dp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />

    </RelativeLayout>

</layout>