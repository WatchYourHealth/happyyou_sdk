<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <RelativeLayout
                android:id="@+id/rlWinnings1"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:background="@drawable/light_blue_button_bg"
                android:clipChildren="true"
                android:clipToPadding="true">

                <ImageView
                    android:id="@+id/ivImage1"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/margin_32dp" />

                <TextView
                    android:id="@+id/tvWinningName1"
                    style="@style/font_14sp_roboto_medium_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ivImage1"
                    android:layout_centerInParent="true"
                    android:layout_marginTop="4dp"
                    android:textAlignment="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:alpha="0.5"
                    android:background="@drawable/dark_gray_rc_bg_8dp"
                    android:gravity="center"
                    android:padding="16dp" />

                <TextView
                    android:id="@+id/tvPointsCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Members: 0"
                    android:textColor="@color/white"
                    android:textSize="10dp" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlWinning2"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/ic_light_pink_button_bg"
                android:visibility="visible">
                <ImageView
                    android:id="@+id/ivImage2"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/margin_32dp" />
                <TextView
                    android:id="@+id/tvWinningName2"
                    style="@style/font_14sp_roboto_medium_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ivImage2"
                    android:layout_marginTop="4dp"
                    android:textAlignment="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:alpha="0.5"
                    android:background="@drawable/dark_gray_rc_bg_8dp"
                    android:gravity="center"
                    android:padding="16dp" />

                <TextView
                    android:id="@+id/tvPointsCount2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Members: 0"
                    android:textColor="@color/white"
                    android:textSize="10dp" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlWinnings3"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:background="@drawable/ic_light_orange_button_bg"
                android:visibility="visible">
                <ImageView
                    android:id="@+id/ivImage3"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/margin_32dp"/>
                <TextView
                    android:id="@+id/tvWinningName3"
                    style="@style/font_14sp_roboto_medium_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_below="@id/ivImage3"
                    android:textAlignment="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:alpha="0.5"
                    android:background="@drawable/dark_gray_rc_bg_8dp"
                    android:gravity="center"
                    android:padding="16dp" />

                <TextView
                    android:id="@+id/tvPointsCount3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Members: 0"
                    android:textColor="@color/white"
                    android:textSize="10dp" />

            </RelativeLayout>


        </LinearLayout>


    </LinearLayout>
</layout>
