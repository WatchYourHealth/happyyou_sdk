<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
   >

    <RelativeLayout
        android:id="@+id/cvScoreItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/white_rc_bg_16dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:text="MPIN"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvSetMPIN"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please enter your MPIN"
                android:textColor="@color/black"
                android:textSize="12sp" />
            <EditText
                android:id="@+id/hiddenOTP"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:inputType="number"
                android:maxLength="4"
                android:visibility="gone" />
            <in.aabhasjindal.otptextview.OtpTextView
                android:id="@+id/edtOTP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:height="42dp"
                app:length="4"
                app:otp_box_background_active="@drawable/bg_active"
                app:otp_box_background_inactive="@drawable/edit_text_border"
                app:otp_text_size="16sp"
                app:width="42dp"
                android:focusable="true"
                android:layout_marginTop="5dp"
                app:hide_otp="true"
                app:hide_otp_drawable="@drawable/txt_pin"
                />


          <!--  <ImageView
                android:id="@+id/imSubmitMPIN"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/ic_policy_submit" />-->
            <TextView
                android:id="@+id/imSubmitMPIN"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:text="Submit"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:paddingTop="8dp"
                android:background="@drawable/ic_policy_submit_new"
                />
            <TextView
                android:id="@+id/tvForget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="50dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:text="Forget MPIN?"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvOr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Or"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imFingerPrint"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_policy_login_with_finger_print" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>