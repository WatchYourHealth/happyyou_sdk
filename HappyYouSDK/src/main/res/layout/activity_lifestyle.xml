<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/rl_top_layout"
            android:layout_width="wrap_content"
            android:layout_height="320dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_activity_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:src="@drawable/ic_hra_pink_bg" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginTop="38dp">

                    <com.devlomi.hidely.hidelyviews.HidelyLinearLayout
                        android:id="@+id/search_bar_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:visibility="invisible"
                        android:background="@drawable/corner_back_white"
                        android:layout_weight="1.8"
                        android:layout_marginEnd="18dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/life_style_search_et"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.8"
                            android:hint="@string/search_bar_txt"
                            android:layout_margin="12dp"
                            android:textSize="16sp"
                            android:inputType="text"
                            android:maxLines="1"
                            android:background="@color/transparent"
                            android:fontFamily="@font/roboto_medium"/>

                        <ImageView
                            android:id="@+id/lifestyle_search_cancel"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:visibility="invisible"
                            android:layout_margin="12dp"
                            android:src="@drawable/search_cancel"/>


                    </com.devlomi.hidely.hidelyviews.HidelyLinearLayout>

                    <ImageView
                        android:id="@+id/search_img"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.2"
                        android:tint="@color/white"
                        android:src="@drawable/ic_round_search_24px"
                        android:layout_toEndOf="@id/search_bar_layout" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/la_bear"
                    android:layout_width="200dp"
                    android:layout_height="140dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/ic_bear_ketteleball" />


            </RelativeLayout>



            <include
                android:id="@+id/includeBack"
                layout="@layout/layout_back" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/rl_top_layout"
            android:layout_marginTop="-42dp"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/life_style_recyler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

            </androidx.recyclerview.widget.RecyclerView>

            <TextView
                android:id="@+id/no_result_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Result Found"
                android:textAlignment="center"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:textStyle="bold"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:weightSum="3"
                android:visibility="gone">

                <RelativeLayout
                    android:id="@+id/rl_water"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:background="@drawable/light_blue_button_bg"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_centerInParent="true">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/ic_h2o_intake"
                            app:tint="@color/white" />

                        <TextView
                            style="@style/font_14sp_roboto_medium_white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/margin_8dp"
                            android:layout_marginTop="8dp"
                            android:text="H2O" />

                    </LinearLayout>

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlPillowTime"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/ic_light_pink_button_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_centerInParent="true">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/ic_sleep_star"
                            app:tint="@color/white" />

                        <TextView
                            style="@style/font_14sp_roboto_medium_white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/margin_8dp"
                            android:layout_marginTop="8dp"
                            android:text="Pillow Time" />

                    </LinearLayout>

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlHappyFoot"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:background="@drawable/ic_light_orange_button_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_centerInParent="true">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/ic_foot_prints"
                            app:tint="@color/white" />

                        <TextView
                            style="@style/font_14sp_roboto_medium_white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/margin_8dp"
                            android:layout_marginTop="8dp"
                            android:text="Happy Footprints" />

                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:weightSum="3"
                android:visibility="gone">

                <RelativeLayout
                    android:id="@+id/rlCalForce"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:background="@drawable/ic_light_orange_button_bg"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_centerInParent="true">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/ic_cal_burned"
                            app:tint="@color/white" />

                        <TextView
                            style="@style/font_14sp_roboto_medium_white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/margin_8dp"
                            android:layout_marginTop="8dp"
                            android:text="Cal - Count" />

                    </LinearLayout>

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl_active_hours"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/light_blue_button_bg">

                    <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_centerInParent="true">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_stand_time"
                        app:tint="@color/white" />

                    <TextView
                        style="@style/font_14sp_roboto_medium_white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/margin_8dp"
                        android:layout_marginTop="8dp"
                        android:text="Active Hours" />

                </LinearLayout>

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlWeight"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:background="@drawable/ic_light_pink_button_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_centerInParent="true">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/ic_ideal_weight"
                            app:tint="@color/white" />

                        <TextView
                            style="@style/font_14sp_roboto_medium_white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/margin_8dp"
                            android:layout_marginTop="8dp"
                            android:text="Weight Watcher" />

                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />

    </RelativeLayout>
</layout>
