<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end">

                <LinearLayout
                    android:id="@+id/ll_iv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_receive_msg_bg"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/iv_img"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:scaleType="fitXY" />

                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout

                        android:id="@+id/rl1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"


                        android:background="@drawable/reciveshape">


                        <ImageView
                            android:id="@+id/ivImage"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginBottom="20dp" />

                        <TextView
                            android:id="@+id/tv_message"
                            style="@style/font_15sp_roboto_regular_black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/ivImage"
                            android:layout_centerVertical="true"
                            android:layout_marginHorizontal="@dimen/margin_8dp"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="24dp"
                            android:paddingBottom="15dp"
                            android:text="get kf"
                            android:visibility="visible" />

                    </RelativeLayout>

                    <ImageView
                        android:id="@+id/img1"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_below="@+id/rl1"

                        android:background="@drawable/recievearow"
                        android:scaleType="fitXY" />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/rl1"
                        android:layout_marginEnd="10dp"

                        android:layout_toEndOf="@+id/rl1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12:12"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:text="By User"
                            android:textColor="@color/black"
                            android:textSize="10sp" />
                    </LinearLayout>

                </RelativeLayout>


            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</layout>