<?xml version="1.0" encoding="utf-8"?>
<layout>
    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ChallangesModule.Activities.NewTribeChallengeDashboard">

       <androidx.core.widget.NestedScrollView
           android:layout_width="match_parent"
           android:layout_height="match_parent">

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="match_parent"
               android:orientation="vertical">

               <include
                   android:id="@+id/includeToolbar"
                   layout="@layout/layout_back" />

               <RelativeLayout
                   android:id="@+id/rlHeader"
                   android:layout_width="wrap_content"
                   android:layout_height="180dp"
                   android:orientation="vertical">


                   <RelativeLayout
                       android:id="@+id/blue_bg"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_alignParentBottom="true">

                       <ImageView
                           android:layout_width="match_parent"
                           android:layout_height="120dp"
                           android:scaleType="fitXY"
                           android:src="@drawable/ic_top_blue_bg" />


                   </RelativeLayout>

                   <LinearLayout
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_alignParentBottom="true"
                       android:layout_centerHorizontal="true"
                       android:orientation="horizontal">

                       <Button
                           android:id="@+id/btnInvite"
                           android:layout_width="wrap_content"
                           android:layout_height="30dp"
                           android:layout_marginBottom="5dp"
                           android:background="@drawable/wyh_round_btn_dark_red"
                           android:text="@string/invite"
                           android:textAllCaps="false"
                           android:textColor="@color/white"
                           android:visibility="gone" />

                       <ImageView
                           android:id="@+id/ivInfoLevel"
                           android:layout_width="28dp"
                           android:layout_height="28dp"
                           android:layout_alignRight="@+id/btnRedeem"
                           android:layout_alignParentBottom="true"
                           android:layout_centerHorizontal="true"
                           android:layout_marginStart="@dimen/margin_8dp"
                           android:src="@drawable/ic_info"
                           android:visibility="gone" />


                   </LinearLayout>

                   <LinearLayout
                       android:id="@+id/tribe_header_layout"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:orientation="horizontal"
                       android:weightSum="2">

                       <LinearLayout
                           android:layout_width="0dp"
                           android:layout_height="match_parent"
                           android:layout_weight="1"
                           android:orientation="vertical">

                           <TextView
                               style="@style/TextStyleBlack16sp"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:textAlignment="center"
                               android:text="Tribe Name"
                               android:textSize="12sp" />

                           <TextView
                               android:id="@+id/tribeName"
                               style="@style/TextStyleBlack16sp"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:textAlignment="center"
                               android:textSize="12sp" />


                       </LinearLayout>

                       <LinearLayout
                           android:layout_width="0dp"
                           android:layout_height="match_parent"
                           android:layout_weight="1"
                           android:orientation="vertical">

                           <TextView
                               style="@style/TextStyleBlack16sp"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:textAlignment="center"
                               android:text="Rank"
                               android:textSize="12sp" />

                           <TextView
                               android:id="@+id/total_rank"
                               style="@style/TextStyleBlack16sp"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:textAlignment="center"
                               android:textSize="12sp" />


                       </LinearLayout>


                   </LinearLayout>



                   <TextView
                       android:id="@+id/tribeSteps"
                       style="@style/TextStyleBlack16sp"
                       android:layout_below="@+id/tribe_header_layout"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:text="Tribe Steps:"
                       android:layout_marginTop="20dp"
                       android:textAlignment="center"
                       android:textSize="12sp" />

                   <TextView
                       android:id="@+id/myRank"
                       android:layout_below="@+id/communityGoal"
                       style="@style/TextStyleBlack16sp"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:text="My Rank:"
                       android:layout_marginTop="6dp"
                       android:textAlignment="center"
                       android:textSize="12sp" />

                   <TextView
                       android:id="@+id/communityGoal"
                       android:layout_below="@+id/tribeSteps"
                       style="@style/TextStyleBlack16sp"
                       android:layout_marginTop="6dp"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:text="Community Goal:"
                       android:textAlignment="center"
                       android:textSize="12sp" />




                   <!--      <TextView
                             android:id="@+id/tribeName"
                             android:layout_below="@+id/myRank"
                             style="@style/TextStyleBlack16sp"
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:text="Tribe Name:"
                             android:textAlignment="center"
                             android:textSize="12sp" />-->




                   <ImageView
                       android:id="@+id/iv_flag_bear"
                       android:layout_width="100dp"
                       android:layout_height="80dp"
                       android:layout_marginBottom="20dp"
                       app:layout_constraintTop_toTopOf="parent"
                       android:layout_alignParentBottom="true"
                       app:layout_constraintStart_toStartOf="parent"
                       android:src="@drawable/ic_bear_flag" />



               </RelativeLayout>

               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="vertical">

                   <TextView
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:text="Leaderboard"
                       android:textSize="@dimen/margin_16sp"
                       android:textColor="@color/black"
                       android:layout_marginStart="16dp"
                       android:padding="6dp"/>

                   <androidx.cardview.widget.CardView
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       app:cardCornerRadius="8dp"
                       android:layout_marginStart="16dp"
                       android:layout_marginEnd="16dp"
                       app:cardElevation="8dp"
                       android:padding="6dp">

                       <androidx.appcompat.widget.AppCompatSpinner
                           android:id="@+id/mainSpinner"
                           android:layout_width="match_parent"
                           android:layout_marginStart="16dp"
                           android:layout_marginEnd="16dp"
                           android:layout_height="35dp"
                           android:backgroundTint="@color/btn_blue" />


                   </androidx.cardview.widget.CardView>


                   <TextView
                       android:id="@+id/leaderboard_title"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:textSize="16sp"
                       android:padding="6dp"
                       android:textColor="@color/black"
                       android:text="Community Leaderboard"
                       android:textAlignment="center"/>


               </LinearLayout>

               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="horizontal"
                   android:weightSum="3"
                   android:layout_marginHorizontal="16dp">

                   <TextView
                       style="@style/TextStyleBlack16sp"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="@dimen/margin_8dp"
                       android:textAlignment="center"
                       android:text="Rank"
                       android:layout_weight="0.5"
                       android:textSize="14sp"/>

                   <TextView
                       android:id="@+id/name_title_tv"
                       style="@style/TextStyleBlack16sp"
                       android:layout_width="0dp"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="@dimen/margin_8dp"
                       android:layout_marginHorizontal="@dimen/_10sdp"
                       android:layout_weight="1.5"
                       android:textAlignment="center"
                       android:text="Tribe Name"
                       android:textSize="14sp" />

                   <TextView
                       style="@style/TextStyleBlack16sp"
                       android:layout_width="0dp"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="@dimen/margin_8dp"
                       android:textAlignment="center"
                       android:text="Steps"
                       android:textSize="14sp"
                       android:layout_weight="1"/>



               </LinearLayout>

               <View
                   android:layout_width="match_parent"
                   android:layout_height="0.8dp"
                   android:layout_marginTop="10dp"
                   android:layout_marginHorizontal="16dp"
                   android:background="@color/black"/>

               <androidx.recyclerview.widget.RecyclerView
                   android:id="@+id/rvMembers"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginHorizontal="16dp"
                   tools:itemCount="5"
                   tools:listitem="@layout/tribe_challenge_member_item"/>


               <Button
                   android:id="@+id/btnViewMore"
                   android:layout_width="wrap_content"
                   android:layout_height="30dp"
                   android:layout_marginBottom="@dimen/_10sdp"
                   android:layout_gravity="center"
                   android:layout_marginTop="16dp"
                   android:background="@drawable/wyh_round_btn_dark_red"
                   android:text="@string/view_more"
                   android:textAllCaps="false"
                   android:textColor="@color/white" />

               <RelativeLayout
                   android:id="@+id/llMoreGraphData"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginHorizontal="16dp"
                   android:layout_marginTop="@dimen/margin_16dp">

                   <ImageView
                       android:id="@+id/ivPrev"
                       android:visibility="visible"
                       android:layout_width="18dp"
                       android:layout_height="18dp"
                       android:layout_alignParentStart="true"
                       android:layout_centerVertical="true"
                       android:src="@drawable/ic_arrow_back" />

                   <TextView
                       android:id="@+id/tvDateRange"
                       style="@style/font_14sp_roboto_medium_black"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_centerInParent="true"
                       android:text="0"
                       android:textColor="@color/black"
                       android:textSize="14sp" />

                   <ImageView
                       android:id="@+id/ivNext"
                       android:visibility="visible"
                       android:layout_width="18dp"
                       android:layout_height="18dp"
                       android:layout_alignParentEnd="true"
                       android:layout_centerVertical="true"
                       android:src="@drawable/ic_arrow_back"
                       android:rotation="180" />

               </RelativeLayout>


               <RelativeLayout
                   android:layout_width="match_parent"
                   android:layout_height="250dp"
                   android:layout_marginBottom="64dp">

                   <com.github.mikephil.charting.charts.BarChart
                       android:id="@+id/tribeChart"
                       android:layout_width="match_parent"
                       android:layout_height="match_parent"
                       android:layout_marginTop="@dimen/margin_10dp"
                       android:layout_marginHorizontal="@dimen/margin_16dp"
                       android:contentDescription="Week" />

                   <ProgressBar
                       android:id="@+id/gpBar"
                       style="?android:attr/progressBarStyle"
                       android:layout_width="25dp"
                       android:layout_height="25dp"
                       android:layout_centerInParent="true"
                       android:layout_centerHorizontal="true"
                       android:layout_marginEnd="30dp"
                       android:visibility="gone" />

               </RelativeLayout>


           </LinearLayout>




       </androidx.core.widget.NestedScrollView>

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />




    </RelativeLayout>
</layout>
