<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/llActions"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/margin_32dp"
            android:paddingHorizontal="@dimen/margin_32dp"
            android:paddingTop="@dimen/margin_16dp">

            <RelativeLayout
                android:id="@+id/rlLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:visibility="gone"
                android:background="@drawable/pink_circle">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_centerInParent="true"
                    android:scaleType="fitCenter" />

            </RelativeLayout>

            <TextView
                android:id="@+id/tvProductName"
                style="@style/TextStyleBlack16sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/rlLogo"
                android:layout_marginEnd="@dimen/margin_16dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Product Name"
                android:textSize="15dp" />

            <TextView
                android:id="@+id/tvSku"
                style="@style/TextStyleBlack16sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_32dp"
                android:fontFamily="@font/roboto_medium"
                android:text="sample"
                android:textSize="@dimen/margin_12dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/tvSku"
                android:layout_marginEnd="@dimen/margin_16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/llVoucherCode"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/tvCardNumber"
                                style="@style/TextStyleBlack16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:fontFamily="@font/roboto_medium"
                                android:text="Card Number:"
                                android:textSize="@dimen/margin_12dp" />

                            <TextView
                                android:id="@+id/tvCardNumberVal"
                                style="@style/TextStyleBlack16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:layout_marginStart="@dimen/margin_10dp"
                                android:fontFamily="@font/roboto_medium"
                                android:text="sample"
                                android:textSize="@dimen/margin_12dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/tvCardPin"
                                style="@style/TextStyleBlack16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:fontFamily="@font/roboto_medium"
                                android:text="Card Pin:"
                                android:textSize="@dimen/margin_12dp" />

                            <TextView
                                android:id="@+id/tvCardPinVal"
                                style="@style/TextStyleBlack16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:layout_marginStart="@dimen/margin_10dp"
                                android:fontFamily="@font/roboto_medium"
                                android:text="sample"
                                android:textSize="@dimen/margin_12dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/tvCardAmount"
                                style="@style/TextStyleBlack16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:fontFamily="@font/roboto_medium"
                                android:text="Amount:"
                                android:textSize="@dimen/margin_12dp" />

                            <TextView
                                android:id="@+id/tvCardAmountVal"
                                style="@style/TextStyleBlack16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:layout_marginStart="@dimen/margin_10dp"
                                android:fontFamily="@font/roboto_medium"
                                android:text="sample"
                                android:textSize="@dimen/margin_12dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCardValidation"
                                style="@style/TextStyleBlack16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:fontFamily="@font/roboto_medium"
                                android:text="Validation:"
                                android:textSize="@dimen/margin_12dp" />

                            <TextView
                                android:id="@+id/tvCardValidationVal"
                                style="@style/TextStyleBlack16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:layout_marginStart="@dimen/margin_10dp"
                                android:fontFamily="@font/roboto_medium"
                                android:text="sample"
                                android:textSize="@dimen/margin_12dp" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvUBActivationUrl"
                            style="@style/TextStyleBlack16sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_16dp"
                            android:fontFamily="@font/roboto_medium"
                            android:text="Activation Url:"
                            android:textSize="@dimen/margin_12dp" />

                        <TextView
                            android:id="@+id/tvUBActivationUrlVal"
                            style="@style/TextStyleBlack16sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_16dp"
                            android:layout_marginStart="@dimen/margin_10dp"
                            android:fontFamily="@font/roboto_medium"
                            android:textColor="@color/blue"
                            android:text="sample"
                            android:textSize="@dimen/margin_12dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvUBActivationCode"
                        style="@style/TextStyleBlack16sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_16dp"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Activation Code:"
                        android:textSize="@dimen/margin_12dp" />

                    <RelativeLayout
                        android:id="@+id/llUBActivationCodeCopy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_16dp"
                        android:layout_marginBottom="@dimen/margin_8dp"
                        android:layout_marginTop="@dimen/margin_10dp"
                        android:visibility="visible"
                        android:background="@drawable/gray_rc_bg_16dp"
                        android:paddingStart="@dimen/margin_16dp">

                        <TextView
                            android:id="@+id/tvUBActivationCOdeVal"
                            style="@style/font_16sp_roboto_regular_black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="4dp"
                            android:layout_toStartOf="@id/tvCopy"
                            android:ellipsize="end"
                            android:text="sample Code" />

                        <TextView
                            android:id="@+id/tvCopy"
                            style="@style/font_15sp_roboto_regular_white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/blue_rc_bg_16dp"
                            android:paddingHorizontal="@dimen/margin_16dp"
                            android:paddingVertical="4dp"
                            android:text="Copy" />

                    </RelativeLayout>

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/llActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginBottom="20dp">


                <Button
                    android:id="@+id/btnPositive"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="120dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginHorizontal="@dimen/margin_10dp"
                    android:layout_marginBottom="@dimen/margin_16dp"
                    android:background="@drawable/blue_rc_bg_8dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="OK"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16dp"
                    app:layout_constraintEnd_toStartOf="@+id/btnNegative"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Button
                    android:id="@+id/btnNegative"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="120dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginHorizontal="@dimen/margin_10dp"
                    android:layout_marginBottom="@dimen/margin_16dp"
                    android:background="@drawable/pink_rc_bg_8dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Close"
                    android:visibility="gone"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/btnPositive"
                    app:layout_constraintTop_toTopOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </RelativeLayout>

    </RelativeLayout>
</layout>
