<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/rlUpperCard"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        android:background="@drawable/ic_policy_header"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/imBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/ic_policy_back"
            />
        <ImageView
            android:id="@+id/imKotakLogo"
            android:layout_toEndOf="@+id/imBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/ic_policy_kotak_logo"
            />
        <TextView
            android:layout_toEndOf="@+id/imKotakLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_marginStart="20dp"
            android:text="Kotak Policy"
            android:textColor="@color/white"
            />
        <TextView
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create MPIN"
            android:textColor="@color/black"
            android:textSize="18sp"
            />
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@+id/rlUpperCard"
        android:gravity="center"
        android:layout_marginTop="20dp"
        >


        <TextView
            android:id="@+id/tvSetMPIN"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set MPIN"
            android:textColor="@color/black"
            android:textSize="12sp"
            />
        <com.otpview.OTPTextView
            android:id="@+id/edtSetMPIN"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:height="42dp"
            app:length="4"
            app:otp_box_background_active="@drawable/otp_active_box_new"
            app:otp_box_background_inactive="@drawable/otp_active_box_new"
            app:otp_text_size="16sp"
            app:width="42dp"
            android:layout_marginTop="5dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Re-enter MPIN"
            android:textColor="@color/black"
            android:textSize="12sp"
            />
        <com.otpview.OTPTextView
            android:id="@+id/edtOTP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:height="42dp"
            app:length="4"
            app:otp_box_background_active="@drawable/otp_active_box_new"
            app:otp_box_background_inactive="@drawable/otp_active_box_new"
            app:otp_text_size="16sp"
            app:width="42dp"
            android:layout_marginTop="5dp"
            />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:src="@drawable/ic_policy_submit"
            />
    </LinearLayout>
</RelativeLayout>