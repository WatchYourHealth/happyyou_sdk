<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:background="@drawable/one_sided_curved_border_info"
        android:layout_height="wrap_content">


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTribeSpinner"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="@dimen/margin_10dp"
            android:scrollbars="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:itemCount="5"
            tools:listitem="@layout/primary_spinner_layout" />

        <Button
            android:id="@+id/btnClosed"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:background="@drawable/wyh_round_btn_dark_red"
            android:text="@string/close"
            android:layout_marginBottom="25dp"
            android:layout_marginHorizontal="@dimen/margin_16dp"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_margin="@dimen/_20sdp"
            app:layout_constraintTop_toBottomOf="@+id/rvTribeSpinner"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textColor="@color/white" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>