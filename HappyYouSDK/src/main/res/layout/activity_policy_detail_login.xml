<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root">
<RelativeLayout android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rlUpperCard"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        android:background="@drawable/ic_policy_header"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/imBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/ic_policy_back"
            />
        <ImageView
            android:id="@+id/imKotakLogo"
            android:layout_toEndOf="@+id/imBack"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:layout_marginTop="50dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_policy_kotak_logo"
            />
        <TextView
            android:layout_toEndOf="@+id/imKotakLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:textSize="16sp"
            android:layout_marginStart="8dp"
            android:text="Kotak Policy"
            android:textColor="@color/white"
            />

    </RelativeLayout>
    <LinearLayout
        android:layout_alignParentBottom="true"
        android:id="@+id/getStartedLayout"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:orientation="vertical"
        android:background="@drawable/new_login_bottom"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/getStartedHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter OTP"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:gravity="center"/>
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please enter OTP sent to XXXXXXX633"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:gravity="center"/>

        <com.otpview.OTPTextView
            android:id="@+id/edtOTP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:height="42dp"
            app:length="6"
            app:otp_box_background_active="@drawable/otp_active_box_new"
            app:otp_box_background_inactive="@drawable/otp_active_box_new"
            app:otp_text_size="16sp"
            app:width="42dp" />
        <TextView
            android:id="@+id/tvResendOTP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="20dp"
            android:text="Resend"
            android:textColor="@color/black"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnSendOTP"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Verify OTP"
            android:layout_marginTop="8dp"
            android:textAllCaps="false"
            android:background="@drawable/ic_policy_search_btn"
            android:textColor="@color/black"
            />
    </LinearLayout>
</RelativeLayout>
</layout>