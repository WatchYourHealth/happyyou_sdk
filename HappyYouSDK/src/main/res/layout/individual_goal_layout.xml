<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <RelativeLayout
        android:id="@+id/individual_goals_parent_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/ic_light_blue_button_bg">

        <LinearLayout
            android:id="@+id/individual_goals_img_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_centerInParent="true">

            <ImageView
                android:id="@+id/individual_goals_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_tele_consultation"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/individual_goals_name_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:hint="Challenge"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </LinearLayout>






    </RelativeLayout>

</RelativeLayout>