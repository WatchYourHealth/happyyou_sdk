<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <RelativeLayout
                android:id="@+id/rlMain1"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:background="@drawable/light_blue_button_bg"
                android:clipChildren="true"
                android:clipToPadding="true">

                <ImageView
                    android:id="@+id/ivGoalIcon1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="20dp"
                    android:elevation="4dp"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/ivHeart1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="16dp"
                    android:elevation="4dp"
                    android:src="@drawable/ic_heart" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ivGoalIcon1"
                    android:layout_marginTop="4dp"
                    android:layout_centerInParent="true"
                    android:layout_marginHorizontal="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGoal1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="center"
                        android:text="Reminder"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvGoalDesc1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:gravity="center"
                        android:layout_marginHorizontal="@dimen/margin_8dp"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="normal" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    android:background="@drawable/white_rc_bg_8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_done" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/roboto_regular"
                        android:text="Done"
                        android:textColor="@color/black" />

                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressGoal1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginHorizontal="@dimen/margin_16dp"
                    android:layout_marginBottom="@dimen/margin_16dp"
                    android:max="100"
                    android:progress="20"
                    android:visibility="gone"
                    app:indicatorColor="@color/white"
                    app:trackColor="#176C8F"
                    app:trackCornerRadius="16dp"
                    app:trackThickness="6dp" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlMain2"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/ic_light_pink_button_bg">

                <RelativeLayout
                    android:id="@+id/rlRiddle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivGoalIconRiddle"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="20dp"
                        android:elevation="4dp"
                        android:src="@drawable/ic_riddle_bulb"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/ivHeartRiddle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="24dp"
                        android:layout_marginEnd="16dp"
                        android:elevation="4dp"
                        android:src="@drawable/ic_heart" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/ivGoalIconRiddle"
                        android:layout_marginTop="4dp"
                        android:layout_marginHorizontal="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGoalRiddle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:gravity="center"
                            android:text="Riddle"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvGoalDescRiddle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:layout_marginHorizontal="@dimen/margin_8dp"
                            android:gravity="center"
                            android:text="Can you solve these?"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="normal" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressGoalRiddle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_marginHorizontal="@dimen/margin_16dp"
                        android:layout_marginBottom="@dimen/margin_16dp"
                        android:max="100"
                        android:progress="20"
                        android:visibility="gone"
                        app:indicatorColor="@color/white"
                        app:trackColor="#FF7D60"
                        app:trackCornerRadius="16dp"
                        app:trackThickness="6dp" />

                </RelativeLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlMain3"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:background="@drawable/ic_light_orange_button_bg">

                <RelativeLayout
                    android:id="@+id/rlGoals"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivGoalIcon2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="20dp"
                        android:elevation="4dp"
                        android:src="@drawable/ic_flag"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/ivHeart2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="24dp"
                        android:layout_marginEnd="16dp"
                        android:elevation="4dp"
                        android:src="@drawable/ic_heart" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_above="@id/progressGoal2"
                        android:layout_below="@id/ivGoalIcon2"
                        android:layout_marginTop="4dp"
                        android:layout_marginHorizontal="8dp"
                        android:layout_marginBottom="@dimen/margin_10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGoal2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:gravity="center"
                            android:text="Goals"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvGoalDesc2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:text="Today's goal"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/tvStepGoal"
                            style="@style/font_16sp_roboto_medium_black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:textStyle="normal"
                            tools:text="0" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:text="steps"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="normal" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressGoal2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_marginHorizontal="@dimen/margin_16dp"
                        android:layout_marginBottom="@dimen/margin_16dp"
                        android:max="10000"
                        app:indicatorColor="@color/white"
                        app:trackColor="#F78C32"
                        app:trackCornerRadius="16dp"
                        app:trackThickness="6dp" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlWinnings"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/ivGoalIcon3"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="20dp"
                        android:elevation="4dp"
                        android:src="@drawable/ic_rewards_gift"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/ivHeart3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="24dp"
                        android:layout_marginEnd="16dp"
                        android:elevation="4dp"
                        android:src="@drawable/ic_heart" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_below="@id/ivGoalIcon3"
                        android:layout_marginTop="4dp"
                        android:layout_marginHorizontal="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGoal3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:gravity="center"
                            android:text="Winnings"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvGoalDesc3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:text="Take up new activities &amp; earn more"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="normal" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressGoal3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_marginHorizontal="@dimen/margin_16dp"
                        android:layout_marginBottom="@dimen/margin_16dp"
                        android:max="16"
                        app:indicatorColor="@color/white"
                        app:trackColor="#F78C32"
                        app:trackCornerRadius="16dp"
                        app:trackThickness="6dp" />
                </RelativeLayout>

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>
</layout>
