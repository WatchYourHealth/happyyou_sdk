<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:id="@+id/rlMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include
                android:id="@+id/includeToolbar"
                layout="@layout/layout_back" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_16dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        style="@style/font_26sp_roboto_medium_black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_16dp"
                        android:text="Good" />

                    <TextView
                        android:id="@+id/tv_daytime"
                        style="@style/font_28sp_roboto_bold_black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Morning," />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_8dp"
                    android:orientation="horizontal">


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:orientation="vertical"
                        android:weightSum="4">

                        <RelativeLayout
                            android:id="@+id/rlQuiz"
                            android:layout_width="180dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_8dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="180dp"
                                android:layout_height="180dp"
                                android:src="@drawable/ic_quiz_bg" />

                            <ImageView
                                android:id="@+id/iv_quiz_bg"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="@dimen/margin_32dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/ic_quiz_icon" />

                            <TextView
                                android:id="@+id/tv_quiz"
                                style="@style/font_16sp_roboto_medium_black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/iv_quiz_bg"
                                android:layout_centerHorizontal="true"
                                android:text="Play and Win"
                                android:textAlignment="center" />
                        </RelativeLayout>

                        <View
                            android:layout_width="180dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <RelativeLayout
                            android:id="@+id/rlDiary"
                            android:layout_width="180dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_8dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="180dp"
                                android:layout_height="180dp"
                                android:src="@drawable/ic_diary_bg" />

                            <ImageView
                                android:id="@+id/iv_diary_bg"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="@dimen/margin_32dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/ic_diary_icon" />

                            <TextView
                                android:id="@+id/tv_diary"
                                style="@style/font_16sp_roboto_medium_black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/iv_diary_bg"
                                android:layout_centerHorizontal="true"
                                android:text="My Diary"
                                android:textAlignment="center" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="180dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_8dp"
                            android:layout_weight="1"
                            android:visibility="gone" />

                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:layout_centerInParent="true"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:weightSum="3">

                            <View
                                android:id="@+id/rl_affirmation"
                                android:layout_width="170dp"
                                android:layout_height="0dp"
                                android:layout_weight="1"></View>

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/la_unwind"
                                android:layout_width="170dp"
                                android:layout_height="200dp"
                                android:layout_below="@+id/rl_affirmation"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true" />

                            <View
                                android:layout_width="170dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                        </LinearLayout>


                    </RelativeLayout>

                </RelativeLayout>
            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />
    </RelativeLayout>
</layout>

