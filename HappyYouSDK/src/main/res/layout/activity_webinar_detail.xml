<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <include
            android:id="@+id/includeToolbar"
            layout="@layout/layout_back" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/includeToolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/margin_32dp"
                    app:cardCornerRadius="16dp">


                    <ImageView
                        android:id="@+id/iv_webinar_img"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/dummy_image" />

                    <TextView
                        android:id="@+id/tv_webinar_title"
                        style="@style/TextStyleBlack16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="@dimen/margin_16dp"
                        android:text="webinar title"
                        android:textColor="@color/white"
                        android:textSize="18sp" />


                </androidx.cardview.widget.CardView>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_16dp"
                    android:layout_marginTop="@dimen/margin_8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <ImageView
                                android:id="@+id/iv_date"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_calender_1" />

                            <TextView
                                android:id="@+id/tv_date"
                                style="@style/TextStyleBlack16sp"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:layout_marginStart="3dp"
                                android:layout_toRightOf="@+id/iv_date"
                                android:textSize="14sp" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <ImageView
                                android:id="@+id/iv_time"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_time" />

                            <TextView
                                android:id="@+id/tv_time"
                                style="@style/TextStyleBlack16sp"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:layout_marginStart="3dp"
                                android:layout_toRightOf="@+id/iv_time"
                                android:textSize="14sp" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:visibility="invisible">

                            <ImageView
                                android:id="@+id/iv_views"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_views" />

                            <TextView
                                android:id="@+id/tv_views_count"
                                style="@style/TextStyleBlack16sp"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:layout_marginStart="3dp"
                                android:layout_toRightOf="@+id/iv_views"
                                android:textSize="14sp" />
                        </RelativeLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_title"
                        style="@style/TextStyleBlack16sp"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="@dimen/margin_8dp"
                        android:text="title"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_webinar_description"
                        style="@style/TextStyleBlack16sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8dp"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_join_webinar"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/wyh_round_btn"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:paddingHorizontal="40dp"
                        android:text="@string/join_now"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />
    </RelativeLayout>
</layout>
