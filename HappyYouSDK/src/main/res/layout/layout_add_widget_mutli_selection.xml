<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <ImageView
            android:id="@+id/ivAddWidgetMenuClicked"
            android:layout_width="150dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_add_widget"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <LinearLayout
            android:id="@+id/activeHr"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="10dp"
            android:background="@drawable/ic_add_widget_5"
            app:layout_constraintCircle="@id/ivAddWidgetMenuClicked"
            app:layout_constraintCircleAngle="315"
            app:layout_constraintCircleRadius="140dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/tvActiveHr"
                style="@style/TextStyleBlack16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/margin_16dp"
                android:paddingVertical="@dimen/margin_10dp"
                android:textAlignment="center"
                android:text="Active\nHours" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/pillowTime"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="10dp"
            android:background="@drawable/ic_add_widget_6"
            app:layout_constraintCircle="@id/ivAddWidgetMenuClicked"
            app:layout_constraintCircleAngle="270"
            app:layout_constraintCircleRadius="130dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/tvPillowTime"
                style="@style/TextStyleBlack16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/margin_16dp"
                android:paddingVertical="@dimen/margin_10dp"
                android:textAlignment="center"
                android:text="Pillow\nTime" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/zenZone"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="10dp"
            android:background="@drawable/ic_add_widget_7"
            app:layout_constraintCircle="@id/ivAddWidgetMenuClicked"
            app:layout_constraintCircleAngle="225"
            app:layout_constraintCircleRadius="140dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/tvZenZone"
                style="@style/TextStyleBlack16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:paddingHorizontal="@dimen/margin_16dp"
                android:paddingVertical="@dimen/margin_10dp"
                android:text="Zen\nZone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/footprint"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="10dp"
            android:background="@drawable/ic_add_widget_8"
            app:layout_constraintCircle="@id/ivAddWidgetMenuClicked"
            app:layout_constraintCircleAngle="180"
            app:layout_constraintCircleRadius="130dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/tvFootprint"
                style="@style/TextStyleBlack16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:paddingHorizontal="@dimen/margin_16dp"
                android:paddingVertical="@dimen/margin_10dp"
                android:text="Happy\nFootprints" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/h2o"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="10dp"
            android:background="@drawable/ic_add_widget_1"
            app:layout_constraintCircle="@id/ivAddWidgetMenuClicked"
            app:layout_constraintCircleAngle="135"
            app:layout_constraintCircleRadius="140dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/tvH2o"
                style="@style/TextStyleBlack16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:paddingHorizontal="@dimen/margin_16dp"
                android:paddingVertical="@dimen/margin_10dp"
                android:text="H2O" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/healthHacks"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:background="@drawable/ic_add_widget_2"
            android:orientation="vertical"
            android:paddingVertical="10dp"
            app:layout_constraintCircle="@id/ivAddWidgetMenuClicked"
            app:layout_constraintCircleAngle="90"
            app:layout_constraintCircleRadius="130dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/tvHealthHacks"
                style="@style/TextStyleBlack16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:paddingHorizontal="@dimen/margin_16dp"
                android:paddingVertical="@dimen/margin_10dp"
                android:text="Health\nHacks" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tribe"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="10dp"
            android:layout_marginHorizontal="@dimen/margin_5dp"
            android:background="@drawable/ic_add_widget_3"
            app:layout_constraintCircle="@id/ivAddWidgetMenuClicked"
            app:layout_constraintCircleAngle="45"
            app:layout_constraintCircleRadius="140dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/tvTribe"
                style="@style/TextStyleBlack16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/margin_16dp"
                android:paddingVertical="@dimen/margin_10dp"
                android:textAlignment="center"
                android:text="Tribe" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/calCount"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="10dp"
            android:layout_marginHorizontal="@dimen/margin_5dp"
            android:background="@drawable/ic_add_widget_4"
            app:layout_constraintCircle="@id/ivAddWidgetMenuClicked"
            app:layout_constraintCircleAngle="360"
            app:layout_constraintCircleRadius="130dp"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/tvCalCount"
                style="@style/TextStyleBlack16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/margin_16dp"
                android:paddingVertical="@dimen/margin_10dp"
                android:textAlignment="center"
                android:text="Cal-Count" />

        </LinearLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>