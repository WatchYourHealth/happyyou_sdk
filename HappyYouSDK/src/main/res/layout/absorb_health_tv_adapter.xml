<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_first_video"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/margin_10dp">

                <RelativeLayout
                    android:id="@+id/rl_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/bg_img_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_light_pink_button_bg" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerInParent="true"
                        android:clipChildren="true"
                        android:elevation="4dp"
                        android:src="@drawable/ic_baseline_play_circle_outline_48" />

                    <ImageView
                        android:id="@+id/iv_bookmark_1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentRight="true"
                        android:layout_above="@+id/llDes1"
                        android:background="@drawable/ic_baseline_bookmark_border_24"
                        android:backgroundTint="@color/orange" />

                    <LinearLayout
                        android:id="@+id/llDes1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true">

                        <TextView
                            android:id="@+id/tv_video_1"
                            style="@style/font_12sp_roboto_medium_white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:maxLines="2"
                            android:text="Article Name" />
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_second_video"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_marginStart="@dimen/margin_8dp"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/margin_10dp">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/bg_img_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_light_blue_button_bg" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerInParent="true"
                        android:clipChildren="true"
                        android:elevation="4dp"
                        android:src="@drawable/ic_baseline_play_circle_outline_48" />
                    <ImageView
                        android:id="@+id/iv_bookmark_2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentRight="true"
                        android:layout_above="@+id/llDes2"
                        android:background="@drawable/ic_baseline_bookmark_border_24"
                        android:backgroundTint="@color/orange" />

                    <LinearLayout
                        android:id="@+id/llDes2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true">

                        <TextView
                            android:id="@+id/tv_video_2"
                            style="@style/font_12sp_roboto_medium_white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:maxLines="2"
                            android:text="Article Name" />
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>
</layout>


