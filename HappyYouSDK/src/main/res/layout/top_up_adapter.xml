<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <RelativeLayout
                android:id="@+id/rl_article1"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/margin_8dp"
                android:background="@drawable/ic_light_pink_button_bg"
                android:clipChildren="true"
                android:clipToPadding="true">

                <ImageView
                    android:id="@+id/ivInfo1"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/ivImage1"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="30dp" />

                <TextView
                    android:id="@+id/tv_article_1"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ivImage1"
                    android:layout_centerVertical="true"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="14dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="Article Name"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivCheck1"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="@dimen/margin_10dp"
                    android:background="@drawable/blue_circle"
                    android:backgroundTint="@color/green"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/ivCheckyellow1"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="@dimen/margin_10dp"
                    android:padding="4dp"
                    android:scaleType="fitXY"
                    android:background="@drawable/blue_circle"
                    android:backgroundTint="@color/new_hra_incomplete"
                    android:src="@drawable/sandclock"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvCompleted1"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_article_1"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center"
                    android:text="Completed"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:visibility="visible" />

                <LinearLayout
                    android:id="@+id/llbanner1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:background="@color/happy_dark_grey"
                    android:visibility="visible"
                    android:padding="@dimen/margin_10dp">

                    <TextView
                        android:id="@+id/tvBanner1"
                        style="@style/TextStyleBlack16sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tv_article_1"
                        android:layout_marginHorizontal="5dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="Come back next month2"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvStarted1"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_article_1"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center"
                    android:text="Started"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:alpha="0.5"
                    android:visibility="gone"
                    android:background="@drawable/transparent_black_rc_bg_8dp"
                    android:gravity="center"
                    android:padding="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.2dp"
                    android:layout_above="@+id/progressActivity1"
                    android:background="#D3D3D3" />

                <ProgressBar
                    android:id="@+id/progressActivity1"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true"
                    android:max="100"
                    android:progress="50"
                    android:visibility="invisible"
                    android:progressDrawable="@drawable/custom_progress_bar"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="30dp" />

                <TextView
                    android:id="@+id/tvStart1"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:text="Start Now"
                    android:textColor="@color/white"
                    android:textSize="@dimen/margin_10sp" />

            </RelativeLayout>

