<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wheel_screen_bg"
        android:orientation="vertical"
        android:weightSum="8">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3"
            android:gravity="center"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/logoImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1.5">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginHorizontal="38dp"
                    android:background="@drawable/bg_policy_kgi_bottom"
                    android:backgroundTint="@color/white"
                    android:padding="30dp"
                    android:src="@drawable/new_icon" />

            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center_vertical"
                android:src="@drawable/new_login_bear" />


        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5.7"
            android:gravity="center"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/spin_reward_bg"
                android:orientation="vertical"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:background="@drawable/spin_wheel_layout_bg"
                    android:orientation="vertical">


                    <LinearLayout
                        android:id="@+id/rewards_layout"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/spin_reward_name_bg"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/header_one"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="One Click. big Benifits."
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/header_two"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Get Strated with Just One Click \nYour Corporate benifits are \nReady to Go!"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"
                            android:textSize="16sp" />


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/time_out_layout"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_gravity="center_horizontal|center_vertical"
                            android:layout_marginHorizontal="32dp"
                            android:layout_marginTop="20dp"
                            android:src="@drawable/time_up_img">

                        </ImageView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="12dp"
                            android:text="@string/time_up_desc"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="16sp" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/reward_mobile_num_bg"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/otp_countdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/timer_background"
                            android:text="@string/timer"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="16sp" />


                        <TextView
                            android:id="@+id/hurry_up_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="6dp"
                            android:text="@string/hurry_up"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/log_in_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="12dp"
                            android:text="@string/claim_reward"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_alignParentBottom="true"
                            android:layout_marginBottom="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginStart="20dp"
                            android:background="@drawable/edit_text_border"
                            android:backgroundTint="@color/blue"

                            >
                            <androidx.appcompat.widget.AppCompatSpinner
                                android:id="@+id/spinnerPolicy"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@drawable/new_login_edit_text_bg"
                                android:padding="8dp" />
                            <ImageView
                                android:layout_height="18dp"
                                android:layout_width="18dp"
                                android:src="@drawable/dropdown_blue_arrow"
                                android:layout_centerVertical="true"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="10dp"
                                app:tint="@color/black" />
                        </RelativeLayout>
                        <TextView
                            android:id="@+id/log_in_tv1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="12dp"
                            android:text="An OTP will send to your email ID:\nabc@abc.com"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center">

                            <com.otpview.OTPTextView
                                android:id="@+id/edtOTP"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                app:height="32dp"
                                app:length="6"
                                app:otp_box_background_active="@drawable/reward_otp_active_box"
                                app:otp_box_background_inactive="@drawable/reward_otp_active_box"
                                app:otp_text_size="12sp"
                                app:width="32dp" />


                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvResendOTP"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:text="@string/resend_otp"
                            android:visibility="gone"
                            android:textColor="@color/black"
                            android:textSize="16sp" />


                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="16dp"
                            android:weightSum="2"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/continue_login"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:layout_weight="1"
                                android:text="@string/continue_login"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:layout_marginEnd="20dp"
                                android:background="@drawable/cream_background"
                                android:textSize="14sp">

                            </TextView>
                            <TextView
                                android:id="@+id/tvEditEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:layout_weight="1"
                                android:layout_marginStart="20dp"
                                android:text="Edit Email ID"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:background="@drawable/cream_background"
                                android:textSize="14sp">

                            </TextView>


                        </LinearLayout>


                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>


</layout>
