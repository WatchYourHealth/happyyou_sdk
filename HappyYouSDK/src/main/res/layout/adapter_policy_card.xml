<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_mainBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:background="@drawable/ic_policy_card_green_border"
            android:layout_margin="12dp"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <!-- Header Section -->
                <RelativeLayout
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Shield Icon -->
                    <ImageView
                        android:id="@+id/imShield"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_shield"
                        android:contentDescription="Shield Icon"/>

                    <!-- Policy Title -->
                    <TextView
                        android:id="@+id/tv_policy_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Life Insurance Policy"
                        android:layout_toEndOf="@+id/imShield"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:layout_marginStart="8dp"/>

                    <!-- Status Badge -->
                    <ImageView
                        android:id="@+id/imStatus"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:layout_gravity="end"
                        android:scaleType="fitXY"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/ic_policy_card_active"
                        android:layout_alignParentEnd="true"
                        />
                    <ImageView
                        android:id="@+id/tvViewMore"
                        android:layout_width="50dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_policy_view_more"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@+id/imStatus"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:padding="5dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginStart="8dp"
                        />
                    <TextView
                        android:id="@+id/tvPolicyNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1201239198230"
                        android:layout_toEndOf="@+id/imShield"
                        android:layout_below="@+id/tv_policy_title"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="4dp"/>
                </RelativeLayout>

                <!-- Policy Number -->


                <!-- Horizontal Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="12dp"/>

                <!-- Insured Name and Premium Due -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Insured Name"
                            android:textColor="#999999"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvPolicyHolderName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Amit Sharma"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Premium Due"
                            android:textColor="#999999"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvPolicyPremiumDue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="31 Dec 2024"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Sum Assured and Maturity Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sum Assured"
                            android:textColor="#999999"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvPolicySumAssuredAmt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹ 1,00,00,000"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maturity Date"
                            android:textColor="#999999"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvPolicyMaturityDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30 Dec 2034"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Action Buttons -->
                <LinearLayout
                    android:id="@+id/withAutoPay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="15dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="15dp"
                    android:layout_weight="3.2"
                    android:visibility="gone"
                    >

                    <ImageView
                        android:id="@+id/imAutoPay"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:src="@drawable/ic_auto_pay"
                        android:visibility="visible"
                        />
                    <View
                        android:id="@+id/imAutoPayView"
                        android:layout_weight="0.01"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_marginVertical="8dp"
                        android:background="@color/gray"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_toEndOf="@+id/imAutoPay"
                        android:visibility="visible"
                        />

                    <ImageView
                        android:id="@+id/imRenewPolicy"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:padding="8dp"
                        android:src="@drawable/ic_renew_policy_2x" />
                    <View
                        android:layout_weight="0.01"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:background="@color/gray"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_toEndOf="@+id/imRenewPolicy"
                        />
                    <ImageView
                        android:layout_alignParentEnd="true"
                        android:id="@+id/imDownloadPolicy"
                        android:layout_centerInParent="true"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        android:src="@drawable/ic_download_policy_card_2x"
                        />

                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/withoutAutoPay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="28dp"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginEnd="28dp"
                    android:visibility="visible">

                    <ImageView
                        android:id="@+id/imRenewPolicy1"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:padding="4dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_renew_policy_2x" />

                    <View
                        android:id="@+id/view1"
                        android:layout_width="0.5dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="5dp"
                        android:layout_centerInParent="true"
                        android:background="@color/gray" />

                    <ImageView
                        android:id="@+id/imDownloadPolicy1"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:padding="12dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_download_policy_card_2x" />

                </RelativeLayout>

            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>
</layout>