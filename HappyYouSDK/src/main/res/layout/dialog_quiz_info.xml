<?xml version="1.0" encoding="utf-8"?>


<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="42dp"
            app:cardCornerRadius="21dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivInfoIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="35dp"
                    android:src="@drawable/ic_hu_info_red"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/lblTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/information"
                    android:textColor="@color/black"
                    android:textFontWeight="700"
                    android:textSize="21dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivInfoIcon"

                    />

                <TextView
                    android:id="@+id/tvMessageTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="35dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineHeight="20dp"
                    android:textColor="@color/dark_card_grey"
                    android:textFontWeight="400"
                    android:textSize="14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblTitle"
                    tools:text="You have successfully registered\nfor the Quiz!" />

                <TextView
                    android:id="@+id/tvMessageBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="35dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineHeight="20dp"
                    android:textColor="@color/dark_card_grey"
                    android:textFontWeight="400"
                    android:textSize="14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvMessageTop"
                    tools:text="The quiz will be live on" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mcvExpiredHrs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="16dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="@+id/tvMessageBottom"
                    app:layout_constraintStart_toStartOf="@+id/tvMessageBottom"
                    app:layout_constraintTop_toBottomOf="@+id/tvMessageBottom"
                    app:strokeColor="@color/pink"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvExpiredHours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginVertical="6dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textFontWeight="500"
                        tools:text="29:46:58" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/mcvExpiredHrs"
                    app:layout_constraintStart_toStartOf="@+id/mcvExpiredHrs"
                    app:layout_constraintTop_toBottomOf="@+id/mcvExpiredHrs">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mcvQuizButtonOptional"
                        android:layout_weight="1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/blue"
                        app:cardCornerRadius="8dp"
                        android:visibility="gone"
                        android:layout_marginEnd="8dp"
                        >

                        <TextView
                            android:id="@+id/tvButtonTextOptional"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="24dp"
                            android:layout_marginVertical="8dp"
                            android:gravity="center"
                            android:text="Close"
                            android:textColor="@color/white" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mcvQuizButton"
                        android:layout_weight="1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#FB7373"
                        app:cardCornerRadius="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_gravity="center"
                        >

                        <TextView
                            android:id="@+id/tvButtonText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="24dp"
                            android:layout_marginVertical="8dp"
                            android:text="Close"
                            android:gravity="center"
                            android:textColor="@color/white" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>



            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
