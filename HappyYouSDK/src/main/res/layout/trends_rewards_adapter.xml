<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:orientation="horizontal"
            android:weightSum="3">


            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:background="@drawable/ic_light_pink_button_bg">

                <ImageView
                    android:id="@+id/ivGoalIcon2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="16dp"
                    android:elevation="4dp"
                    android:src="@drawable/ic_trackstar" />

                <TextView
                    android:id="@+id/tvGoal2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:text="Trackstar"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/goal_1_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvGoal2"
                    android:layout_centerInParent="true"
                    android:layout_marginTop="@dimen/margin_8dp"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:text="Walk 15k steps"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressGoal2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginHorizontal="@dimen/margin_16dp"
                    android:layout_marginBottom="@dimen/margin_16dp"
                    android:max="100"
                    android:progress="60"
                    app:indicatorColor="@color/white"
                    app:trackColor="#FF7D60"
                    app:trackCornerRadius="16dp"
                    app:trackThickness="6dp" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/light_blue_button_bg"
                android:clipChildren="true"
                android:clipToPadding="true">

                <ImageView
                    android:id="@+id/ivGoalIcon1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:elevation="4dp"
                    android:src="@drawable/ic_steps_blue"
                    app:tint="#FF006B9B" />

                <TextView
                    android:id="@+id/tvGoal1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:text="5000"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_goal_sub2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvGoal1"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:text="Steps in a Day"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_select"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginHorizontal="@dimen/margin_16dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_little_rounded_square"
                    android:text="Collect Reward"
                    android:textAllCaps="false"
                    android:textSize="@dimen/margin_12sp" />

            </RelativeLayout>


            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:background="@drawable/grey_btn_bg">

                <ImageView
                    android:id="@+id/ivGoalIcon3"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="16dp"
                    android:elevation="4dp"
                    android:src="@drawable/ic_trail_blazer" />

                <TextView
                    android:id="@+id/tvGoal3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:text="Trail Blazer"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:alpha="0.5"
                    android:background="@color/grey"
                    android:gravity="center"
                    android:padding="16dp" />

                <TextView
                    android:id="@+id/tvChallengePoints1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Upcoming"
                    android:textColor="@color/white"
                    android:textSize="12sp" />


            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>
</layout>
