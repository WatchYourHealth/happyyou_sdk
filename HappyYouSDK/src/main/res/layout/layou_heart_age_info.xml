<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/font_16sp_roboto_medium_black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_32dp"
                android:letterSpacing="0.03"
                android:text="Heart Age Score Interpretation"
                android:textStyle="bold" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_10dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvNormal"
                                style="@style/font_16sp_roboto_regular_black"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:letterSpacing="0.03"
                                android:text="No Concern " />

                            <TextView
                                style="@style/font_16sp_roboto_regular_black"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:letterSpacing="0.03"
                                android:text="0% - 10%" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvMild"
                                style="@style/font_16sp_roboto_regular_black"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:letterSpacing="0.03"
                                android:text="Low Concern " />

                            <TextView
                                android:id="@+id/tvMildVal"
                                style="@style/font_16sp_roboto_regular_black"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:letterSpacing="0.03"
                                android:text="11% - 50%" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvModerate"
                                style="@style/font_16sp_roboto_regular_black"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:letterSpacing="0.03"
                                android:text="Moderate Concern " />

                            <TextView
                                android:id="@+id/tvModerateVal"
                                style="@style/font_16sp_roboto_regular_black"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:letterSpacing="0.03"
                                android:text="51% - 80%" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvSevere"
                                style="@style/font_16sp_roboto_regular_black"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:letterSpacing="0.03"
                                android:text="High Concern " />

                            <TextView
                                android:id="@+id/tvSevereVal"
                                style="@style/font_16sp_roboto_regular_black"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:letterSpacing="0.03"
                                android:text="> 80%" />

                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnOK"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/margin_16dp"
                        android:layout_marginBottom="@dimen/margin_16dp"
                        android:background="@drawable/wyh_round_btn"
                        android:fontFamily="@font/roboto_black"
                        android:gravity="center"
                        android:paddingHorizontal="36dp"
                        android:text="OK"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:visibility="visible" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>


        </LinearLayout>
    </RelativeLayout>

</layout>