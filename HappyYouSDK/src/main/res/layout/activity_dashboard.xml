<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationDrawer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="right"
            android:clipToPadding="false"
            android:fitsSystemWindows="true"
            app:headerLayout="@layout/navigation_header"
            app:menu="@menu/menu_navigation_drawer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/artboard_dark"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/include_navigation_header"
                    layout="@layout/navigation_header" />


            </LinearLayout>

        </com.google.android.material.navigation.NavigationView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lv_clouds"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/margin_16dp"
                android:elevation="4dp"
                android:visibility="visible"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/anim_white_clouds" />

            <ImageView
                android:id="@+id/ivBlackOpacity"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="6dp"
                android:src="#7F000000"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:weightSum="1">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.75">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:weightSum="1">


                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="0.5"
                            android:elevation="1dp"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/ivHomeBgTop"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                android:src="@drawable/home_bg_noon_up" />

                            <ProgressBar
                                android:id="@+id/corousel_progress_bar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:indeterminateTint="@color/pink" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvHomeCarousel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="70dp"
                                android:visibility="invisible" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvIndicatorsCarousel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/rvHomeCarousel"
                                android:layout_centerHorizontal="true"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginHorizontal="@dimen/margin_16dp" />

                        </RelativeLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="0.5">

                            <androidx.constraintlayout.widget.Guideline
                                android:id="@+id/gv40"
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                app:layout_constraintGuide_begin="206dp" />


                            <LinearLayout
                                android:id="@+id/llTemparature"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toEndOf="@+id/gv40"
                                app:layout_constraintEnd_toStartOf="@id/llIcons"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_marginTop="@dimen/margin_16dp"
                                android:layout_marginBottom="70dp"
                                android:elevation="@dimen/margin_8dp"
                                android:layout_marginEnd="8dp"
                                android:orientation="horizontal"
                                android:visibility="gone"
                                android:weightSum="2"
                                tools:visibility="visible">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tv_city_name"
                                        style="@style/font_14sp_roboto_regular_black"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textAlignment="textEnd"
                                        tools:text="" />

                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="end|bottom"
                                        android:weightSum="2">

                                        <TextView
                                            android:id="@+id/tv_temperature_description"
                                            style="@style/font_14sp_roboto_regular_black"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:layout_marginEnd="4dp"
                                            android:layout_toLeftOf="@id/tv_temperature"
                                            tools:text="Cloudykjs fkshf kjskkj snfkjsd, "
                                            android:textAlignment="textEnd" />

                                        <TextView
                                            android:id="@+id/tv_temperature"
                                            style="@style/font_14sp_roboto_regular_black"
                                            android:layout_width="wrap_content"
                                            android:textAlignment="textEnd"
                                            android:layout_alignParentEnd="true"
                                            android:layout_height="wrap_content"
                                            tools:text="30 C" />
                                    </RelativeLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/ivHomeBgBottom"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                android:src="@drawable/home_bg_noon_down_2" />

                                <LinearLayout
                                    android:id="@+id/llHomeAnimation"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    app:layout_constraintEnd_toStartOf="@+id/llIcons"
                                    app:layout_constraintStart_toStartOf="parent"
                                    android:weightSum="2">

                                    <com.airbnb.lottie.LottieAnimationView
                                        android:id="@+id/homeAnimation"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_marginStart="@dimen/margin_32dp"
                                        android:layout_weight="1"
                                        app:lottie_autoPlay="true"
                                        app:lottie_loop="true" />

                                    <RelativeLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="69dp"
                                        android:layout_weight="1"
                                        android:elevation="4dp">

                                        <RelativeLayout
                                            android:id="@+id/rl_cloud"
                                            android:layout_width="125dp"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentStart="true"
                                            android:background="@drawable/ic_chat_box"
                                            android:paddingBottom="@dimen/margin_8dp">

                                            <LinearLayout
                                                android:id="@+id/llCloud"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="16dp"
                                                android:layout_marginTop="4dp"
                                                android:layout_marginBottom="4dp"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:id="@+id/tvCloud"
                                                    style="@style/font_12sp_roboto_medium_black"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:fontFamily="@font/roboto_regular"
                                                    android:gravity="center"
                                                    android:text="Complete Your Health Score" />

                                                <TextView
                                                    style="@style/TextStyleBlack16sp"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:fontFamily="@font/roboto_regular"
                                                    android:gravity="center"
                                                    android:text="Click Here"
                                                    android:textSize="10dp" />

                                            </LinearLayout>

                                        </RelativeLayout>

                                    </RelativeLayout>

                                </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llIcons"
                                android:layout_width="36dp"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:layout_marginHorizontal="8dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/llHomeAnimation">

                                <RelativeLayout
                                    android:id="@+id/ivClick1"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="16dp"
                                    android:background="@drawable/gradient_circle">

                                    <ImageView
                                        android:id="@+id/firstNudgeImg"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_centerInParent="true"
                                        android:scaleType="centerInside"
                                        android:src="@drawable/nudge_bear"
                                        app:tint="@color/white" />
                                </RelativeLayout>
                                <RelativeLayout
                                    android:id="@+id/ivClick2"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="16dp"
                                    android:background="@drawable/gradient_pink">
                                    <ImageView
                                        android:id="@+id/secondNudgeImg"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_centerInParent="true"
                                        android:src="@drawable/nudge_bear"
                                        android:scaleType="centerInside"
                                        app:tint="@color/white" />
                                </RelativeLayout>
                                <RelativeLayout
                                    android:id="@+id/ivClick3"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="16dp"
                                    android:background="@drawable/gradient_circle">

                                    <ImageView
                                        android:id="@+id/thirdNudgeImg"
                                        android:layout_width="14dp"
                                        android:layout_height="15dp"
                                        android:layout_centerInParent="true"
                                        android:scaleType="centerInside"
                                        app:tint="@color/white" />
                                </RelativeLayout>
                                <RelativeLayout
                                    android:id="@+id/ivClick4"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="16dp"
                                    android:background="@drawable/gradient_orange">

                                    <ImageView
                                        android:id="@+id/fourNudgeImg"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_centerInParent="true"
                                        android:scaleType="centerInside"
                                        android:src="@drawable/nudge_bear"
                                        app:tint="@color/white" />
                                </RelativeLayout>

                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="-54dp"
                    android:layout_weight="0.34"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBottomCards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvIndicators"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal" />

                </LinearLayout>

            </LinearLayout>


            <include
                android:id="@+id/include_verticalMenu"
                layout="@layout/vertical_menu_fab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/ivHome"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/margin_32dp" />

            <ImageView
                android:id="@+id/ivICE"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginEnd="@dimen/margin_16dp"
                android:layout_marginBottom="@dimen/margin_16dp"
                android:backgroundTint="@color/white"
                android:backgroundTintMode="src_atop"
                android:clickable="true"
                android:elevation="@dimen/margin_8dp"
                android:focusable="true"
                android:scaleType="fitXY"
                android:src="@drawable/ice_button" />

            <ImageView
                android:id="@+id/ivHome"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginEnd="@dimen/margin_16dp"
                android:layout_marginBottom="@dimen/margin_16dp"
                android:backgroundTint="@color/white"
                android:backgroundTintMode="src_atop"
                android:clickable="true"
                android:elevation="@dimen/margin_8dp"
                android:focusable="true"
                android:scaleType="fitXY"
                android:src="@drawable/ic_bear_menu_blue" />


            <include
                android:id="@+id/dashboard_menu"
                layout="@layout/dashboard_menu_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                tools:context=".dashboard.DashboardActivity">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="42dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/happy_you_logo_dark" />



                    <ImageView
                        android:id="@+id/ivMenu"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_menuapp" />

                    <ImageView
                        android:id="@+id/ivWinnings"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:layout_toStartOf="@id/ivMenu"
                        android:src="@drawable/ic_home_gift" />

                    <ImageView
                        android:id="@+id/ivSearch"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:layout_toStartOf="@id/ivWinnings"
                        android:src="@drawable/ic_round_search_24px" />

                    <ImageView
                        android:id="@+id/ivSosImg"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:layout_toStartOf="@id/ivSearch"
                        android:src="@drawable/sos_new" />

                </RelativeLayout>


            </LinearLayout>

        </RelativeLayout>

    </androidx.drawerlayout.widget.DrawerLayout>
</layout>
