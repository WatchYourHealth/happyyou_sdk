<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">




        <dev.skymansandy.scratchcardlayout.ui.ScratchCardLayout
            android:id="@+id/scratchView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_300sdp"
            android:layout_centerInParent="true"
            android:background="@android:color/transparent"
            android:backgroundTint="@android:color/transparent"
            app:cardElevation="0dp"
            app:scratchEnabled="true"
            app:scratchDrawable="@drawable/square_scratch_orange"
            app:scratchRevealFullAtPercent="60"
            app:scratchWidth="50dp">

            <LinearLayout
                android:id="@+id/main_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:background="@drawable/one_sided_curved_border"
                android:orientation="vertical">



                <TextView
                    android:id="@+id/headerOne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:hint="@string/congratulation"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:layout_marginTop="8dp"
                    android:textSize="20sp">

                </TextView>

                <TextView
                    android:id="@+id/headerTwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/roboto_medium"
                    android:hint="@string/hurry_won"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="14sp">

                </TextView>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/margin_32dp"
                    >

                    <ImageView
                        android:id="@+id/ivScratch"
                        android:layout_width="wrap_content"
                        android:layout_height="90dp"
                        android:layout_marginHorizontal="@dimen/margin_16dp"
                        android:layout_marginTop="@dimen/margin_16dp"
                        android:src="@drawable/rewards_scratchable" />

                    <TextView
                        android:id="@+id/tvTitle"
                        style="@style/font_16sp_roboto_medium_black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/ivScratch"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/pink"
                        android:text="Reward Name" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvTitle">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPoints"
                                style="@style/font_26sp_roboto_medium_black"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="Points" />

                            <TextView
                                android:id="@+id/tvDescription2"
                                style="@style/font_16sp_roboto_medium_black"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center"
                                android:visibility="visible"
                                tools:text="" />

                        </LinearLayout>

                    </ScrollView>

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/llActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/margin_32dp"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:layout_marginBottom="@dimen/margin_10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPositive"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/blue_rc_bg_8dp"
                        android:fontFamily="@font/roboto_medium"
                        android:text="View"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16dp" />

                    <Button
                        android:id="@+id/ivClose"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/pink_rc_bg_8dp"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Close"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16dp" />
                </LinearLayout>

            </LinearLayout>
        </dev.skymansandy.scratchcardlayout.ui.ScratchCardLayout>

    </RelativeLayout>
</layout>
