<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/one_sided_curved_border_info"
        android:padding="20dp">


        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_app_logo" />

        <TextView
            android:id="@+id/tvFeedbackDes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:text="@string/enjoying_kli_happy_you_app"
            android:textColor="@color/black"
            android:textSize="20sp" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">

            <TextView
                android:id="@+id/tvFeedbackQuestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/roboto_regular"
                android:gravity="start"
                android:text="@string/enjoying_kli_happy_you_app"
                android:textColor="@color/black"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>


            <RelativeLayout
                android:id="@+id/llOptionBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvFeedbackQuestion">

                <EditText
                    android:id="@+id/tvFeedbackAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/light_gray_border_rc_bg_8dp"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="@string/enter_your_answer"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:layout_below="@+id/rvOption"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:singleLine="true"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/black"
                    />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:itemCount="4"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/feedback_option_item"
                    />

            </RelativeLayout>

            <EditText
                android:id="@+id/edtFeedback"
                style="@style/TextStyleBlack16sp"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginHorizontal="@dimen/margin_16dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/edit_text_border_blue_new"
                android:gravity="top"
                android:visibility="gone"
                android:layout_marginTop="@dimen/margin_10dp"
                android:hint="@string/please_write_your_feedback_here"
                android:inputType="text|textMultiLine"
                android:maxLength="1000"
                android:maxLines="10"
                android:padding="8dp"
                app:layout_constraintTop_toBottomOf="@+id/llOptionBtn"
                android:singleLine="false" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_16dp"
                android:layout_marginBottom="25dp"
                android:layout_marginTop="@dimen/margin_10dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/edtFeedback"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnPrevious"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/wyh_round_btn_orange"
                        android:text="@string/previous"
                        android:layout_marginEnd="@dimen/margin_5dp"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />

                    <Button
                        android:id="@+id/btnNext"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/blue_rc_bg_8dp"
                        android:text="@string/next"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_5dp"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />


                </LinearLayout>

                <Button
                    android:id="@+id/btnClosed"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:background="@drawable/wyh_round_btn_dark_red"
                    android:text="@string/close"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

            </LinearLayout>




        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>


</layout>