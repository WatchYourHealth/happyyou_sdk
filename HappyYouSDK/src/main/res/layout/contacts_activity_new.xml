<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/topBg"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_hra_orange_bg" />

        <include
            android:id="@+id/includeBack"
            layout="@layout/layout_back" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_below="@id/includeBack">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:src="@drawable/happy_3_screen2"/>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/topBg"
            android:layout_marginHorizontal="@dimen/margin_16dp"
            android:orientation="vertical">

            <TextView
                style="@style/font_16sp_roboto_medium_black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Invite your family and friends to join our wellbeing journey by sharing invite" />

            <Button
                android:id="@+id/btnShareViaSMS"
                style="@style/font_15sp_roboto_medium_white"
                android:layout_width="200dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:background="@drawable/blue_rc_bg_8dp"
                android:gravity="center"
                android:text="@string/invite_via_sms"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnShareViaWhatsapp"
                style="@style/font_15sp_roboto_medium_white"
                android:layout_width="200dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_16dp"
                android:background="@drawable/blue_rc_bg_8dp"
                android:gravity="center"
                android:text="@string/invite_via_whatsapp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnShareViaEmail"
                style="@style/font_15sp_roboto_medium_white"
                android:layout_width="200dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_16dp"
                android:background="@drawable/blue_rc_bg_8dp"
                android:gravity="center"
                android:text="@string/invite_via_email"
                android:textAllCaps="false" />
        </LinearLayout>


        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />

    </RelativeLayout>
</layout>
