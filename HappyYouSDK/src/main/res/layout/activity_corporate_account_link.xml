<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root">
    <RelativeLayout android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_corporate_main_new"
        xmlns:tools="http://schemas.android.com/tools">


        <RelativeLayout
            android:id="@+id/rlUpperCard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/imBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/back_icon"
                app:tint="@color/black" />

            <TextView
                android:layout_toEndOf="@+id/imBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="16sp"
                android:layout_marginStart="8dp"
                android:text="Corporate User"
                android:textColor="@color/black"
                />

        </RelativeLayout>
        <ImageView
            android:id="@+id/imTopImage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="50dp"
            android:layout_below="@+id/rlUpperCard"
            android:src="@drawable/im_corporate_bear"
            />
        <LinearLayout
            android:layout_below="@+id/imTopImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_corporate_upper"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                >
                <LinearLayout
                    android:layout_gravity="bottom"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Access Corporate \nBenefit"
                        android:textSize="20sp"
                        android:layout_marginTop="10dp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Benfit - Access To Traning Webinars, Special \nOffers And Cashback Rewards Etc."
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_marginTop="10dp"
                        />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/llSection1"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_corporate_email"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email ID"
                        android:textColor="@color/black"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="20dp"
                        />
                    <EditText
                        android:id="@+id/etEmailID"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_edit_text_corporate"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="10dp"
                        android:textSize="14sp"
                        android:padding="5dp"
                        android:hint="Enter Your Corporate Email ID"
                        />
                    <LinearLayout

                        android:id="@+id/continue_login"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/cream_background"
                        android:layout_marginBottom="10dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvSendOTP"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:padding="10dp"
                            android:text="@string/continue_login"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="14sp">

                        </TextView>


                    </LinearLayout>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/llSection2"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@drawable/bg_corporate_email"

                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Your Corporate"
                        android:textColor="@color/black"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="20dp"
                        />
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/edit_text_border"
                        android:backgroundTint="@color/blue"

                        >
                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/spinnerCorporateName"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/edit_text_border"
                            android:padding="8dp" />
                        <ImageView
                            android:id="@+id/imSpinner"
                            android:layout_height="18dp"
                            android:layout_width="18dp"
                            android:src="@drawable/dropdown_blue_arrow"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="10dp"
                            android:visibility="invisible"
                            app:tint="@color/black" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:visibility="gone">

                        <in.aabhasjindal.otptextview.OtpTextView
                            android:id="@+id/edtOTP"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            app:height="32dp"
                            app:length="6"
                            app:otp_box_background_active="@drawable/reward_otp_active_box"
                            app:otp_box_background_inactive="@drawable/reward_otp_active_box"
                            app:otp_text_size="12sp"
                            app:width="32dp" />


                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvResendOTP"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="5dp"
                        android:text="@string/resend_otp"
                        android:visibility="gone"
                        android:clickable="false"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:weightSum="2"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvEditEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="20dp"
                            android:text="Edit Email"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:background="@drawable/cream_background"
                            android:textSize="14sp">

                        </TextView>
                        <TextView
                            android:id="@+id/tvContinue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:layout_weight="1"
                            android:text="@string/continue_login"
                            android:textAlignment="center"
                            android:textColor="@color/black"

                            android:layout_marginStart="20dp"
                            android:background="@drawable/cream_background"
                            android:textSize="14sp">

                        </TextView>



                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>


            <TextView
                android:id="@+id/tvNotNow"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:padding="5dp"
                android:layout_gravity="center_horizontal"
                android:text="Not Now"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="14sp"/>
            <View
                android:layout_width="55dp"
                android:layout_height="1dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/black"
                />
        </LinearLayout>



    </RelativeLayout>
</layout>