<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_with_two_corner">

        <ScrollView
            android:id="@+id/scrollReward"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:scrollbars="none"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="@color/white"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvCongratulations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="Congratulations!"
                    android:textColor="@color/black"
                    android:textFontWeight="500"
                    android:textSize="20dp"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvYouHaveWon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="You Have Won A"
                    android:textColor="@color/black"
                    android:textFontWeight="400"
                    android:textSize="20dp"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvVouchername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineHeight="44dp"
                    android:paddingHorizontal="24dp"
                    android:text="Amazon Voucher"
                    android:textFontWeight="700"
                    android:textSize="44dp" />

                <TextView
                    android:id="@+id/tvVoucherWinMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineHeight="14dp"
                    android:minLines="3"
                    android:text="You have won an Amazon voucher worth
INR 50. You can redeem this voucher with in the Happy You app."
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="12dp" />


                <LinearLayout
                    android:id="@+id/llActivityUi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginVertical="16dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/black"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tvExpiredHours"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="6dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:text="Expire in 48 hours"
                            android:textAlignment="center"
                            android:textFontWeight="700" />
                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/grey" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="16dp"
                        android:fontFamily="sans-serif"
                        android:paddingEnd="36dp"
                        android:text="To claim the reward, please complete the activity below."
                        android:textColor="@color/black"
                        android:textFontWeight="700"
                        android:textSize="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:lineHeight="16dp"
                        android:text="Activity"
                        android:textColor="@color/black"
                        android:textFontWeight="600"
                        android:textSize="16dp" />

                    <TextView
                        android:id="@+id/tvActivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:lineHeight="16dp"
                        android:textColor="@color/black"
                        android:textFontWeight="400"
                        android:textSize="12dp"
                        tools:text="Read 5 blog posts in a month" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif"
                        android:lineHeight="16dp"
                        android:text="What to do?"
                        android:textColor="@color/black"
                        android:textFontWeight="600"
                        android:textSize="16dp" />

                    <TextView
                        android:id="@+id/tvWhatToDo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:lineHeight="16dp"
                        android:textColor="@color/black"
                        android:textFontWeight="400"
                        android:textSize="12dp"
                        tools:text="One minute reading for better insights" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif"
                        android:lineHeight="16dp"
                        android:text="How to do?"
                        android:textColor="@color/black"
                        android:textFontWeight="600"
                        android:textSize="16dp" />

                    <TextView
                        android:id="@+id/tvHowToDo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:lineHeight="16dp"
                        android:textColor="@color/black"
                        android:textFontWeight="400"
                        android:textSize="12dp"
                        tools:text="Read a blog post/article under the Bear icon>Services>Health HackS>Quick Reads," />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif"
                        android:lineHeight="16dp"
                        android:text="Why to do?"
                        android:textColor="@color/black"
                        android:textFontWeight="600"
                        android:textSize="16dp" />

                    <TextView
                        android:id="@+id/tvWhyToDo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:lineHeight="16dp"
                        android:textColor="@color/black"
                        android:textFontWeight="400"
                        android:textSize="12dp"
                        tools:text="Reading helps you gain a better understanding of your wellness." />

                    <TextView
                        android:id="@+id/tvJournalupload"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif"
                        android:lineHeight="16dp"
                        android:text="Write something about this activity..."
                        android:textColor="@color/black"
                        android:textFontWeight="600"
                        android:textSize="16dp" />

                    <EditText
                        android:id="@+id/edWriteSomethingJournal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/edit_text_border_grey"
                        android:gravity="start"
                        android:minLines="3"
                        android:padding="16dp"
                        android:text=""
                        android:hint="Please write more than 15 characters about the activity"
                        android:textAlignment="textStart"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textSize="12dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:gravity="center"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btn_Completeevent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_white_border_reward"
                        android:elevation="16dp"
                        android:fontFamily="sans-serif"
                        android:stateListAnimator="@null"
                        android:text="Claim"
                        android:textAllCaps="false"
                        android:textFontWeight="600"
                        android:textSize="16dp"

                        android:translationZ="16dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent" />

                    <Button
                        android:id="@+id/btn_ViewReward"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_white_border_reward"
                        android:elevation="16dp"
                        android:fontFamily="sans-serif"
                        android:stateListAnimator="@null"
                        android:text="View My Rewards"
                        android:textAllCaps="false"
                        android:textFontWeight="600"
                        android:textSize="16dp"
                        android:translationZ="16dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent" />

                    <Button
                        android:id="@+id/btn_Startevent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_white_border_reward"
                        android:elevation="16dp"
                        android:fontFamily="sans-serif"
                        android:stateListAnimator="@null"
                        android:text="Claim"
                        android:textAllCaps="false"
                        android:textFontWeight="600"
                        android:textSize="16dp"
                        android:translationZ="16dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent" />

                    <Button
                        android:id="@+id/btn_SubmitEvent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_white_border_reward"
                        android:elevation="16dp"
                        android:fontFamily="sans-serif"
                        android:stateListAnimator="@null"
                        android:text="Submit"
                        android:textAllCaps="false"
                        android:textFontWeight="600"
                        android:textSize="16dp"
                        android:translationZ="16dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent" />

                    <Button
                        android:id="@+id/btn_Closeevent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_white_border_reward"
                        android:elevation="16dp"
                        android:fontFamily="sans-serif"
                        android:stateListAnimator="@null"
                        android:text="Close"
                        android:textAllCaps="false"
                        android:textFontWeight="600"
                        android:textSize="16dp"
                        android:translationZ="16dp"
                        app:layout_constraintTop_toTopOf="parent" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
        <ImageView
            android:id="@+id/ivCelebration"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="@id/scrollReward" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>