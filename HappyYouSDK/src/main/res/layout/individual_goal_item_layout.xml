<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <RelativeLayout
            android:id="@+id/rlGoal1"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            android:background="@drawable/light_blue_button_bg"
            android:clipChildren="true"
            android:layout_marginEnd="8dp"
            android:clipToPadding="true">

            <LinearLayout
                android:id="@+id/recomended_goal_img_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="10dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/goal_history_img1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_tele_consultation"
                    app:tint="@color/white" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvComName1"
                style="@style/font_14sp_roboto_medium_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="4dp"
                android:textAlignment="center" />

            <ImageView
                android:id="@+id/iv_add_goal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:src="@drawable/add_challenge_hub"
                android:visibility="gone" />


            <ImageView
                android:id="@+id/deleteGoal1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                app:cardElevation="5sp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/delete_icon"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/goal_complete_check_img"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentRight="true"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/margin_10dp"
                android:background="@drawable/blue_circle"
                android:backgroundTint="@color/green"
                android:src="@drawable/ic_check"
                android:visibility="gone"/>

            <RelativeLayout
                android:id="@+id/progress_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">

                <ProgressBar
                    android:id="@+id/goal_progress_bar"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:max="100"
                    android:progress="50"
                    android:progressDrawable="@drawable/custom_progress_bar"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="30dp">

                </ProgressBar>

                <TextView
                    android:id="@+id/goal_points_tv"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:text="0 points"
                    android:textColor="@color/white"
                    android:textSize="@dimen/margin_10sp" />


            </RelativeLayout>





        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlGoal2"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"

            android:background="@drawable/ic_light_pink_button_bg"
            android:visibility="visible">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="10dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/goal_history_img2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_tele_consultation"
                    app:tint="@color/white" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvComName2"
                style="@style/font_14sp_roboto_medium_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_centerInParent="true"
                android:textAlignment="center" />

            <ImageView
                android:id="@+id/iv_add_goal2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:src="@drawable/add_challenge_hub"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/deleteGoal2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                app:cardElevation="5sp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/delete_icon"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/goal_complete_check_img2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentRight="true"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/margin_10dp"
                android:background="@drawable/blue_circle"
                android:backgroundTint="@color/green"
                android:src="@drawable/ic_check"
                android:visibility="gone"/>

            <RelativeLayout
                android:id="@+id/progress_layout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">

                <ProgressBar
                    android:id="@+id/goal_progress_bar2"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:max="100"
                    android:progress="30"
                    android:progressDrawable="@drawable/custom_progress_bar"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="30dp">

                </ProgressBar>

                <TextView
                    android:id="@+id/goal_points_tv2"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:text="0 points"
                    android:textColor="@color/white"
                    android:textSize="@dimen/margin_10sp" />


            </RelativeLayout>


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlGoal3"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ic_light_orange_button_bg"
            android:visibility="visible">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="10dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/goal_history_img3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_tele_consultation"
                    app:tint="@color/white" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvComName3"
                style="@style/font_14sp_roboto_medium_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_centerInParent="true"
                android:textAlignment="center" />

            <ImageView
                android:id="@+id/iv_add_goal3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:src="@drawable/add_challenge_hub"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/deleteGoal3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                app:cardElevation="5sp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/delete_icon"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/goal_complete_check_img3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentRight="true"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/margin_10dp"
                android:background="@drawable/blue_circle"
                android:backgroundTint="@color/green"
                android:src="@drawable/ic_check"
                android:visibility="gone"/>

            <RelativeLayout
                android:id="@+id/progress_layout3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">

                <ProgressBar
                    android:id="@+id/goal_progress_bar3"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:max="100"
                    android:progress="80"
                    android:progressDrawable="@drawable/custom_progress_bar"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="30dp">

                </ProgressBar>

                <TextView
                    android:id="@+id/goal_points_tv3"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:text="0 points"
                    android:textColor="@color/white"
                    android:textSize="@dimen/margin_10sp" />


            </RelativeLayout>



        </RelativeLayout>


    </LinearLayout>

</LinearLayout>