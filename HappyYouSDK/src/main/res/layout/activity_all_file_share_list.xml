<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:orientation="vertical"
        tools:context=".SpinWheel.Activities.spinwheelreward.RewardsListActivity">

        <LinearLayout
            android:id="@+id/llMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivBackPressed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:src="@drawable/back_icon"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/tvHeadTitle"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="16dp"

                android:drawablePadding="16dp"
                android:drawableTint="@color/black"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:text="Shared Files"
                android:textColor="@color/black"
                android:textFontWeight="500"
                android:textSize="18dp" />
        </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/rlActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/tvType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="16dp"
                        android:drawableTint="@color/black"
                        android:textColor="@color/black"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:text="Active"
                        android:visibility="gone"
                        android:textFontWeight="500"
                        android:textSize="18dp" />

                </RelativeLayout>

                <GridView
                    android:id="@+id/gvCardFileShare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:gravity="center_vertical"
                    android:horizontalSpacing="5dp"
                    android:verticalSpacing="5dp"
                    android:numColumns="3"
                    android:orientation="horizontal"
                    tools:listitem="@layout/adapter_file_share_list" />
            </LinearLayout>



    </LinearLayout>

</layout>