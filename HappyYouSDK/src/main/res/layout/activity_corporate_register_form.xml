<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root">
    <RelativeLayout android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_corporate_main_new"
        xmlns:tools="http://schemas.android.com/tools">


        <RelativeLayout
            android:id="@+id/rlUpperCard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/imBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/back_icon"
                app:tint="@color/black" />

            <TextView
                android:layout_toEndOf="@+id/imBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="16sp"
                android:layout_marginStart="8dp"
                android:text="Corporate User"
                android:textColor="@color/black"
                />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_below="@+id/rlUpperCard"
            android:layout_marginTop="20dp"
            >


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_register_corporate"
                android:layout_marginStart="30dp"
                android:weightSum="2"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="16dp"
                >
                <LinearLayout
                    android:id="@+id/llTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/white_rc_bg_bottom_8dp"
                    android:layout_margin="3dp"
                    >
                <LinearLayout
                    android:id="@+id/llhead"
                    android:layout_weight="0.75"
                    android:layout_gravity="bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Add Your Corporate Details"
                        android:textSize="20sp"
                        android:layout_marginTop="10dp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        />


                </LinearLayout>
                    <TextView
                        android:id="@+id/tvSelectCorporate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose Your Corporate Account"
                        android:textSize="14sp"
                        android:layout_marginStart="30dp"
                        android:layout_marginEnd="30dp"
                        android:textAlignment="textStart"
                        android:textColor="@color/black"/>
                <RelativeLayout
                    android:layout_below="@+id/llhead"
                    android:id="@+id/rlSpinner1"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/edit_text_border"
                    android:backgroundTint="@color/blue"

                    >

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinnerSpinWheel"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/new_login_edit_text_bg"
                        android:padding="8dp" />
                    <ImageView
                        android:id="@+id/imSpinnerSpinWheel"
                        android:layout_height="18dp"
                        android:layout_width="18dp"
                        android:src="@drawable/dropdown_blue_arrow"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="10dp"
                        android:visibility="invisible"
                        app:tint="@color/black" />
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rlspinner2"
                    android:layout_below="@+id/rlSpinner1"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"

                    android:background="@drawable/edit_text_border"
                    android:backgroundTint="@color/blue"

                    >
                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinnerNonSpinWheel"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/new_login_edit_text_bg"
                        android:padding="8dp" />
                    <ImageView
                        android:id="@+id/imSpinnerNonSpinWheel"
                        android:layout_height="18dp"
                        android:layout_width="18dp"
                        android:src="@drawable/dropdown_blue_arrow"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:visibility="invisible"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/black" />
                </RelativeLayout>
                </LinearLayout>
                <ScrollView
                    android:layout_below="@+id/llTop"
                    android:id="@+id/scvRegScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_register_corporate"
                   >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/formContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="8dp"
                            android:paddingStart="8dp"
                            android:layout_marginTop="10dp"
                            android:paddingEnd="8dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:gravity="center">

                            <Button
                                android:id="@+id/btnSubmit"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_width="0dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="@dimen/margin_10dp"
                                android:layout_weight="1"
                                android:background="@drawable/cream_background"
                                android:fontFamily="@font/roboto_medium"
                                android:text="Continue"
                                android:textAllCaps="false"
                                android:textColor="@color/black"
                                android:textSize="16dp"
                                android:visibility="visible" />


                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </RelativeLayout>

        </LinearLayout>



    </RelativeLayout>
</layout>