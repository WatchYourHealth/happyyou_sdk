<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <include
                        android:id="@+id/includeBack"
                        layout="@layout/layout_back" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivHead"
                            android:layout_width="match_parent"
                            android:layout_height="340dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/know_your_wellbeing_bg" />

                        <WebView
                            android:id="@+id/tvAboutUs"
                            style="@style/font_16sp_roboto_medium_black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_16dp"
                            android:fontFamily="@font/roboto_regular"
                            android:justificationMode="inter_word"
                            android:letterSpacing="0.02"
                            android:lineSpacingExtra="1dp"
                            android:layout_marginTop="-20dp"
                            android:text="@string/about_us" />


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/margin_16dp"
                            android:layout_marginTop="@dimen/margin_14dp"
                            android:background="@color/happy_light_grey" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:weightSum="2">

                            <TextView
                                android:id="@+id/txtAppVersion"
                                style="@style/font_14sp_roboto_regular_black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/margin_16dp"
                                android:layout_weight="1"
                                android:text="App Version" />

                            <TextView
                                android:id="@+id/tvAppVersionVal"
                                style="@style/font_14sp_roboto_regular_black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/margin_16dp"
                                android:layout_weight="1"
                                android:text="v1.0.1"
                                android:textAlignment="textEnd" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/margin_16dp"
                            android:background="@color/happy_light_grey" />

                        <TextView
                            android:id="@+id/tv_tandc"
                            style="@style/font_14sp_roboto_regular_black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:background="?attr/selectableItemBackground"
                            android:letterSpacing="0.03"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="Terms of Use"
                            android:visibility="visible" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/margin_16dp"
                            android:background="@color/happy_light_grey" />

                        <TextView
                            android:id="@+id/tv_pp"
                            style="@style/font_14sp_roboto_regular_black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginBottom="@dimen/margin_12dp"
                            android:background="?attr/selectableItemBackground"
                            android:letterSpacing="0.03"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="Privacy Policy"
                            android:visibility="visible" />

                    </LinearLayout>

                </RelativeLayout>

            </ScrollView>

        </LinearLayout>

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />
    </RelativeLayout>


</layout>
