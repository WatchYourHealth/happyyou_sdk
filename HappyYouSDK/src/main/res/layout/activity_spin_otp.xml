<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wheel_screen_bg"
        android:orientation="vertical"
        android:weightSum="8">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3"
            android:weightSum="2"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/logoImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1.5">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="30dp"
                    android:layout_marginHorizontal="38dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/bg_policy_kgi_bottom"
                    android:backgroundTint="@color/white"
                    android:src="@drawable/new_icon" />

            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_alignParentEnd="true"
                android:src="@drawable/new_login_bear" />


        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5.7"
            android:weightSum="2"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="38dp"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:weightSum="2"
                android:background="@drawable/spin_reward_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:orientation="vertical"
                    android:background="@drawable/spin_wheel_layout_bg">


                <LinearLayout
                    android:id="@+id/rewards_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/spin_reward_name_bg">

                    <TextView
                        android:id="@+id/header_one"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/congratulation"
                        android:textSize="22sp"
                        android:textAlignment="center"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/header_two"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/won"
                        android:textSize="16sp"
                        android:textAlignment="center"
                        android:textColor="@color/black"/>

                    <TextView
                        android:id="@+id/otp_reward_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/amazon"
                        android:textSize="38sp"
                        android:textAlignment="center"
                        android:layout_marginHorizontal="16dp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"
                        android:textColor="#C3BF8F"/>

                    <TextView
                        android:id="@+id/otp_reward_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/prize_desc"
                        android:textSize="12sp"
                        android:textAlignment="center"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/black"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/time_out_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:src="@drawable/time_up_img"
                        android:layout_marginHorizontal="32dp"
                        android:layout_marginTop="20dp"
                        android:layout_gravity="center_horizontal|center_vertical">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/time_up_desc"
                        android:textSize="16sp"
                        android:layout_marginTop="12dp"
                        android:layout_gravity="center_horizontal"
                        android:textAlignment="center"
                        android:textColor="@color/black"/>



                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/reward_mobile_num_bg">

                    <TextView
                        android:id="@+id/otp_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/timer"
                        android:textSize="16sp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/timer_background"
                        android:layout_gravity="center_horizontal"
                        android:textAlignment="center"
                        android:textColor="@color/black"/>


                    <TextView
                        android:id="@+id/hurry_up_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hurry_up"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp"
                        android:layout_gravity="center_horizontal"
                        android:textAlignment="center"
                        android:textStyle="bold"
                        android:textColor="@color/black"/>

                    <TextView
                        android:id="@+id/log_in_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/claim_reward"
                        android:textSize="14sp"
                        android:layout_marginTop="12dp"
                        android:layout_gravity="center_horizontal"
                        android:textAlignment="center"
                        android:textColor="@color/black"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center">

                        <in.aabhasjindal.otptextview.OtpTextView
                            android:id="@+id/edtOTP"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            app:height="32dp"
                            app:length="6"
                            app:otp_box_background_active="@drawable/reward_otp_active_box"
                            app:otp_box_background_inactive="@drawable/reward_otp_active_box"
                            app:otp_text_size="12sp"
                            app:width="32dp" />


                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvResendOTP"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/resend_otp"
                        android:textSize="16sp"
                        android:layout_marginHorizontal="16dp"
                        android:textColor="@color/black"/>


                    <LinearLayout
                        android:id="@+id/continue_login"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:background="@drawable/cream_background">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Verify OTP"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:textAlignment="center"
                            android:padding="16dp">

                        </TextView>


                    </LinearLayout>




                </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>







    </LinearLayout>


</layout>
