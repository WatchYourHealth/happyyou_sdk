<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/viewStart"
            android:layout_width="16dp"
            android:layout_height="1dp"
            android:background="@color/grey"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivFlameStreak"
            app:layout_constraintBottom_toBottomOf="@id/ivFlameStreak" />

        <ImageView
            android:id="@+id/ivFlameStreak"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_hu_flame"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginVertical="8dp"
            app:layout_constraintStart_toEndOf="@id/viewStart" />

        <TextView
            android:id="@+id/tvDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Day 1"
            android:fontFamily="sans-serif"
            android:textColor="@color/black"
            android:gravity="center"
            android:textFontWeight="500"
            app:layout_constraintTop_toBottomOf="@id/ivFlameStreak"
            app:layout_constraintStart_toStartOf="@id/ivFlameStreak"
            app:layout_constraintEnd_toEndOf="@id/ivFlameStreak"/>

        <View
            android:id="@+id/viewEnd"
            android:layout_width="16dp"
            android:layout_height="1dp"
            android:background="@color/grey"
            app:layout_constraintStart_toEndOf="@id/ivFlameStreak"
            app:layout_constraintTop_toTopOf="@id/ivFlameStreak"
            app:layout_constraintBottom_toBottomOf="@id/ivFlameStreak" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>