<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">



    <RelativeLayout
        android:id="@+id/rlMainLayout"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/margin_8dp"
        android:background="@drawable/scratch_card_orange_new"
        android:clipChildren="true"
        android:clipToPadding="true">

        <androidx.cardview.widget.CardView
            android:id="@+id/cvLogo1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/transparent"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_32dp">

            <ImageView
                android:id="@+id/ivVendorLogo1"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitXY" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvArticleHead1"
            style="@style/TextStyleBlack16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cvLogo1"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:text="Article Name" />

        <TextView
            android:id="@+id/tv_article_1"
            style="@style/TextStyleBlack16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvArticleHead1"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="4dp"
            tools:text="Article Name"
            android:visibility="gone"
            android:textColor="@color/white"
            android:textSize="14dp" />

    </RelativeLayout>
</layout>