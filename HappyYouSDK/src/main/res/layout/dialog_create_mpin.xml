<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/white_rc_bg_16dp">

    <RelativeLayout
        android:id="@+id/cvScoreItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Create MPIN"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvSetMPIN"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set MPIN"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edtSetMPIN"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="@dimen/margin_32dp"
                android:background="@drawable/bg_active"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Re-enter MPIN"
                android:layout_marginTop="6dp"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edtOTP"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="@dimen/margin_32dp"
                android:background="@drawable/bg_active"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/imSubmit"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:background="@drawable/ic_policy_submit_new"
                android:paddingTop="8dp"
                android:text="Submit"
                android:textAlignment="center"
                android:textColor="@color/black" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>