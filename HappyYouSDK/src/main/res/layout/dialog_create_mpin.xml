<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/white_rc_bg_16dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/cvScoreItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginBottom="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="20dp"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create MPIN"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_marginBottom="20dp"
            />

        <TextView
            android:id="@+id/tvSetMPIN"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set MPIN"
            android:textColor="@color/black"
            android:textSize="12sp"
            />
        <com.otpview.OTPTextView
            android:id="@+id/edtSetMPIN"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:height="42dp"
            app:length="4"
            app:otp_box_background_active="@drawable/bg_active"
            app:otp_box_background_inactive="@drawable/edit_text_border"
            app:otp_text_size="16sp"
            app:width="42dp"
            android:layout_marginTop="5dp"
            app:hide_otp="true"
            app:hide_otp_drawable="@drawable/txt_pin"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Re-enter MPIN"
            android:textColor="@color/black"
            android:textSize="12sp"
            />
        <com.otpview.OTPTextView
            android:id="@+id/edtOTP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:height="42dp"
            app:length="4"
            app:otp_box_background_active="@drawable/bg_active"
            app:otp_box_background_inactive="@drawable/edit_text_border"
            app:otp_text_size="16sp"
            app:width="42dp"
            android:layout_marginTop="5dp"
            app:hide_otp="true"
            app:hide_otp_drawable="@drawable/txt_pin"
            />

        <TextView
            android:id="@+id/imSubmit"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:text="Submit"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:paddingTop="8dp"
            android:background="@drawable/ic_policy_submit_new"
            />
    </LinearLayout>
    </RelativeLayout>
</RelativeLayout>