<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:padding="15dp"
        android:layout_marginVertical="5dp"
        android:background="@drawable/edit_text_border_blue_new"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1.7">

            <TextView
                android:id="@+id/name"
                style="@style/font_15sp_roboto_medium_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16dp"
                android:textStyle="bold"
                android:text="Name" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/relationship"
                    style="@style/font_15sp_roboto_regular_black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14dp"
                    android:maxLength="10"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Relationship" />

                <LinearLayout
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:background="@color/black"
                    android:layout_marginEnd="5dp"
                    />
                <TextView
                    android:id="@+id/mobileNumber"
                    style="@style/font_15sp_roboto_regular_black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14dp"
                    android:maxLength="10"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Mobile Number" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_weight="0.3">

            <ImageButton
                android:id="@+id/ivDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:padding="@dimen/margin_10dp"
                android:background="@drawable/pink_rc_bg_8dp"
                android:src="@drawable/ic_delete_diary_white"
                android:scaleType="fitCenter" />

        </LinearLayout>

    </LinearLayout>

</layout>