<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/connection_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tribe_count_layout"
            android:padding="16dp">

        </androidx.recyclerview.widget.RecyclerView>

        <TextView
            android:id="@+id/no_data_found_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_data_found"
            android:layout_centerInParent="true"
            android:textAlignment="center"
            android:textSize="16sp"
            android:fontFamily="@font/roboto_regular"/>

      <RelativeLayout
          android:id="@+id/tribe_count_layout"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:padding="8dp">

          <View
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:visibility="gone"
              android:background="@color/black"/>

          <TextView
              android:id="@+id/total_count_tv"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Your tribe count is 5"
              android:textAlignment="textStart"
              android:textColor="@color/black"
              android:textSize="16sp"
              android:layout_marginHorizontal="16dp"
              android:layout_toStartOf="@+id/infoImg"
              android:fontFamily="@font/roboto_regular" />

          <ImageView
              android:id="@+id/infoImg"
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:src="@drawable/ic_info"
              android:layout_alignParentEnd="true"
              app:tint="@color/black">

          </ImageView>

          <View
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:layout_below="@+id/total_count_tv"
              android:layout_marginTop="8dp"
              android:background="@color/black"/>

      </RelativeLayout>


    </RelativeLayout>
</layout>
