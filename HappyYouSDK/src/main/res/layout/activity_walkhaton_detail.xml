<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ChallangesModule.Walkathon.Activities.WalkhatonDetailActivity">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:background="@drawable/walkhaton_bg">

                    <LinearLayout
                        android:id="@+id/walkhathon_back_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivBackImg"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="1dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_arrow_back" />

                        <TextView
                            android:id="@+id/challenges_back"
                            style="@style/font_16sp_roboto_medium_black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.03"
                            android:text="Back"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <ImageView
                        android:id="@+id/teddy_img"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/walkhaton_bear"
                        android:layout_above="@id/rank_layout"
                        android:layout_marginStart="20dp">

                    </ImageView>
                    
                    <RelativeLayout
                        android:id="@+id/rank_layout"
                        android:layout_width="100dp"
                        android:layout_height="150dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/rank_bg">

                        <TextView
                            android:id="@+id/rank_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/walkhaton_rank"
                            android:textAlignment="center"
                            android:textSize="22sp"
                            android:layout_below="@+id/rankDespTv"
                            android:textColor="@color/black"
                            android:fontFamily="@font/roboto_medium">

                        </TextView>

                        <TextView
                            android:id="@+id/total_rank_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/walkhaton_total_rank"
                            android:layout_below="@id/rank_tv"
                            android:textAlignment="center"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/roboto_regular">

                        </TextView>

                        <TextView
                            android:id="@+id/branch_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/roboto_medium"
                            android:text="@string/branch_name"
                            android:layout_alignParentBottom="true"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="10sp">

                        </TextView>

                        <TextView
                            android:id="@+id/clickHereTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/total_rank_tv"
                            android:layout_centerInParent="true"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/white_rc_bg_8dp"
                            android:fontFamily="@font/roboto_medium"
                            android:paddingHorizontal="5dp"
                            android:text="Click here"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="10sp" />


                        <TextView
                            android:id="@+id/rankDespTv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/walkhaton_rank_text"
                            android:textAlignment="center"
                            android:padding="4dp"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/roboto_regular">

                        </TextView>


                    </RelativeLayout>

                    <RelativeLayout

                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="24dp"
                        android:layout_toRightOf="@id/rank_layout"
                        android:background="@drawable/rank_grey_bg">

                        <TextView
                            android:id="@+id/all_rank_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:textSize="22sp"
                            android:text="0"
                            android:layout_above="@id/total_all_rank_tv"
                            android:textColor="@color/black"
                            android:fontFamily="@font/roboto_medium">

                        </TextView>

                        <TextView
                            android:id="@+id/total_all_rank_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:text="out of 0"
                            android:textSize="10sp"
                            android:layout_alignParentBottom="true"
                            android:textColor="@color/black"
                            android:fontFamily="@font/roboto_regular">

                        </TextView>


                        <TextView
                            android:id="@+id/all_rank_desp_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/all_rank_tv"
                            android:textAlignment="center"
                            android:textSize="10sp"
                            android:padding="4dp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/roboto_regular">

                        </TextView>


                    </RelativeLayout>

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/trophy_img"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="8dp"
                    >

                    </ImageView>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/teddy_img"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/steps_info_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:layout_toRightOf="@id/teddy_img"
                            android:orientation="horizontal"
                            android:layout_marginEnd="12dp"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:weightSum="2">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/roboto_regular"
                                    android:text="@string/all_India_steps"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="12sp">

                                </TextView>

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/total_steps_bg">

                                    <TextView
                                        android:id="@+id/total_steps_tv"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_centerInParent="true"
                                        android:fontFamily="@font/roboto_bold"
                                        android:text="0"
                                        android:textAlignment="center"
                                        android:textColor="@color/black"
                                        android:textSize="12sp" />


                                </RelativeLayout>


                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/roboto_regular"
                                    android:text="@string/total_participaint_India"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="12sp">

                                </TextView>

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/total_steps_bg">

                                    <TextView
                                        android:id="@+id/avg_steps_tv"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_centerInParent="true"
                                        android:fontFamily="@font/roboto_bold"
                                        android:text="0"
                                        android:textAlignment="center"
                                        android:textColor="@color/black"
                                        android:textSize="12sp" />


                                </RelativeLayout>

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/eventEndTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Event is Ended"
                            android:layout_marginHorizontal="16dp"
                            android:padding="12dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/total_steps_bg"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            android:layout_marginTop="20dp"
                            android:textColor="@color/red"
                            android:textSize="18sp"/>
                    </LinearLayout>

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_toRightOf="@id/teddy_img"
                        android:orientation="horizontal"
                        android:layout_marginHorizontal="16dp"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:weightSum="2">

                            <TextView
                                android:id="@+id/selected_total_steps"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto_regular"
                                android:text="@string/total_steps"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textSize="12sp">

                            </TextView>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:background="@drawable/total_steps_bg">

                                <TextView
                                    android:id="@+id/selected_total_steps_value"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:fontFamily="@font/roboto_bold"
                                    android:text="0"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />


                            </RelativeLayout>


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/selected_avg_steps"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto_regular"
                                android:text="@string/avg_steps"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textSize="12sp">

                            </TextView>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:background="@drawable/total_steps_bg">

                                <TextView
                                    android:id="@+id/selected_avg_steps_value"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:fontFamily="@font/roboto_bold"
                                    android:text="0"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />


                            </RelativeLayout>

                        </LinearLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:weightSum="2">
                        
                        <RelativeLayout
                            android:id="@+id/individual_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/carousel_black_bg"
                            android:layout_marginHorizontal="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:fontFamily="@font/roboto_medium"
                                android:text="@string/individual"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textSize="16sp">

                            </TextView>


                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/branch_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/branch_rank_bg"
                            android:layout_marginHorizontal="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:fontFamily="@font/roboto_medium"
                                android:text="Branch"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textSize="16sp">

                            </TextView>


                        </RelativeLayout>


                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/rank_list_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="18dp"
                            android:layout_marginHorizontal="16dp"
                            android:weightSum="4">

                            <TextView
                                android:id="@+id/walkhaton_rank_tv"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/rank"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:fontFamily="@font/roboto_bold"
                                android:padding="8dp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/walkhaton_name_tv"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/name"
                                android:textAlignment="center"
                                android:textSize="12sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/roboto_bold"
                                android:padding="8dp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/walkhaton_branch_tv"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/kli_branch"
                                android:textAlignment="center"
                                android:textSize="12sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/roboto_bold"
                                android:padding="8dp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/walkhaton_total_steps_tv"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/total_steps"
                                android:textAlignment="center"
                                android:textSize="12sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/roboto_bold"
                                android:padding="8dp"
                                android:textStyle="bold"/>


                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/black"
                            android:layout_marginHorizontal="16dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/branch_detail_pink_bg"
                            android:weightSum="4"
                            android:layout_marginHorizontal="16dp">

                            <TextView
                                android:id="@+id/my_rank_tv"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:hint="@string/rank"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:fontFamily="@font/roboto_bold"
                                android:padding="8dp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/my_name_tv"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:hint="@string/name"
                                android:textAlignment="center"
                                android:textSize="12sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/roboto_bold"
                                android:padding="8dp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/my_branch_tv"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:text="@string/branch"
                                android:textAlignment="center"
                                android:textSize="12sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/roboto_bold"
                                android:padding="8dp"
                                android:textStyle="bold"/>

                            <RelativeLayout
                                android:id="@+id/infoLayout"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/my_total_steps_tv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:hint="@string/total_steps"
                                    android:textAlignment="center"
                                    android:textSize="12sp"
                                    android:gravity="center"
                                    android:textColor="@color/black"
                                    android:fontFamily="@font/roboto_bold"
                                    android:padding="8dp"
                                    android:layout_marginEnd="15dp"
                                    android:textStyle="bold"/>

                                <ImageView
                                    android:id="@+id/ivInfo"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_gravity="center"
                                    app:tint="@color/black"
                                    android:visibility="gone"
                                    android:layout_marginEnd="2dp"
                                    tools:visibility="visible"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="4dp"
                                    android:src="@drawable/ic_info" />

                            </RelativeLayout>


                        </LinearLayout>



                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rank_list"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginHorizontal="16dp">

                        </androidx.recyclerview.widget.RecyclerView>

                        <Button
                            android:id="@+id/load_more_btn"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/button_pink_bg"
                            android:layout_marginHorizontal="32dp"
                            android:layout_marginTop="16dp"
                            android:text="@string/load_more"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:fontFamily="@font/roboto_bold">


                        </Button>


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_no_record_found"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:layout_marginTop="32dp"
                        android:orientation="vertical">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/la404Bear"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_gravity="center"
                            app:lottie_autoPlay="true" />

                        <TextView
                            style="@style/TextStyleBlack16sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/margin_16dp"
                            android:text="No Records Found"
                            android:textAlignment="center"
                            android:textColor="@color/btn_blue"
                            android:textSize="14sp" />
                    </LinearLayout>


                <Button
                    android:id="@+id/sync_device"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/branch_rank_bg"
                    android:layout_marginHorizontal="32dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:text="Sync your device"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:fontFamily="@font/roboto_bold"/>



                </LinearLayout>


            </LinearLayout>


        </ScrollView>

    </RelativeLayout>

</layout>
