<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root">
    <RelativeLayout android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_corporate_main_new"
        xmlns:tools="http://schemas.android.com/tools">


        <RelativeLayout
            android:id="@+id/rlUpperCard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/imBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/back_icon"
                app:tint="@color/black" />

            <TextView
                android:layout_toEndOf="@+id/imBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="16sp"
                android:layout_marginStart="8dp"
                android:text="Corporate User"
                android:textColor="@color/black"
                />

        </RelativeLayout>
        <ImageView
            android:id="@+id/imTopImage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="50dp"
            android:layout_below="@+id/rlUpperCard"
            android:src="@drawable/im_corporate_bear"
            />
        <LinearLayout
            android:layout_below="@+id/imTopImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            >


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_corporate_upper"
                android:layout_marginStart="30dp"
                android:weightSum="2"
                android:layout_marginEnd="30dp"
                >
                <LinearLayout
                    android:layout_weight="0.75"
                    android:layout_gravity="bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Access Corporate \nBenefit"
                    android:textSize="20sp"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Benfit - Access To Traning Webinars, Special \nOffers And Cashback Rewards Etc."
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_marginTop="10dp"
                    />
                </LinearLayout>
                <LinearLayout
                    android:layout_weight="1.25"
                    android:layout_gravity="bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_corporate_email"
                    >
                    <ImageView
                        android:id="@+id/corporateLog"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="30dp"
                        android:layout_marginStart="30dp"
                        android:src="@drawable/walkhaton_bear"
                        />
                    <LinearLayout
                        android:id="@+id/llCorporate"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:visibility="visible"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_corporate_name"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Corporate Name:"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            />
                        <TextView
                            android:id="@+id/tvCorporateName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kotak Life Insurance"
                            android:textSize="22sp"
                            android:layout_marginBottom="10dp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            />

                    </LinearLayout>
                    <TextView
                        android:id="@+id/continueLoginNew"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="15dp"
                        android:text="View Corporate Benefits"
                        android:alpha="0.5"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:background="@drawable/cream_background"
                        android:textSize="14sp"/>

                </LinearLayout>

            </LinearLayout>
            <TextView
                android:id="@+id/tvChangeCorporate"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:padding="5dp"
                android:layout_gravity="center_horizontal"
                android:text="Change Corporate"
                android:textAlignment="center"
                android:textColor="@color/black"

                android:textSize="14sp"/>
            <View
                android:layout_width="110dp"
                android:layout_height="1dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/black"
                />
        </LinearLayout>



    </RelativeLayout>
</layout>