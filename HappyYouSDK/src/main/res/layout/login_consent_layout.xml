<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/margin_32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/font_16sp_roboto_medium_black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_32dp"
                    android:letterSpacing="0.03"
                    android:text="Terms and Conditions"
                    android:textStyle="bold" />

                <WebView
                    android:id="@+id/tvContent"
                    style="@style/font_16sp_roboto_regular_black"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:letterSpacing="0.03"
                    android:text="@string/life_style_welcome" />

                <TextView
                    android:id="@+id/tvMoreContent"
                    style="@style/font_16sp_roboto_medium_black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:letterSpacing="0.03"
                    android:layout_marginBottom="@dimen/margin_16dp"
                    android:textColor="@color/blue"
                    android:visibility="gone"
                    android:text="PLEASE CLICK HERE TO READ MORE ABOUT OUR TERMS OF USE"
                    android:textStyle="bold" />



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/checkBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_tandc"
                        style="@style/font_16sp_roboto_medium_black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_10dp"
                        android:letterSpacing="0.03"
                        android:layout_marginBottom="@dimen/margin_16dp"
                        android:text="I accept the Terms of Use and Privacy policy"
                        android:textStyle="bold" />


                </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/margin_16dp"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnNo"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:layout_marginBottom="@dimen/margin_32dp"
                    android:background="@drawable/pink_rc_bg_8dp"
                    android:fontFamily="@font/roboto_black"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:paddingHorizontal="36dp"
                    android:text="Close"
                    android:layout_marginHorizontal="@dimen/margin_16dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:visibility="visible" />

                <Button
                    android:id="@+id/btnOK"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:layout_marginBottom="@dimen/margin_32dp"
                    android:background="@drawable/wyh_round_btn"
                    android:fontFamily="@font/roboto_black"
                    android:gravity="center"
                    android:paddingHorizontal="36dp"
                    android:text="OK"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/margin_16dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:visibility="visible" />
            </LinearLayout>



            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>

</layout>