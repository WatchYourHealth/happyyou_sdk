<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivRiddle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@drawable/quiz_bg"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:layout_marginTop="58dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp">

                <RelativeLayout
                    android:id="@+id/llQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_centerInParent="true">

                    <LinearLayout
                        android:id="@+id/llLayoutQ"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/margin_16dp"
                            android:scaleType="fitXY"
                            android:visibility="visible"
                            tools:background="@drawable/ic_bear_quiz" />

                        <TextView
                            android:id="@+id/tvQuestion"
                            style="@style/font_18sp_roboto_medium_white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginHorizontal="@dimen/margin_32dp"
                            android:layout_marginTop="20dp"
                            android:textStyle="bold"
                            tools:text="My Notes Title Text Notes Title Text Notes Title Text Notes Title Text" />


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/llLayoutQ"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/margin_10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHint"
                            style="@style/font_16sp_roboto_medium_white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_32dp"
                            tools:text="@string/your_selection" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llEnterAns"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/llHint"
                        android:layout_gravity="center"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/edtAns"
                            android:layout_width="wrap_content"
                            android:layout_height="50dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="30dp"
                            android:background="@drawable/edit_text_border"
                            android:backgroundTint="@color/white"
                            android:gravity="center"
                            android:hint="Enter your Answer"
                            android:paddingHorizontal="@dimen/margin_10dp"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white"
                            android:textSize="@dimen/margin_16sp" />

                        <Button
                            android:id="@+id/btnSubmit"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="120dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/margin_16dp"
                            android:background="@drawable/blue_rc_bg_8dp"
                            android:fontFamily="@font/roboto_medium"
                            android:text="Submit"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="16dp" />

                        <TextView
                            android:id="@+id/tvInfoMsg"
                            style="@style/font_16sp_roboto_medium_white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_margin="@dimen/margin_10dp"
                            android:layout_marginHorizontal="@dimen/margin_32dp"
                            android:textAlignment="center"
                            android:text="Hey! come back again in the\nevening to see the result" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/llEnterAns"
                        android:layout_centerInParent="true">

                        <LinearLayout
                            android:id="@+id/llAnswer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="40dp"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <TextView
                                style="@style/font_16sp_roboto_medium_white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginHorizontal="@dimen/margin_32dp"
                                android:text="Your Answer" />

                            <TextView
                                android:id="@+id/tvYourAns"
                                style="@style/font_18sp_roboto_medium_white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginHorizontal="@dimen/margin_32dp"
                                android:text="your Answer"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llCorrectAns"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/llAnswer"
                            android:layout_centerHorizontal="true"
                            android:layout_marginHorizontal="@dimen/margin_32dp"
                            android:layout_marginTop="40dp"
                            android:layout_marginBottom="@dimen/margin_10dp"
                            android:background="@drawable/blue_rc_bg_8dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/tvAnsYourSelection"
                                style="@style/font_18sp_roboto_medium_white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="The Answer is" />

                            <TextView
                                android:id="@+id/tvAnsYourSelectionAns"
                                style="@style/font_22sp_roboto_medium_white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/margin_10dp"
                                android:textAlignment="center"
                                android:textColor="@color/score_green_dark"
                                android:textStyle="bold"
                                tools:text="@string/your_selection" />

                        </LinearLayout>
                    </RelativeLayout>

                </RelativeLayout>
            </RelativeLayout>
        </ScrollView>

    </RelativeLayout>

</layout>