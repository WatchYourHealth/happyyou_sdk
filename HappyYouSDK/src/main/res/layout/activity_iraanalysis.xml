<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_above="@+id/retakeButtonLayout"
            android:layout_alignParentTop="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/llSectionScore"
                            android:layout_width="match_parent"
                            android:layout_height="300dp"
                            android:elevation="4dp"
                            android:orientation="horizontal">

                            <include
                                android:id="@+id/includeToolbar"
                                layout="@layout/layout_back" />
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="95dp">

                            <LinearLayout
                                android:layout_width="260dp"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="110dp"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/font_16sp_roboto_regular_black"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="32dp"
                                    android:layout_marginTop="32dp"
                                    android:gravity="center"
                                    android:text="@string/your_total_immunity_score" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_ira_health_score"
                                        style="@style/font_32sp_roboto_medium_black"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textSize="32dp" />

                                    <TextView
                                        android:id="@+id/tvTotalScore"
                                        style="@style/font_20sp_roboto_medium_black"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="/250"
                                        android:textSize="18dp" />

                                </LinearLayout>

                            </LinearLayout>

                            <com.mikhaellopez.circularprogressbar.CircularProgressBar
                                android:id="@+id/circleViewScore"
                                android:layout_width="260dp"
                                android:layout_height="260dp"
                                android:layout_centerHorizontal="true"
                                app:cpb_background_progressbar_color="#ECEFF4"
                                app:cpb_background_progressbar_width="10dp"
                                app:cpb_progress_direction="to_left"
                                app:cpb_progress_max="500"
                                app:cpb_progressbar_color="@color/pink"
                                app:cpb_progressbar_width="10dp"
                                app:cpb_round_border="true"
                                app:cpb_start_angle="270" />

                        </RelativeLayout>
                    </RelativeLayout>
                </LinearLayout>


                <RelativeLayout
                    android:id="@+id/rl_recommendation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_32dp">

                    <TextView
                        android:id="@+id/tv_header_1"
                        style="@style/font_16sp_roboto_medium_black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Based on your immune score you should practice the following:"
                        android:textStyle="" />

                    <TextView
                        android:id="@+id/tv_recommendations"
                        style="@style/font_16sp_roboto_regular_black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tv_header_1"
                        android:layout_marginTop="@dimen/margin_16dp" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_16dp"
                    android:padding="@dimen/margin_16dp">

                    <TextView
                        android:id="@+id/tv_header_2"
                        style="@style/font_14sp_roboto_medium_black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/last_assessment" />

                    <TextView
                        android:id="@+id/tv_assessment_date"
                        style="@style/font_14sp_roboto_medium_black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/tv_header_2"
                        android:text="03/01/2023" />
                </RelativeLayout>


            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/retakeButtonLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:gravity="center"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnRetake"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="0.5"
                android:background="@drawable/wyh_round_btn"
                android:fontFamily="@font/roboto_black"
                android:gravity="center"
                android:text="Retake"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnOk"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="0.5"
                android:background="@drawable/wyh_round_btn"
                android:fontFamily="@font/roboto_black"
                android:gravity="center"
                android:text="OK"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />
    </RelativeLayout>
</layout>