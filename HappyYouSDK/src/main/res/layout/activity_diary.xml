<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".diary.DiaryActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivHomeBgBottom"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/unwind_bg" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="370dp">


                    <com.airbnb.lottie.LottieAnimationView
                        android:layout_width="200dp"
                        android:layout_height="140dp"
                        android:layout_centerInParent="true"
                        android:layout_gravity="center"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/bear_rocking_chair_reading_book" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_below="@+id/includeToolbar"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.devlomi.hidely.hidelyviews.HidelyLinearLayout
                        android:id="@+id/diary_search_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/corner_back_black"
                        android:layout_weight="1.8"
                        android:visibility="invisible"
                        android:layout_marginEnd="18dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/diary_search_et"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.8"
                            android:hint="@string/search_bar_txt"
                            android:layout_margin="12dp"
                            android:textSize="16sp"
                            android:inputType="text"
                            android:maxLines="1"
                            android:background="@color/transparent"
                            android:fontFamily="@font/roboto_medium"/>

                        <ImageView
                            android:id="@+id/diary_search_cancel"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_margin="12dp"
                            android:visibility="invisible"
                            android:src="@drawable/search_cancel"/>


                    </com.devlomi.hidely.hidelyviews.HidelyLinearLayout>

                    <ImageView
                        android:id="@+id/diary_search_img"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.2"
                        android:src="@drawable/ic_round_search_24px"
                        android:layout_toEndOf="@id/search_bar_layout" />

                </LinearLayout>


                <include
                    android:id="@+id/includeToolbar"
                    layout="@layout/layout_back" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="-60dp"
                android:layout_marginHorizontal="@dimen/margin_16dp"
                android:layout_marginBottom="@dimen/margin_10dp">

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/font_16sp_roboto_medium_black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:layout_weight="1"
                    android:textAlignment="center"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDocumentName"
                    style="@style/font_16sp_roboto_medium_black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Document Name"
                    android:textAlignment="center"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOption"
                    style="@style/font_16sp_roboto_medium_black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit/Delete"
                    android:textAlignment="center"
                    android:textStyle="bold" />



            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/diaryListRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="5dp"
                android:layout_marginHorizontal="@dimen/margin_16dp"
                tools:itemCount="5"
                tools:listitem="@layout/diary_list_item"
                android:visibility="visible"/>

            <LinearLayout
                android:id="@+id/ll_no_record_found"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/margin_16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.airbnb.lottie.LottieAnimationView
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/anim_bear_404" />

                <TextView
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:text="No Records Found"
                    android:textAlignment="center"
                    android:textColor="@color/btn_blue"
                    android:textSize="14sp" />
            </LinearLayout>




        </LinearLayout>

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />
    </RelativeLayout>



</layout>