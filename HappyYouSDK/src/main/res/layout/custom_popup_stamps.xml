<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:elevation="30dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_red_bg"
            android:visibility="gone" />


        <dev.skymansandy.scratchcardlayout.ui.ScratchCardLayout
            android:id="@+id/scratchView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_260sdp"
            android:layout_centerInParent="true"
            android:background="@android:color/transparent"
            android:backgroundTint="@android:color/transparent"
            app:cardElevation="0dp"
            app:scratchEnabled="true"
            app:scratchDrawable="@drawable/scratch_card_pink_new"
            app:scratchRevealFullAtPercent="60"
            app:scratchWidth="50dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:background="@drawable/one_sided_curved_border"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/margin_32dp"
                    android:paddingTop="@dimen/margin_16dp">

                    <ImageView
                        android:id="@+id/ivScratch"
                        android:layout_width="wrap_content"
                        android:layout_height="90dp"
                        android:layout_marginHorizontal="@dimen/margin_16dp"
                        android:layout_marginTop="@dimen/margin_32dp"
                        android:src="@drawable/rewards_scratchable" />

                    <TextView
                        android:id="@+id/tvTitle"
                        style="@style/font_18sp_roboto_medium_black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/ivScratch"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Reward Name" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvTitle">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center"
                                tools:text="Congratulations! You have earned" />

                            <TextView
                                android:id="@+id/tvPoints"
                                style="@style/font_26sp_roboto_medium_black"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="Points" />

                            <TextView
                                android:id="@+id/tvDescription2"
                                style="@style/font_16sp_roboto_medium_black"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center"
                                android:visibility="visible"
                                tools:text="" />

                        </LinearLayout>

                    </ScrollView>

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/llActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/margin_32dp"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:layout_marginBottom="@dimen/margin_10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPositive"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/blue_rc_bg_8dp"
                        android:fontFamily="@font/roboto_medium"
                        android:text="View"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16dp" />


                    <Button
                        android:id="@+id/btnNegative"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="@dimen/margin_10dp"
                        android:layout_marginTop="@dimen/margin_10dp"
                        android:background="@drawable/pink_rc_bg_8dp"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Close"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16dp"
                        android:visibility="visible" />

                </LinearLayout>

            </LinearLayout>
        </dev.skymansandy.scratchcardlayout.ui.ScratchCardLayout>

    </RelativeLayout>
</layout>
