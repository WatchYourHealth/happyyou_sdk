<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:id="@+id/rlMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".dashboard.OtherActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="42dp"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="8dp"
                    android:elevation="30dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close_black_24dp"/>

                <LinearLayout
                    android:id="@+id/spin_dialog_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/dashboard_spinner_bg">


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:id="@+id/ivSpinArrowout"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginTop="16dp"
                            android:src="@drawable/spin_arrow"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivOuterCircler"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginHorizontal="16dp"
                            android:src="@drawable/ic_spin_circle_background_shadow"
                            android:outlineAmbientShadowColor="#FFF655"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/ivSpinArrowout" />

                        <com.wyh.happyyousdk.utils.wheelview.LuckyWheel
                            android:id="@+id/lwv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="32dp"
                            app:background_color="@android:color/transparent"
                            app:layout_constraintBottom_toBottomOf="@id/ivOuterCircler"
                            app:layout_constraintEnd_toEndOf="@id/ivOuterCircler"
                            app:layout_constraintStart_toStartOf="@id/ivOuterCircler"
                            app:layout_constraintTop_toTopOf="@id/ivOuterCircler" >

                        </com.wyh.happyyousdk.utils.wheelview.LuckyWheel>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:id="@+id/spin_layout"
                        android:layout_marginTop="16dp">

                        <Button
                            android:id="@+id/click_to_spin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:text="@string/click_to_spin"
                            android:textAllCaps="false"
                            android:background="@drawable/spin_btn_img">

                        </Button>

                        <Button
                            android:id="@+id/click_to_disabled_spin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:hint="@string/click_to_spin"
                            android:textAllCaps="false"
                            android:visibility="gone"
                            android:background="@drawable/spin_btn_disabled_bg">

                        </Button>


                    </LinearLayout>




                </LinearLayout>



            </RelativeLayout>





        </LinearLayout>

    </RelativeLayout>


</layout>
