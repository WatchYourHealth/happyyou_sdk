<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/includeToolbar"
            layout="@layout/layout_back" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/includeToolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:orientation="vertical">


                    <TextView
                        style="@style/font_16sp_roboto_medium_black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/your_reminders"
                        android:textAlignment="center" />


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_reminders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_32dp"
                        android:layout_marginTop="@dimen/margin_16dp" />
                </LinearLayout>

                <TextView
                    style="@style/font_16sp_roboto_medium_black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_32dp"
                    android:text="Add a Reminder"
                    android:textAlignment="center" />

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="40dp"
                    android:layout_marginTop="@dimen/margin_16dp">

                    <EditText
                        android:id="@+id/et_reminder_name"
                        android:layout_width="fill_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/wyh_btn_grey_border"
                        android:hint="@string/add_title"
                        android:inputType="text"
                        android:maxLength="10"
                        android:paddingStart="@dimen/margin_10dp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="@dimen/margin_10dp"
                        android:src="@drawable/ic_edit" />
                </RelativeLayout>

                <!-- <RelativeLayout
                     android:id="@+id/rl_usersList"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:layout_gravity="center"
                     android:layout_marginHorizontal="40dp"
                     android:layout_marginTop="@dimen/margin_16dp"
                     android:visibility="gone"
                     android:background="@drawable/wyh_btn_grey_border">

                     <androidx.appcompat.widget.AppCompatSpinner
                         android:id="@+id/spinner_users"
                         android:layout_width="match_parent"
                         android:layout_height="40dp"
                         android:backgroundTint="@color/red" />

                 </RelativeLayout>-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">

                    <TimePicker
                        android:id="@+id/time_picker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:timePickerMode="spinner" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="40dp"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:background="@drawable/wyh_btn_grey_border">

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinner_reminderFrequency"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/red" />

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/cb_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_32dp"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <CheckBox
                            android:id="@+id/cb_sun"
                            style="@style/font_14sp_roboto_regular_black"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:onClick="onCheckboxClicked"
                            android:text="Sunday" />

                        <CheckBox
                            android:id="@+id/cb_mon"
                            style="@style/font_14sp_roboto_regular_black"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:onClick="onCheckboxClicked"
                            android:text="Monday" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <CheckBox
                            android:id="@+id/cb_tues"
                            style="@style/font_14sp_roboto_regular_black"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:onClick="onCheckboxClicked"
                            android:text="Tuesday" />

                        <CheckBox
                            android:id="@+id/cb_wed"
                            style="@style/font_14sp_roboto_regular_black"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:onClick="onCheckboxClicked"
                            android:text="Wednesday" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <CheckBox
                            android:id="@+id/cb_thur"
                            style="@style/font_14sp_roboto_regular_black"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:onClick="onCheckboxClicked"
                            android:text="Thursday" />

                        <CheckBox
                            android:id="@+id/cb_fri"
                            style="@style/font_14sp_roboto_regular_black"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:onClick="onCheckboxClicked"
                            android:text="Friday" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <CheckBox
                            android:id="@+id/cb_sat"
                            style="@style/font_14sp_roboto_regular_black"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:onClick="onCheckboxClicked"
                            android:text="Saturday" />

                        <CheckBox
                            android:id="@+id/cb_all"
                            style="@style/font_14sp_roboto_regular_black"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:onClick="onCheckboxClicked"
                            android:text="All"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="40dp"
                    android:layout_marginTop="@dimen/margin_32dp"
                    android:background="@drawable/wyh_btn_grey_border">

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinner_remindersName"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/red" />

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_add_reminder"
                        style="@style/font_16sp_roboto_medium_black"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:layout_marginVertical="@dimen/margin_16dp"
                        android:background="@drawable/wyh_round_btn"
                        android:paddingHorizontal="@dimen/margin_16dp"
                        android:text="Add"
                        android:layout_marginEnd="@dimen/margin_8dp"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_cancel_reminder"
                        style="@style/font_16sp_roboto_medium_black"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:layout_marginVertical="@dimen/margin_16dp"
                        android:background="@drawable/wyh_round_btn"
                        android:paddingHorizontal="@dimen/margin_16dp"
                        android:text="Cancel"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />
    </RelativeLayout>
</layout>