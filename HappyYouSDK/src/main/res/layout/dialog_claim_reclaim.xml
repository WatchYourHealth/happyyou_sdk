<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="42dp"
            app:cardCornerRadius="21dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/black"
                    android:textFontWeight="700"
                    android:textSize="21dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivRetakeQuiz"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_banner_quiz"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle" />

                <TextView
                    android:id="@+id/lblRetakeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/information"
                    android:textColor="@color/pink"
                    android:textFontWeight="700"
                    android:textSize="21dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivRetakeQuiz"

                    />

                <TextView
                    android:id="@+id/tvRetakeMessageTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="35dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineHeight="20dp"
                    android:textColor="@color/dark_card_grey"
                    android:textFontWeight="400"
                    android:textSize="14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblRetakeTitle"
                    tools:text="No worries! You can take another quiz using your Happy You Points." />

                <TextView
                    android:id="@+id/tvRetakeMessageBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="35dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineHeight="20dp"
                    android:visibility="gone"
                    android:textColor="@color/dark_card_grey"
                    android:textFontWeight="400"
                    android:textSize="14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvRetakeMessageTop"
                    tools:text="No worries! You can take another quiz using your Happy You Points." />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mcvExpiredHrs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="16dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvRetakeMessageBottom"
                    app:strokeColor="@color/pink"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvExpiredHours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginVertical="6dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textFontWeight="500"
                        tools:text="29:46:58" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvRetakeBurnValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="35dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineHeight="20dp"
                    android:textColor="@color/dark_card_grey"
                    android:textFontWeight="700"
                    android:textSize="18dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/mcvExpiredHrs"
                    tools:text="100 Points" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/tvRetakeBurnValue"
                    app:layout_constraintStart_toStartOf="@+id/tvRetakeBurnValue"
                    app:layout_constraintTop_toBottomOf="@+id/tvRetakeBurnValue">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mcvRewardClaim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:elevation="2dp"
                        app:cardBackgroundColor="@color/blue"
                        app:cardCornerRadius="8dp">

                        <TextView
                            android:id="@+id/tvButtonClaim"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="24dp"
                            android:layout_marginVertical="8dp"
                            android:gravity="center"
                            android:text="Claim"
                            android:textColor="@color/white" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mcvRewardClose"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:elevation="2dp"
                        app:cardBackgroundColor="@color/pink"
                        app:cardCornerRadius="8dp">

                        <TextView
                            android:id="@+id/tvButtonClose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="24dp"
                            android:layout_marginVertical="8dp"
                            android:gravity="center"
                            android:text="Close"
                            android:textColor="@color/white" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>