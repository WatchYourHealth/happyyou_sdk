<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_root">
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rlUpperCard"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        android:background="@drawable/ic_policy_header"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/imBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/ic_policy_back"
            />
        <ImageView
            android:id="@+id/imKotakLogo"
            android:layout_toEndOf="@+id/imBack"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:layout_marginTop="50dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_policy_kotak_logo"
            />
        <TextView
            android:layout_toEndOf="@+id/imKotakLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:layout_marginStart="8dp"
            android:textSize="16sp"
            android:text="Kotak Policy"
            android:textColor="@color/white"
            />

    </RelativeLayout>

</RelativeLayout>
</layout>