<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/wheel_screen_bg"
            android:orientation="vertical"
            android:weightSum="8">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.3"
                android:gravity="center"
                android:weightSum="2">

                <LinearLayout
                    android:id="@+id/logoImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_marginHorizontal="38dp"
                        android:background="@drawable/bg_policy_kgi_bottom"
                        android:backgroundTint="@color/white"
                        android:padding="30dp"
                        android:src="@drawable/new_icon" />

                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/new_login_bear" />


            </RelativeLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="5.5"
                android:weightSum="2">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="38dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/golden_border_bg"
                        android:orientation="vertical"
                        android:weightSum="2">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="4dp"
                            android:background="@drawable/spin_wheel_layout_bg"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:background="@drawable/spin_reward_name_bg"
                                android:orientation="vertical"
                                android:visibility="visible">

                                <TextView
                                    android:id="@+id/tvTitle1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Get More Benefits"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvTitle2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="30dp"
                                    android:layout_marginTop="20dp"
                                    android:layout_marginEnd="30dp"
                                    android:layout_marginBottom="20dp"
                                    android:text="Do You Wish To Link You \nCorporate Account"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="16sp" />

                                <LinearLayout
                                    android:id="@+id/llActions"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <Button
                                        android:id="@+id/btnYes"
                                        style="?android:attr/borderlessButtonStyle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="34dp"
                                        android:layout_gravity="center_horizontal"
                                        android:background="@drawable/blue_rc_bg_8dp"
                                        android:fontFamily="@font/roboto_medium"
                                        android:text="Yes"
                                        android:textAllCaps="false"
                                        android:textColor="@android:color/white"
                                        android:textSize="16dp" />


                                    <Button
                                        android:id="@+id/btnNo"
                                        style="?android:attr/borderlessButtonStyle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="34dp"
                                        android:layout_gravity="center_horizontal"
                                        android:layout_marginStart="@dimen/margin_10dp"
                                        android:layout_marginTop="@dimen/margin_10dp"
                                        android:background="@drawable/pink_rc_bg_8dp"
                                        android:fontFamily="@font/roboto_medium"
                                        android:text="No"
                                        android:textAllCaps="false"
                                        android:textColor="@android:color/white"
                                        android:textSize="16dp"
                                        android:visibility="visible" />

                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/time_out_layout"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="120dp"
                                    android:layout_gravity="center_horizontal|center_vertical"
                                    android:layout_marginHorizontal="32dp"
                                    android:layout_marginTop="20dp"
                                    android:src="@drawable/time_up_img">

                                </ImageView>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="12dp"
                                    android:text="@string/time_up_desc"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="16sp" />


                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llSpinWheel"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:layout_weight="1"
                                android:alpha="0.5"
                                android:background="@drawable/reward_mobile_num_bg"
                                android:clickable="false"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/mobile_timer_tv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="12dp"
                                    android:background="@drawable/timer_background"
                                    android:text="@string/timer"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="16sp" />


                                <TextView
                                    android:id="@+id/reward_hurry_up"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/hurry_up"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/reward_login_tv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="12dp"
                                    android:text="@string/claim_reward"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <LinearLayout
                                    android:id="@+id/skip_to_login"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="16dp"
                                    android:layout_marginTop="16dp"
                                    android:background="@drawable/mobile_num_bg"
                                    android:gravity="center">

                                    <EditText
                                        android:id="@+id/edtSpinWheelEmail"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:backgroundTint="@color/white"
                                        android:enabled="false"
                                        android:hint="Enter Your Corporate Email ID"
                                        android:inputType="textEmailAddress"
                                        android:textAlignment="center"
                                        android:textColorHint="#C5BABA"
                                        android:textSize="14sp" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/llSpinWheelSendOTP"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="16dp"
                                    android:layout_marginTop="16dp"
                                    android:background="@drawable/cream_background"
                                    android:clickable="false"
                                    android:gravity="center">

                                    <TextView
                                        android:id="@+id/tvSpinWheelSendOTP"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:padding="16dp"
                                        android:text="@string/continue_login"
                                        android:textAlignment="center"
                                        android:textColor="@color/black"
                                        android:textSize="14sp">

                                    </TextView>


                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvSkip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginBottom="10dp"
                                    android:padding="5dp"
                                    android:text="Skip"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"

                                    android:textSize="14sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llSpinWheelOTP"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/reward_mobile_num_bg"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/otp_countdown"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="12dp"
                                    android:background="@drawable/timer_background"
                                    android:text="@string/timer"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="16sp" />


                                <TextView
                                    android:id="@+id/hurry_up_tv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/hurry_up"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/log_in_tv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="12dp"
                                    android:text="@string/claim_reward"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvSpinWheel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="4dp"
                                    android:layout_marginBottom="4dp"
                                    android:text="An OTP will send to your email ID:\nabc@abc.com"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/llSpinWheelOTPForm"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:visibility="gone">

                                    <com.otpview.OTPTextView
                                        android:id="@+id/edtOTPSpinWheel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_horizontal"
                                        app:height="30dp"
                                        app:length="6"
                                        app:otp_box_background_active="@drawable/reward_otp_active_box"
                                        app:otp_box_background_inactive="@drawable/reward_otp_active_box"
                                        app:otp_text_size="12sp"
                                        app:width="30dp" />


                                </LinearLayout>

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:layout_alignParentBottom="true"
                                    android:layout_marginStart="20dp"
                                    android:layout_marginEnd="20dp"
                                    android:layout_marginBottom="15dp"
                                    android:background="@drawable/edit_text_border"
                                    android:backgroundTint="@color/blue"

                                    >

                                    <androidx.appcompat.widget.AppCompatSpinner
                                        android:id="@+id/spinnerSpinWheel"
                                        android:layout_width="match_parent"
                                        android:layout_height="40dp"
                                        android:background="@drawable/new_login_edit_text_bg"
                                        android:padding="8dp" />

                                    <ImageView
                                        android:id="@+id/imSpinnerSpinWheel"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_alignParentEnd="true"
                                        android:layout_centerVertical="true"
                                        android:layout_marginEnd="10dp"
                                        android:src="@drawable/dropdown_blue_arrow"
                                        android:visibility="invisible"
                                        app:tint="@color/black" />
                                </RelativeLayout>


                                <TextView
                                    android:id="@+id/tvResendOTPSpinWheel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="16dp"
                                    android:text="@string/resend_otp"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:visibility="gone" />


                                <LinearLayout

                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="16dp"
                                    android:layout_marginTop="16dp"
                                    android:layout_marginBottom="15dp"
                                    android:gravity="start"
                                    android:orientation="horizontal"
                                    android:weightSum="2">

                                    <TextView
                                        android:id="@+id/tvSpinWheelEditEmail"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="5dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/cream_background"
                                        android:padding="16dp"
                                        android:text="Edit Email"
                                        android:textAlignment="center"
                                        android:textColor="@color/black"
                                        android:textSize="14sp">

                                    </TextView>

                                    <TextView
                                        android:id="@+id/tvSpinWheelContinue"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="5dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/cream_background"
                                        android:padding="16dp"
                                        android:text="@string/continue_login"
                                        android:textAlignment="center"

                                        android:textColor="@color/black"
                                        android:textSize="14sp">

                                    </TextView>


                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvSkip2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginBottom="10dp"
                                    android:padding="5dp"
                                    android:text="Skip"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"

                                    android:textSize="14sp" />
                            </LinearLayout>

                        </LinearLayout>


                    </LinearLayout>

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivCelebration"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/llNonSpinWheel"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/new_login_bottom"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/getStartedHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="Corporate Email ID"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/new_login_edit_text_bg"
                android:gravity="center">

                <EditText
                    android:id="@+id/edtNonSpinWheelEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:enabled="false"
                    android:hint="Enter Your Corporate Email ID"
                    android:inputType="textEmailAddress"
                    android:textAlignment="center"
                    android:textColorHint="#C5BABA"
                    android:textSize="14sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnNonSpinWheelSendOTP"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="15dp"
                android:alpha="0.5"
                android:background="@drawable/ic_policy_search_btn"
                android:enabled="false"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvSkipNonSpinWheel"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:padding="5dp"
                android:text="Skip"
                android:textAlignment="center"
                android:textColor="@color/black"

                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llNonSpinWheelOTP"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/new_login_bottom"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvNonSpinWheel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:text="An OTP will send to your email ID:\nabc@abc.com"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llNonSpinWheelOTPForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone">

                <com.otpview.OTPTextView
                    android:id="@+id/edNonSpinWheelOTP"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    app:height="30dp"
                    app:length="6"
                    app:otp_box_background_active="@drawable/reward_otp_active_box"
                    app:otp_box_background_inactive="@drawable/reward_otp_active_box"
                    app:otp_text_size="12sp"
                    app:width="30dp" />


            </LinearLayout>

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="Select Corporate ID"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/edit_text_border"
                android:backgroundTint="@color/blue"

                >

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spinnerNonSpinWheel"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/new_login_edit_text_bg"
                    android:padding="8dp" />

                <ImageView
                    android:id="@+id/imSpinnerNonSpinWheel"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/dropdown_blue_arrow"
                    android:visibility="invisible"
                    app:tint="@color/black" />
            </RelativeLayout>


            <TextView
                android:id="@+id/tvResendOTP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="@string/resend_otp"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:visibility="gone" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:id="@+id/tvNonSpinWheelEditEmail"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/ic_policy_search_btn"
                    android:padding="16dp"
                    android:text="Edit Email"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvNonSpinWheelContinue"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/ic_policy_search_btn"
                    android:padding="16dp"
                    android:text="@string/continue_login"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
            </LinearLayout>


            <TextView
                android:id="@+id/tvSkipNonSpinWheelOTP"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:padding="5dp"
                android:text="Skip"
                android:textAlignment="center"
                android:textColor="@color/black"

                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

</layout>
