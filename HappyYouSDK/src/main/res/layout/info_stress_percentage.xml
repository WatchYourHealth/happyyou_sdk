<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margin_16dp">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/font_16sp_roboto_medium_black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_32dp"
            android:letterSpacing="0.03"
            android:text="Stress Range Info"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_10dp"
            android:orientation="horizontal"

            android:weightSum="2">

            <TextView
                style="@style/font_16sp_roboto_regular_black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="0.03"
                android:text="@string/_0_20" />

            <TextView
                style="@style/font_16sp_roboto_regular_black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.03"
                android:text="Warning" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_10dp"

            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                style="@style/font_16sp_roboto_regular_black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="0.03"
                android:text="@string/_21_40" />

            <TextView
                style="@style/font_16sp_roboto_regular_black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.03"
                android:text="High" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_10dp"
            android:orientation="horizontal"

            android:weightSum="2">

            <TextView
                style="@style/font_16sp_roboto_regular_black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="0.03"
                android:text="@string/_41_60" />

            <TextView
                style="@style/font_16sp_roboto_regular_black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.03"
                android:text="Moderate" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_10dp"
            android:orientation="horizontal"

            android:weightSum="2">

            <TextView
                style="@style/font_16sp_roboto_regular_black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="0.03"
                android:text="@string/_60" />

            <TextView
                style="@style/font_16sp_roboto_regular_black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.03"
                android:text="Low" />

        </LinearLayout>


        <Button
            android:id="@+id/btnOK"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="@dimen/margin_16dp"
            android:background="@drawable/wyh_round_btn"
            android:fontFamily="@font/roboto_black"
            android:gravity="center"
            android:paddingHorizontal="36dp"
            android:text="OK"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="visible" />

    </LinearLayout>


</layout>