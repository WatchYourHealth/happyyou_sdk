<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="150dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_activity_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:src="@drawable/policy_bg" />

            <!-- <RelativeLayout
                 android:layout_width="match_parent"
                 android:layout_height="206dp"
                 android:layout_below="@id/includeToolbar">

                 <com.airbnb.lottie.LottieAnimationView
                     android:id="@+id/la_bear"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:layout_alignParentBottom="true"
                     android:layout_centerHorizontal="true"
                     app:lottie_autoPlay="true"
                     app:lottie_loop="true"
                     app:lottie_rawRes="@raw/anim_bear_walking" />

             </RelativeLayout>-->

            <include
                android:id="@+id/includeToolbar"
                layout="@layout/layout_back" />

        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/margin_all_16">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:padding="@dimen/dimens_5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/adhar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:letterSpacing="0.03"
                android:text="@string/aadhar_desc"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:letterSpacing="0.03"
                android:text="@string/aadhar_desc2"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_32dp"
                android:letterSpacing="0.03"
                android:text="Enter your Aadhaar Number"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16sp"
                android:textStyle="bold" />

           <!-- <com.otpview.OTPTextView
                android:id="@+id/edtAadhaarNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_all_16"
                app:height="24dp"
                app:length="12"
                app:otp_box_background_active="@drawable/otp_active_box"
                app:otp_box_background_inactive="@drawable/otp_inactive_box"
                app:otp_text_size="@dimen/text_size_16sp"
                app:width="18dp" />-->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_all_16"
                android:layout_marginBottom="@dimen/_10sdp"
                app:passwordToggleEnabled="true"
                android:paddingStart="5dp"
                app:passwordToggleTint="@color/black">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtAadhaarNo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingStart="10dp"
                    android:maxLength="12"
                    android:textColor="@color/black"
                    android:background="@drawable/edit_text_border_blue_new"
                    android:textColorHint="@color/grey"
                    android:inputType="numberPassword" />
            </com.google.android.material.textfield.TextInputLayout>
<RelativeLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    >
            <TextView
                android:id="@+id/tvDisplayCaptcha"
                android:layout_width="150dp"
                android:layout_height="40dp"
                android:textColor="@color/white"
                android:text=""
                android:gravity="center_vertical"
                android:textAlignment="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:background="@drawable/blue_rc_bg_8dp"
                tools:ignore="RtlCompat" />
            <ImageView
                android:id="@+id/imRefresh"
                android:layout_toEndOf="@+id/tvDisplayCaptcha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_refresh"
                app:tint="@color/score_red_dark" />
    <EditText
        android:id="@+id/edtEnterCaptcha"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_alignParentEnd="true"
        android:background="@drawable/edit_text_border_blue_new"
        android:textColorHint="@color/grey"
        android:layout_marginStart="5dp"
        android:hint=" Verify captcha "
        android:layout_marginEnd="10dp"
        android:textAlignment="center"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="6"
        android:letterSpacing="0.03"
        android:paddingStart="18dp"
        android:singleLine="true"
        android:textSize="16sp"
        android:textColor="@color/black"
        tools:ignore="RtlSymmetry" />
</RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/checkBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                      android:visibility="gone"
                    android:buttonTint="@color/black" />

                <LinearLayout
                    android:id="@+id/llAgreement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:letterSpacing="0.03"
                        android:visibility="gone"
                        android:text="@string/user_agreement"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.03"
                        android:layout_weight="1"
                        android:textAlignment="textEnd"
                        android:text="Please accept User"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                         />
                    <TextView
                        android:id="@+id/tvAgreement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.03"
                        android:layout_weight="1"
                        android:text="  User Information Agreement"
                        android:textColor="@color/score_red_dark"
                        android:textSize="14sp"
                         />

                </LinearLayout>

            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmit"
                android:layout_width="100dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/blue_rc_bg_8dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/dimens_8dp"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="@dimen/margin_padding_32dp"
                android:text="Submit"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
</layout>
