<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@+id/recommended_parent_layout"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/ic_light_pink_button_bg">

            <RelativeLayout
                android:id="@+id/goalsMain"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/recomended_goal_img_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/recomended_goal_img"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/ic_tele_consultation"
                        app:tint="@color/white" />

                </LinearLayout>

                <TextView
                    android:id="@+id/recomended_goal_desc_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="center"
                    android:text="Run 10 Thousand Steps in a month"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/recomended_goal_complete_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/grey"
                    android:fontFamily="@font/roboto_medium"
                    android:visibility="gone"
                    android:gravity="center"
                    android:text="Completed"
                    android:layout_alignParentBottom="true"
                    android:textColor="@color/white"
                    android:textSize="14sp"/>

                <ImageView
                    android:id="@+id/goal_complete_check_img"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="@dimen/margin_10dp"
                    android:visibility="gone"
                    android:background="@drawable/blue_circle"
                    android:backgroundTint="@color/green"
                    android:src="@drawable/ic_check" />



                <ImageView
                    android:id="@+id/deleteGoal1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    app:cardElevation="5sp"
                    android:visibility="gone"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/delete_icon"
                    app:tint="@color/white" />

                <RelativeLayout
                    android:id="@+id/progress_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_alignParentBottom="true">

                    <ProgressBar
                        android:id="@+id/goal_progress_bar"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:max="100"
                        android:progress="50"
                        android:progressDrawable="@drawable/custom_progress_bar"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="30dp">

                    </ProgressBar>

                    <TextView
                        android:id="@+id/goal_points_tv"
                        style="@style/TextStyleBlack16sp"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_centerVertical="true"
                        android:gravity="center"
                        android:text="0 points"
                        android:textColor="@color/white"
                        android:textSize="@dimen/margin_10sp" />


                </RelativeLayout>






            </RelativeLayout>

            <TextView
                android:id="@+id/moreGoals"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center_horizontal"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="@string/see_all" />


        </RelativeLayout>

</layout>
