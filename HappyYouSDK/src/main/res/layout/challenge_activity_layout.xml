<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:id="@+id/challange_activity_parent_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/ic_light_pink_button_bg">

        <LinearLayout
            android:id="@+id/challange_activity_img_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/challange_activity_image"
                android:layout_width="37dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_tele_consultation"
                app:tint="@color/white" />

        </LinearLayout>

        <TextView
            android:id="@+id/challange_activity_name_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_8dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:hint="Challenge"
            android:textColor="@color/white"
            android:layout_above="@+id/challange_complete_tv"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/challange_complete_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_8dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:text="Completed" 
            android:textColor="@color/white"
            android:layout_above="@+id/progress_layout"
            android:visibility="gone"
            android:textSize="14sp"/>

        <ImageView
            android:id="@+id/complete_check_img"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentRight="true"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/margin_10dp"
            android:background="@drawable/blue_circle"
            android:backgroundTint="@color/green"
            android:src="@drawable/ic_check"
            android:visibility="gone"/>


        <ImageView
            android:id="@+id/challenge_activity_info"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_info"
            app:tint="@color/white" />


        <RelativeLayout
            android:id="@+id/progress_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">

            <ProgressBar
                android:id="@+id/challange_activity_progress_bar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/custom_progress_bar"
                app:trackCornerRadius="4dp"
                app:trackThickness="30dp">

            </ProgressBar>

            <TextView
                android:id="@+id/challange_activity_points_tv"
                style="@style/TextStyleBlack16sp"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="0 points"
                android:textColor="@color/white"
                android:textSize="@dimen/margin_10sp" />


        </RelativeLayout>

    </RelativeLayout>

</LinearLayout>