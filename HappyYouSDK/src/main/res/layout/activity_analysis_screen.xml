<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:nestedScrollingEnabled="true"
                tools:context=".Sonde.Activities.AnalysisScreen">

                <RelativeLayout
                    android:id="@+id/sonde_analysis_header_parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:background="@drawable/ic_hra_pink_bg"
                        android:elevation="4dp"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/analysis_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <LinearLayout
                                android:id="@+id/analysis_back_layout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/direction_ivBackImg"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginTop="1dp"
                                    android:layout_marginEnd="4dp"
                                    android:src="@drawable/ic_arrow_back"
                                    app:tint="@color/white" />

                                <TextView
                                    android:id="@+id/analysis_back"
                                    style="@style/font_16sp_roboto_medium_black"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_toRightOf="@+id/direction_ivBackImg"
                                    android:letterSpacing="0.03"
                                    android:text="@string/respiratory_check"
                                    android:textColor="@color/white"
                                    android:textStyle="bold" />

                            </LinearLayout>


                            <ImageView
                                android:id="@+id/history_img"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_alignParentEnd="true"
                                android:layout_gravity="end"
                                android:src="@drawable/sonde_history_icon" />


                        </RelativeLayout>

                        <TextView
                            android:id="@+id/health_score_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/analysis_header"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="@font/roboto_bold"
                            android:text="@string/health_score"
                            android:textColor="@color/white"
                            android:textSize="16sp">

                        </TextView>

                        <ImageView
                            android:id="@+id/analysis_bear"
                            android:layout_width="180dp"
                            android:layout_height="180dp"
                            android:layout_below="@+id/analysis_header"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="54dp"
                            android:src="@drawable/sonde_analysis_bear" />


                        <TextView
                            android:id="@+id/date_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="34dp"
                            android:layout_marginBottom="100dp"
                            android:fontFamily="@font/roboto_medium"
                            android:hint="January 10, 2024"
                            android:textColor="@color/white"
                            android:textSize="14sp" />


                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="135dp">


                        <LinearLayout
                            android:layout_width="260dp"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="110dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/sonde_analysis_score_tv"
                                style="@style/font_16sp_roboto_regular_black"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="32dp"
                                android:layout_marginTop="32dp"
                                android:gravity="center"
                                android:text="30"
                                android:textSize="32sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_heart_age_risk_score"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="Low risk"
                                    android:textColor="@color/black"
                                    android:textSize="16sp" />


                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:text="0"
                                android:layout_marginTop="16dp"
                                android:layout_marginEnd="8dp"
                                />

                            <com.mikhaellopez.circularprogressbar.CircularProgressBar
                                android:id="@+id/sonde_analysis_progress_bar"
                                android:layout_width="230dp"
                                android:layout_height="230dp"
                                app:cpb_background_progressbar_color="#ECEFF4"
                                app:cpb_background_progressbar_width="10dp"
                                app:cpb_progress_direction="to_left"
                                app:cpb_progress_max="200"
                                app:cpb_progressbar_color="@color/dark_pink"
                                app:cpb_progressbar_width="10dp"
                                app:cpb_round_border="true"
                                app:cpb_start_angle="270" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:text="100"
                                android:layout_marginTop="16dp"
                                android:layout_marginStart="8dp"
                                />

                        </LinearLayout>

                    </RelativeLayout>


                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/result_details_parent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/set_reminder_layout"
                    android:layout_below="@+id/sonde_analysis_header_parent">

                    <LinearLayout
                        android:id="@+id/respiratory_score_parent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/result_hint"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/btn_bg">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/roboto_medium"
                                android:padding="8dp"
                                android:text="@string/analysis_tip_1"
                                android:textColor="@color/black" />


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/btn_bg">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/roboto_medium"
                                android:padding="8dp"
                                android:text="@string/analysis_tip_2"
                                android:textColor="@color/black" />

                        </LinearLayout>




                    </LinearLayout>

                    <RelativeLayout
                        android:id="@+id/mental_health_score_parent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/mental_score_detail_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:scrollbars="vertical">

                        </androidx.recyclerview.widget.RecyclerView>


                    </RelativeLayout>

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/set_reminder_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/analysis_button_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <Button
                            android:id="@+id/start_m3_button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_below="@+id/mental_score_detail_list"
                            android:layout_marginStart="24dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="24dp"
                            android:background="@drawable/blue_rc_bg_16dp"
                            android:text="@string/sonde_retake"
                            android:textAllCaps="false"
                            android:textColor="@color/white">

                        </Button>

                        <Button
                            android:id="@+id/save_to_journal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_below="@+id/mental_score_detail_list"
                            android:layout_marginStart="24dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="24dp"
                            android:background="@drawable/pink_rc_bg_8dp"
                            android:text="@string/save_journal"
                            android:textAllCaps="false"
                            android:textColor="@color/white">

                        </Button>



                    </LinearLayout>

                    <TextView
                        android:id="@+id/m3_note_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_above="@+id/set_reminder_layout"
                        android:layout_marginHorizontal="6dp"
                        android:hint="@string/m3_note"
                        android:textAlignment="center"
                        android:textColor="@color/grey" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder"
                            android:textColor="@color/black"
                            android:textSize="16sp" />

                        <Switch
                            android:id="@+id/sonde_reminder_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:thumbTint="@color/blue_cyan"
                            tools:ignore="UseSwitchCompatOrMaterialXml" />


                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/respiratory_retake_btn"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="46dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="46dp"
                    android:text="@string/sonde_retake"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:background="@drawable/blue_rc_bg_16dp"/>





                <ImageView
                    android:id="@+id/analysis_home"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/margin_16dp"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:layout_marginEnd="@dimen/margin_8dp"
                    android:layout_marginBottom="@dimen/margin_8dp"
                    android:backgroundTint="@color/white"
                    android:backgroundTintMode="src_atop"
                    android:clickable="true"
                    android:elevation="@dimen/margin_8dp"
                    android:focusable="true"
                    android:scaleType="fitXY"
                    android:src="@drawable/home" />

            </RelativeLayout>


        </androidx.core.widget.NestedScrollView>


    </RelativeLayout>


</layout>
