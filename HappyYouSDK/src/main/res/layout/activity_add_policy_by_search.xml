<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_root">
<RelativeLayout android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/rlUpperCard"
        android:layout_width="wrap_content"
        android:layout_height="300dp"
        android:orientation="vertical">
        <ImageView

            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:src="@drawable/ic_policy_header"
            android:scaleType="fitXY"
            />
        <ImageView
            android:id="@+id/imBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/ic_policy_back"
            />
        <ImageView
            android:id="@+id/imKotakLogo"
            android:layout_toEndOf="@+id/imBack"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:layout_marginTop="50dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_policy_kotak_logo"
            />
        <TextView
            android:layout_toEndOf="@+id/imKotakLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:textSize="16sp"
            android:layout_marginStart="8dp"
            android:text="Kotak Policy"
            android:textColor="@color/white"
            />
        <LinearLayout
            android:id="@+id/llSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentBottom="true"
            >
            <EditText
                android:id="@+id/edtPolicyNumber"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="Enter Policy Number"
                android:background="@drawable/new_login_edit_text_bg"
                android:textColorHint="#C5BABA"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:padding="8dp"
                android:inputType="number"
                />

            <EditText
                android:id="@+id/edtDOB"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="Date of birth"
                android:background="@drawable/new_login_edit_text_bg"
                android:drawableEnd="@drawable/ic_policy_calender"
                android:textColorHint="#C5BABA"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:padding="8dp"
                android:editable="false"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/tvSearch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:scaleType="fitXY"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/ic_policy_search_btn"
                android:layout_marginTop="10dp"
                android:text="Search"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:paddingTop="8dp"
                />
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_alignParentBottom="true"
        android:id="@+id/getStartedLayout"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:orientation="vertical"
        android:background="@drawable/new_login_bottom"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/getStartedHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter OTP"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:gravity="center"/>
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please enter OTP sent to XXXXXXX633"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:gravity="center"/>

        <com.otpview.OTPTextView
            android:id="@+id/edtOTP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:height="42dp"
            app:length="6"
            app:otp_box_background_active="@drawable/otp_active_box_new"
            app:otp_box_background_inactive="@drawable/otp_active_box_new"
            app:otp_text_size="16sp"
            app:width="42dp" />
        <TextView
            android:id="@+id/tvResendOTP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="20dp"
            android:text="Resend"
            android:textColor="@color/black"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnSendOTP"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Verify OTP"
            android:layout_marginTop="8dp"
            android:textAllCaps="false"
            android:background="@drawable/ic_policy_search_btn"
            android:textColor="@color/black"
            />
    </LinearLayout>
    <ImageView
        android:id="@+id/imTransparent1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="invisible"
        android:scaleType="fitXY"
        android:layout_above="@+id/getStartedLayout"
        android:src="@drawable/t1"
        />
    <ImageView
        android:id="@+id/imTransparent2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="invisible"
        android:scaleType="fitXY"
        android:src="@drawable/t1"
        />

    <ImageView
        android:id="@+id/imSuccess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"

        android:src="@drawable/ic_policy_added_successfully"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tvNoPolicyFound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No Policy found"
        android:textColor="@color/black"
        android:visibility="gone" />

</RelativeLayout>
</layout>