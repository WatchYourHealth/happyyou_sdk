<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <RelativeLayout
                    android:id="@+id/header"
                    android:layout_width="wrap_content"
                    android:layout_height="340dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_activity_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_hra_pink_bg" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="206dp"
                        android:layout_below="@id/common_tool_bar">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <com.devlomi.hidely.hidelyviews.HidelyLinearLayout
                                android:id="@+id/tribe_search_layout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/corner_back_white"
                                android:visibility="invisible"
                                android:layout_weight="1.8"
                                android:layout_marginEnd="18dp"
                                android:orientation="horizontal">

                                <EditText
                                    android:id="@+id/tribe_search_et"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.8"
                                    android:hint="@string/search_bar_txt"
                                    android:layout_margin="12dp"
                                    android:textSize="16sp"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:background="@color/transparent"
                                    android:fontFamily="@font/roboto_medium"/>

                                <ImageView
                                    android:id="@+id/tribe_search_cancel"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_margin="12dp"
                                    android:visibility="invisible"
                                    android:src="@drawable/search_cancel"/>


                            </com.devlomi.hidely.hidelyviews.HidelyLinearLayout>

                            <ImageView
                                android:id="@+id/tribe_search_img"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"
                                android:tint="@color/white"
                                android:src="@drawable/ic_round_search_24px"
                                android:layout_toEndOf="@id/search_bar_layout" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imageView"
                            android:layout_width="200dp"
                            android:layout_height="140dp"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            android:src="@drawable/happy_3_screen2" />

                    </RelativeLayout>

                    <include
                        android:id="@+id/common_tool_bar"
                        layout="@layout/layout_back" />

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/mytibe_parent_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="-42dp"
                    android:layout_marginBottom="@dimen/margin_8dp"
                    android:layout_below="@+id/header">

                    <RelativeLayout
                        android:id="@+id/title"
                        android:layout_marginHorizontal="@dimen/margin_12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/iv_back"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_tribe" />

                        <TextView
                            android:id="@+id/tv_title"
                            style="@style/font_15sp_roboto_medium_black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:layout_marginStart="6dp"
                            android:layout_toEndOf="@+id/iv_back"
                            android:text="My Tribes" />

                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvComs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/title"
                        android:layout_marginHorizontal="@dimen/margin_12dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="@dimen/margin_12dp"
                    android:layout_marginBottom="@dimen/margin_8dp"
                    android:layout_below="@+id/mytibe_parent_layout">

                    <RelativeLayout
                        android:id="@+id/titleothers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rvComs">

                        <ImageView
                            android:id="@+id/iv_back2"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_tribe" />

                        <TextView
                            android:id="@+id/tv_title2"
                            style="@style/font_15sp_roboto_medium_black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:layout_marginStart="6dp"
                            android:layout_toEndOf="@+id/iv_back2"
                            android:text="Other Tribes" />

                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvComs2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/titleothers"
                        android:layout_marginBottom="60dp"/>


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/no_result_found_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/mytibe_parent_layout"
                    android:visibility="gone"
                    android:layout_centerHorizontal="true"
                    android:orientation="vertical">

                    <com.airbnb.lottie.LottieAnimationView
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        app:lottie_autoPlay="true"
                        app:lottie_rawRes="@raw/anim_bear_404" />

                    <TextView
                        style="@style/TextStyleBlack16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/margin_16dp"
                        android:text="No Records Found"
                        android:textAlignment="center"
                        android:textColor="@color/btn_blue"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_retake"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:layout_marginBottom="@dimen/margin_16dp"
                    android:background="@drawable/wyh_round_btn"
                    android:fontFamily="@font/roboto_black"
                    android:gravity="center"
                    android:paddingHorizontal="36dp"
                    android:text="Chat"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />
    </RelativeLayout>


</layout>
