<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ChallangesModule.Walkathon.Activities.EnrolledChallengeActivity">

       <ScrollView
           android:layout_width="match_parent"
           android:layout_height="match_parent">

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="match_parent"
               android:orientation="vertical">

               <RelativeLayout
                   android:id="@+id/scan_header_layout"
                   android:layout_width="wrap_content"
                   android:layout_height="300dp"
                   android:orientation="vertical">

                   <ImageView
                       android:id="@+id/iv_activity_bg"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:scaleType="fitXY"
                       android:src="@drawable/ic_hra_blue_bg" />

                   <RelativeLayout
                       android:layout_width="match_parent"
                       android:layout_height="240dp"
                       android:layout_marginHorizontal="@dimen/margin_16dp">

                       <RelativeLayout
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:layout_alignParentBottom="true"
                           android:layout_centerInParent="true">

                           <com.airbnb.lottie.LottieAnimationView
                               android:id="@+id/walking_bear"
                               android:layout_width="150dp"
                               android:layout_height="150dp"
                               android:layout_alignParentBottom="true"
                               app:lottie_autoPlay="true"
                               app:lottie_loop="true" />

                           <LinearLayout
                               android:id="@+id/count_layout"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_centerInParent="true"
                               android:layout_marginEnd="32dp"
                               android:layout_toRightOf="@+id/walking_bear"
                               android:orientation="vertical"
                               tools:visibility="visible">

                               <TextView
                                   android:layout_width="match_parent"
                                   android:layout_height="wrap_content"
                                   android:fontFamily="@font/roboto_bold"
                                   android:text="@string/india_count"
                                   android:textAlignment="center"
                                   android:textColor="@color/black"
                                   android:textSize="14sp">

                               </TextView>

                               <TextView
                                   android:id="@+id/all_count_tv"
                                   android:layout_width="match_parent"
                                   android:layout_height="wrap_content"
                                   android:fontFamily="@font/roboto_bold"
                                   tools:text="25000"
                                   android:textAlignment="center"
                                   android:textColor="@color/black"
                                   android:textSize="40sp">

                               </TextView>

                               <TextView
                                   android:id="@+id/all_total_count_tv"
                                   android:layout_width="match_parent"
                                   android:layout_height="wrap_content"
                                   android:fontFamily="@font/roboto_bold"
                                   tools:text="@string/india_count_hint"
                                   android:textAlignment="center"
                                   android:textColor="@color/black"
                                   android:textSize="14sp">

                               </TextView>


                           </LinearLayout>


                       </RelativeLayout>



                   </RelativeLayout>

                   <include
                       android:id="@+id/includeBack"
                       layout="@layout/layout_back" />

               </RelativeLayout>

               <RelativeLayout
                   android:id="@+id/enrollment_detail_layout"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginBottom="10dp"
                   android:visibility="visible"
                   android:layout_marginHorizontal="12dp"
                   android:orientation="horizontal">

                   <LinearLayout
                       android:id="@+id/steps_info_layout"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:orientation="horizontal"
                       android:layout_marginEnd="12dp"
                       android:padding="10dp"
                       android:weightSum="2">

                       <LinearLayout
                           android:layout_width="0dp"
                           android:layout_height="match_parent"
                           android:layout_marginEnd="8dp"
                           android:layout_weight="1"
                           android:orientation="vertical"
                           android:weightSum="2">

                           <TextView
                               android:layout_width="match_parent"
                               android:layout_height="0dp"
                               android:layout_weight="1"
                               android:fontFamily="@font/roboto_regular"
                               android:text="@string/branch_enrollment_txt"
                               android:textAlignment="center"
                               android:textColor="@color/black"
                               android:textSize="12sp">

                           </TextView>

                           <RelativeLayout
                               android:layout_width="match_parent"
                               android:layout_height="0dp"
                               android:layout_weight="1"
                               android:background="@drawable/total_steps_bg">

                               <TextView
                                   android:id="@+id/branch_enrollment_tv"
                                   android:layout_width="match_parent"
                                   android:layout_height="wrap_content"
                                   android:layout_centerInParent="true"
                                   android:fontFamily="@font/roboto_bold"
                                   android:text="NA"
                                   android:textAlignment="center"
                                   android:textColor="@color/black"
                                   android:textSize="12sp" />


                           </RelativeLayout>


                       </LinearLayout>

                       <LinearLayout
                           android:layout_width="0dp"
                           android:layout_height="match_parent"
                           android:layout_weight="1"
                           android:orientation="vertical">

                           <TextView
                               android:layout_width="match_parent"
                               android:layout_height="0dp"
                               android:layout_weight="1"
                               android:fontFamily="@font/roboto_regular"
                               android:text="@string/branch_enrollment_count_txt"
                               android:textAlignment="center"
                               android:textColor="@color/black"
                               android:textSize="12sp">

                           </TextView>

                           <RelativeLayout
                               android:layout_width="match_parent"
                               android:layout_height="0dp"
                               android:layout_weight="1"
                               android:background="@drawable/total_steps_bg">

                               <TextView
                                   android:id="@+id/branch_count_tv"
                                   android:layout_width="match_parent"
                                   android:layout_height="wrap_content"
                                   android:layout_centerInParent="true"
                                   android:fontFamily="@font/roboto_bold"
                                   android:text="NA"
                                   android:textAlignment="center"
                                   android:textColor="@color/black"
                                   android:textSize="12sp" />


                           </RelativeLayout>

                       </LinearLayout>


                   </LinearLayout>

                   <ImageView
                       android:id="@+id/info_img"
                       android:layout_width="20dp"
                       android:layout_height="20dp"
                       android:src="@drawable/ic_info"
                       android:layout_alignParentTop="true"
                       android:layout_alignParentEnd="true"
                       app:tint="@color/pink" />





               </RelativeLayout>




               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="vertical"
                   android:background="@drawable/carousel_bg"
                   android:layout_marginHorizontal="16dp"
                   android:padding="8dp">


                   <TextView
                       android:id="@+id/congrats_tv"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:text="@string/congratulations"
                       android:textAlignment="center"
                       android:textStyle="bold"
                       android:textSize="32sp"
                       android:textColor="@color/black"
                       android:padding="4dp">

                   </TextView>
                   <TextView
                       android:id="@+id/event_tv"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:text="@string/walkathon_event_text"
                       android:textAlignment="center"
                       android:textStyle="bold"
                       android:textSize="18sp"
                       android:textColor="@color/black"
                       android:padding="4dp">

                   </TextView>

                   <TextView
                       android:id="@+id/tvStartDate"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:text="@string/walkathon_date"
                       android:textAlignment="center"
                       android:textStyle="bold"
                       android:textSize="24sp"
                       android:textColor="@color/red"
                       android:padding="4dp">

                   </TextView>


                   <TextView
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:text="@string/walkathon_event_enroll_text"
                       android:textAlignment="center"
                       android:layout_marginTop="12dp"
                       android:textSize="16sp"
                       android:visibility="gone"
                       android:textStyle="bold"
                       android:textColor="@color/black"
                       android:padding="4dp">

                   </TextView>

               </LinearLayout>

               <androidx.cardview.widget.CardView
                   android:id="@+id/scanqrbtn"
                   android:layout_width="match_parent"
                   android:layout_height="50dp"
                   android:elevation="4dp"
                   android:padding="5dp"
                   android:layout_marginHorizontal="16dp"
                   android:layout_marginTop="12dp"
                   app:cardCornerRadius="10dp">

                   <RelativeLayout
                       android:id="@+id/llScanBtn"
                       android:layout_width="match_parent"
                       android:layout_height="match_parent"
                       android:background="@color/blue">

                       <TextView
                           android:id="@+id/btntext"
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:layout_centerInParent="true"
                           android:text="Scan QR"
                           android:textAlignment="center"
                           android:textColor="@color/white"
                           android:textSize="@dimen/_15sdp"
                           android:textStyle="bold" />

                       <ImageView
                           android:layout_width="40dp"
                           android:layout_height="40dp"
                           android:layout_alignParentEnd="true"
                           android:layout_centerVertical="true"
                           android:layout_marginEnd="20dp"
                           android:src="@drawable/ic_qrwhite" />
                   </RelativeLayout>

               </androidx.cardview.widget.CardView>


               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="vertical">

                   <LinearLayout
                       android:id="@+id/new_enrolled_layout"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="16dp"
                       android:layout_marginStart="@dimen/margin_14dp"
                       android:layout_marginEnd="@dimen/margin_14dp"
                       android:layout_marginBottom="@dimen/margin_14dp"
                       android:orientation="vertical"
                       android:visibility="gone">

                       <LinearLayout
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:orientation="horizontal"
                           android:weightSum="4">

                           <TextView
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:text="@string/branch_code"
                               android:textSize="12sp"
                               android:textAlignment="center"
                               android:textColor="@color/black"
                               android:fontFamily="@font/roboto_regular"
                               android:padding="8dp"
                               android:textStyle="bold"/>

                           <TextView
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:text="@string/branch_name"
                               android:textAlignment="center"
                               android:textSize="12sp"
                               android:textColor="@color/black"
                               android:fontFamily="@font/roboto_regular"
                               android:padding="8dp"
                               android:textStyle="bold"/>

                           <TextView
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:text="@string/sonde_date"
                               android:textAlignment="center"
                               android:textSize="12sp"
                               android:textColor="@color/black"
                               android:fontFamily="@font/roboto_regular"
                               android:padding="8dp"
                               android:textStyle="bold"/>

                           <TextView
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:text="@string/code"
                               android:textAlignment="center"
                               android:textSize="12sp"
                               android:textColor="@color/black"
                               android:fontFamily="@font/roboto_regular"
                               android:padding="8dp"
                               android:textStyle="bold"/>


                       </LinearLayout>

                       <View
                           android:layout_width="match_parent"
                           android:layout_height="1dp"
                           android:background="@color/black"/>


                       <LinearLayout
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:orientation="horizontal"
                           android:weightSum="4">

                           <TextView
                               android:id="@+id/branch_id"
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:hint="@string/branch_code"
                               android:textSize="12sp"
                               android:textAlignment="center"
                               android:textColor="@color/black"
                               android:fontFamily="@font/roboto_regular"
                               android:padding="8dp"
                               android:textStyle="bold"/>

                           <TextView
                               android:id="@+id/branch_name"
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:hint="@string/branch_name"
                               android:textAlignment="center"
                               android:textSize="12sp"
                               android:textColor="@color/black"
                               android:fontFamily="@font/roboto_regular"
                               android:padding="8dp"
                               android:textStyle="bold"/>

                           <TextView
                               android:id="@+id/enroll_date"
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:hint="@string/sonde_date"
                               android:textAlignment="center"
                               android:textSize="12sp"
                               android:textColor="@color/black"
                               android:fontFamily="@font/roboto_regular"
                               android:padding="8dp"
                               android:textStyle="bold"/>

                           <TextView
                               android:id="@+id/enroll_address"
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:hint="@string/code"
                               android:textAlignment="center"
                               android:textSize="12sp"
                               android:textColor="@color/black"
                               android:fontFamily="@font/roboto_regular"
                               android:padding="8dp"
                               android:textStyle="bold"/>




                       </LinearLayout>


                   </LinearLayout>
                   <RelativeLayout
                       android:id="@+id/sync_device_layout"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_gravity="center_horizontal"
                       android:visibility="gone"
                       android:layout_marginVertical="16dp">

                       <androidx.cardview.widget.CardView
                           android:id="@+id/sync_device_btn"
                           android:layout_width="wrap_content"
                           android:layout_height="40dp"
                           android:elevation="4dp"
                           app:cardCornerRadius="10dp">

                           <RelativeLayout
                               android:id="@+id/ll_sync_device_btn"
                               android:layout_width="match_parent"
                               android:layout_height="match_parent"
                               android:paddingHorizontal="32dp"
                               android:background="@color/pink">

                               <TextView
                                   android:layout_width="wrap_content"
                                   android:layout_height="wrap_content"
                                   android:layout_centerInParent="true"
                                   android:text="Sync Your Device"
                                   android:textAlignment="center"
                                   android:textColor="@color/white"
                                   android:textSize="16sp"
                                   android:textStyle="bold" />


                           </RelativeLayout>

                       </androidx.cardview.widget.CardView>

                   </RelativeLayout>
                   <androidx.cardview.widget.CardView
                       android:id="@+id/rescanqrbtn"
                       android:layout_width="150dp"
                       android:layout_height="40dp"
                       android:elevation="4dp"
                       android:padding="5dp"
                       android:visibility="gone"
                       android:layout_marginTop="16dp"
                       android:layout_marginBottom="16dp"
                       android:layout_gravity="center_horizontal"
                       android:layout_marginHorizontal="16dp"
                       app:cardCornerRadius="10dp">

                       <RelativeLayout
                           android:id="@+id/llReScanBtn"
                           android:layout_width="match_parent"
                           android:layout_height="match_parent"
                           android:background="@color/blue">

                           <TextView
                               android:layout_width="wrap_content"
                               android:layout_height="wrap_content"
                               android:layout_centerInParent="true"
                               android:text="Re-Scan QR"
                               android:textAlignment="center"
                               android:textColor="@color/white"
                               android:textSize="@dimen/_15sdp"
                               android:textStyle="bold" />


                       </RelativeLayout>

                   </androidx.cardview.widget.CardView>


                   <LinearLayout
                       android:id="@+id/enrolled_history_layout"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_below="@+id/new_enrolled_layout"
                       android:layout_marginStart="@dimen/margin_14dp"
                       android:layout_marginEnd="@dimen/margin_14dp"
                       android:layout_marginBottom="@dimen/margin_14dp"
                       android:visibility="gone"
                       android:orientation="vertical">

                       <TextView
                           android:id="@+id/enroll_history"
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:text="@string/goal_history"
                           android:textSize="18sp"
                           android:layout_marginTop="18sp"
                           android:textAlignment="center"
                           android:textStyle="bold"
                           android:textColor="@color/black">

                       </TextView>

                       <LinearLayout
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:orientation="horizontal"
                           android:weightSum="4">

                           <TextView
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:text="@string/branch_code"
                               android:textSize="12sp"
                               android:textAlignment="center"
                               android:textColor="@color/black"
                               android:fontFamily="@font/roboto_regular"
                               android:padding="8dp"
                               android:textStyle="bold"/>

                           <TextView
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:text="@string/branch_name"
                               android:textAlignment="center"
                               android:textSize="12sp"
                               android:textColor="@color/black"
                               android:fontFamily="@font/roboto_regular"
                               android:padding="8dp"
                               android:textStyle="bold"/>

                           <TextView
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:text="@string/sonde_date"
                               android:textAlignment="center"
                               android:textSize="12sp"
                               android:textColor="@color/black"
                               android:fontFamily="@font/roboto_regular"
                               android:padding="8dp"
                               android:textStyle="bold"/>


                           <TextView
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:text="@string/code"
                               android:textAlignment="center"
                               android:textSize="12sp"
                               android:textColor="@color/black"
                               android:fontFamily="@font/roboto_regular"
                               android:padding="8dp"
                               android:textStyle="bold"/>


                       </LinearLayout>

                       <View
                           android:layout_width="match_parent"
                           android:layout_height="1dp"
                           android:background="@color/black"/>

                       <androidx.recyclerview.widget.RecyclerView
                           android:layout_width="match_parent"
                           android:layout_height="160dp"
                           android:id="@+id/challenge_enrolled_list"
                           android:layout_marginTop="8dp"/>





                   </LinearLayout>



               </LinearLayout>


           </LinearLayout>


       </ScrollView>

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />










    </RelativeLayout>

</layout>