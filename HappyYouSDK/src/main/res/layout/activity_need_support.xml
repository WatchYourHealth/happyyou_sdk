<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/includeBack"
            layout="@layout/layout_back"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="@dimen/margin_16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="350dp">

                <ImageView
                    android:id="@+id/ivTopBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_hra_pink_bg" />

                <TextView
                    style="@style/font_20sp_roboto_medium_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="I am happy \nto help you"
                    android:textSize="24sp" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-90dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    >

                    <ImageView
                        android:id="@+id/iv_image"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/ic_hra_bear_5"
                        android:visibility="visible" />

                    <TextView
                        style="@style/font_18sp_roboto_regular_black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_16dp"
                        android:text="For any query you can reach me on"
                        android:textAlignment="center"
                        android:layout_marginHorizontal="@dimen/margin_32dp"
                        android:textSize="18sp" />

                    <TextView
                        style="@style/font_20sp_roboto_medium_black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/support_number"
                        android:textAlignment="center"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:layout_marginHorizontal="@dimen/margin_32dp"
                        android:textSize="28sp" />

                    <TextView
                        style="@style/font_18sp_roboto_regular_black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="or email us at"
                        android:textAlignment="center"
                        android:visibility="gone"
                        android:layout_marginHorizontal="@dimen/margin_10dp"
                        android:textSize="24sp" />

                    <TextView
                        style="@style/font_20sp_roboto_medium_black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/kotak_email"
                        android:textAlignment="center"
                        android:layout_marginTop="@dimen/margin_10dp"
                        android:layout_marginHorizontal="@dimen/margin_32dp"
                        android:textSize="16sp" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnPositive"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/blue_rc_bg_8dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Done"
                    android:layout_marginBottom="@dimen/_32sdp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16dp" />

            </RelativeLayout>


        </LinearLayout>

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />

    </RelativeLayout>

</layout>
