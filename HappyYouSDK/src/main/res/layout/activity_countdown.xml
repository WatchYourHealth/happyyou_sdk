<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".Sonde.Activities.CountdownActivity">

        <LinearLayout
            android:id="@+id/cancel_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="horizontal"
            android:visibility="gone"
            android:padding="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/cancel"
                app:tint="@color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Cancel"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="10dp"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/send_audio_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:orientation="horizontal"
            android:visibility="gone"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Send Audio"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="10dp"
                android:textColor="@color/white" />

        </LinearLayout>



        <TextView
            android:id="@+id/sec_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/speak_for_30_sec"
            android:layout_above="@+id/energy_tv"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"
            android:textColor="@color/grey"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/energy_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mental_health_question"
            android:layout_above="@+id/sonde_strings_img"
            android:textAlignment="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:textColor="@color/white"
            android:textSize="18sp" />


        <ImageView
            android:id="@+id/sonde_strings_img"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/sonde_strings"
            android:visibility="gone"
            android:layout_above="@+id/countdown_layout"
            android:layout_marginBottom="16dp">

        </ImageView>

        <RelativeLayout
            android:id="@+id/countdown_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">

            <TextView
                android:id="@+id/countdown_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="1"
                android:textSize="64sp"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/white"/>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_centerInParent="true"
                android:progressDrawable="@drawable/circular" />


        </RelativeLayout>

        <TextView
            android:id="@+id/get_ready_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/get_ready"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="@color/grey"
            android:visibility="gone"
            android:layout_below="@+id/countdown_layout"
            android:fontFamily="@font/roboto_medium"/>

        <TextView
            android:id="@+id/ahh_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/instruction_text"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_margin="16dp"
            android:textColor="@color/white"
            android:visibility="gone"
            android:fontFamily="@font/roboto_medium"
            android:layout_below="@+id/get_ready_tv"/>

        <RelativeLayout
            android:id="@+id/recording_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:layout_below="@id/ahh_tv">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/sec_remaining_tv"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:textSize="16sp"/>

            <RelativeLayout
                android:id="@+id/recording_mic_layout"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_centerInParent="true"
                android:background="@drawable/white_circle">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/sonde_mic_icon"
                    android:layout_centerInParent="true">

                </ImageView>


            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/recording_mic_layout"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:text="@string/recording"
                android:textSize="16sp"/>


            <ProgressBar
                android:id="@+id/recording_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_centerInParent="true"
                android:progressDrawable="@drawable/circular" />


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/loader_layout_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_centerInParent="true">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sonde_loader_list"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/sonde_audio_loader_bear"/>

            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/sonde_loader_list"
                android:textAlignment="center"
                android:textColor="@color/white"/>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/second_audio_button_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_alignParentBottom="true">

            <Button
                android:id="@+id/second_audio_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap here to start second audio"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:padding="8dp"
                android:background="@drawable/btn_bg_color"
                android:layout_centerInParent="true">

            </Button>



        </RelativeLayout>

    </RelativeLayout>
</layout>
