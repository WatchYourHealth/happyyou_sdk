<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/header_section"
            layout="@layout/header_section_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_section">

            <LinearLayout
                android:id="@+id/llCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:visibility="visible"
                android:weightSum="3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_all"
                    style="@style/Happy_You_Roboto_black"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="@dimen/margin_8dp"
                    android:layout_weight="1"
                    android:background="@drawable/ic_blue_button_bg"
                    android:text="All"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="@dimen/margin_12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEarned"
                    style="@style/Happy_You_Roboto_black"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="@dimen/margin_8dp"
                    android:layout_weight="1"
                    android:background="@drawable/wyh_btn_grey_8dp"
                    android:text="Earned"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="@dimen/margin_12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBurned"
                    style="@style/Happy_You_Roboto_black"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="@dimen/margin_8dp"
                    android:layout_weight="1"
                    android:background="@drawable/wyh_btn_grey_8dp"
                    android:text="Burned"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="@dimen/margin_12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_challenge"
                    style="@style/Happy_You_Roboto_black"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="@dimen/margin_8dp"
                    android:layout_weight=".6"
                    android:background="@drawable/wyh_btn_grey_8dp"
                    android:text="Challenge"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="@dimen/margin_12sp"
                    android:visibility="gone" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_no_record_found"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="-40dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llCategory">

                <com.airbnb.lottie.LottieAnimationView
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center"
                    app:lottie_autoPlay="true"
                    app:lottie_rawRes="@raw/anim_bear_404"
                    app:lottie_repeatCount="5"
                    app:lottie_repeatMode="restart" />

                <TextView
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:text="No Records Found"
                    android:textAlignment="center"
                    android:textColor="@color/btn_blue"
                    android:textSize="14sp" />
            </LinearLayout>

            <!--<RelativeLayout
                android:id="@+id/llSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="@dimen/margin_8dp"
                android:layout_marginBottom="@dimen/margin_16dp"
                android:visibility="gone"
                android:background="@drawable/gray_bg_with_border_8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spinnerHistoryFilterType"
                    style="@style/font_14sp_roboto_medium_black"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:backgroundTint="@color/btn_blue" />

            </RelativeLayout>-->


            <LinearLayout
                android:id="@+id/ll_data_available"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llCategory">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llSpinner">

                    <TextView
                        style="@style/font_14sp_roboto_medium_black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available points: "
                        android:textAlignment="textStart" />

                    <TextView
                        android:id="@+id/earnAndBurnedStamps"
                        style="@style/font_14sp_roboto_medium_black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="7235" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginVertical="@dimen/margin_8dp"
                    android:background="@color/gray979797" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <TextView
                        style="@style/font_14sp_roboto_medium_black"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Name" />

                    <TextView
                        style="@style/font_14sp_roboto_medium_black"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_8dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Points" />

                    <TextView
                        style="@style/font_14sp_roboto_medium_black"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Status" />

                    <TextView
                        style="@style/font_14sp_roboto_medium_black"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Date" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:itemCount="100"
                    android:paddingBottom="@dimen/_50sdp"
                    tools:listitem="@layout/activities_history_adapter" />


            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>