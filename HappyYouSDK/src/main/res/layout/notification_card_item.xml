<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/cvScoreItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/margin_10dp"
            android:background="@drawable/light_gray_border_rc_bg_8dp"
            android:orientation="horizontal">

           <LinearLayout
               android:layout_width="wrap_content"
               android:layout_height="match_parent">

               <ImageView
                   android:id="@+id/notificationImage"
                   android:layout_width="60dp"
                   android:layout_height="60dp"
                   android:layout_gravity="center_vertical"
                   android:background="@drawable/ic_notification_water"/>

           </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutScoreYourAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/margin_10dp">

                <TextView
                    android:id="@+id/title"
                    style="@style/font_14sp_roboto_medium_black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    tools:text="Title" />

                <TextView
                    android:id="@+id/des"
                    style="@style/font_14sp_roboto_regular_black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Des" />

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/font_12sp_roboto_medium_black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YOUR ANSWER"
                    android:textAlignment="textEnd"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:textColor="@color/gray979797" />
            </LinearLayout>


        </LinearLayout>


    </androidx.cardview.widget.CardView>

</layout>