<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:weightSum="2">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.9">

                <TextView
                    android:id="@+id/tvQuestion"
                    style="@style/font_28sp_roboto_medium_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="32dp"
                    android:layout_marginTop="32dp"
                    android:elevation="4dp"
                    android:text="Can you please tell me when were you born?"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivTopBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_hra_pink_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:gravity="end"
                    android:weightSum="2">

                    <ImageView
                        android:id="@+id/ivTopBear"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="32dp"
                        android:layout_weight="0.6"
                        android:src="@drawable/ic_hra_bear_3"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/ivTopBearSometimes"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="32dp"
                        android:layout_weight="0.68"
                        android:scaleType="fitXY"
                        android:src="@drawable/bear_sometimes"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ivTopBearAlways"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="32dp"
                        android:layout_weight="0.75"
                        android:scaleType="fitXY"
                        android:src="@drawable/bear_almost_always"
                        android:visibility="gone" />

                </LinearLayout>

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_32dp"
                    android:layout_marginTop="64dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/tvNever"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/light_gray_border_rc_bg_8dp"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:text="Never"
                            android:textColor="@color/black"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvSometimes"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:background="@drawable/light_gray_border_rc_bg_8dp"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:text="Sometimes"
                            android:textColor="@color/black"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/tvOften"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/light_gray_border_rc_bg_8dp"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:text="Often"
                            android:textColor="@color/black"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvAlways"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:background="@drawable/light_gray_border_rc_bg_8dp"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:text="Almost Always"
                            android:textColor="@color/black"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnOk"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="64dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/light_blue_rc_bg_8dp"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:paddingHorizontal="64dp"
                        android:text="OK"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textSize="18dp" />

                </LinearLayout>

            </RelativeLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="60dp"
                android:max="21"
                app:indicatorColor="@color/blue"
                app:trackCornerRadius="16dp"
                app:trackThickness="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_black"
                android:letterSpacing="0.03"
                android:text="Back"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_atop"
            android:clickable="true"
            android:elevation="@dimen/margin_8dp"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/home" />
    </RelativeLayout>
</layout>
