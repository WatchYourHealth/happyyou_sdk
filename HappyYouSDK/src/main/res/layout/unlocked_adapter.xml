<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <RelativeLayout
                android:id="@+id/rl_voucher_1"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight="1"
                android:background="@drawable/ic_light_pink_button_bg"
                android:clipChildren="true"
                android:clipToPadding="true">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivVendorLogo1"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvArticleHead1"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ivVendorLogo1"
                    android:layout_centerInParent="true"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginTop="8dp"
                    android:text="Article Name"
                    android:textColor="@color/white"
                    android:textSize="18dp" />

                <TextView
                    android:id="@+id/tv_article_1"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvArticleHead1"
                    android:layout_centerInParent="true"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="Article Name"
                    android:textColor="@color/white"
                    android:textSize="14dp" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rl_voucher_2"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/ic_light_blue_button_bg">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivVendorLogo2"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvArticleHead2"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ivVendorLogo2"
                    android:layout_centerInParent="true"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginTop="8dp"
                    android:text="Article Name"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_article_2"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvArticleHead2"
                    android:layout_centerInParent="true"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="Article Name"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rl_voucher_3"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginEnd="@dimen/margin_16dp"
                android:layout_weight="1"
                android:background="@drawable/ic_light_orange_button_bg">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivVendorLogo3"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvArticleHead3"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ivVendorLogo3"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginTop="8dp"
                    android:text="Article Name"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_article_3"
                    style="@style/TextStyleBlack16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvArticleHead3"
                    android:layout_centerInParent="true"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="Article Name"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>
</layout>
