<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <RelativeLayout
                android:id="@+id/rlTribe1"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:background="@drawable/light_blue_button_bg"
                android:clipChildren="true"
                android:layout_marginEnd="8dp"
                android:clipToPadding="true">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ivUnRead1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="3dp"
                    app:cardElevation="5sp"
                    app:cardCornerRadius="50dp"
                    app:cardBackgroundColor="@color/pink"
                    android:layout_alignParentEnd="true" >

                    <TextView
                        android:id="@+id/tvReadCount1"
                        style="@style/font_14sp_roboto_regular_white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_gravity="center"
                        android:text="0"
                        android:textAlignment="center"
                        android:textSize="10dp" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvComName1"
                    style="@style/font_14sp_roboto_medium_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:textAlignment="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:alpha="0.5"
                    android:background="@drawable/dark_gray_rc_bg_8dp"
                    android:gravity="center"
                    android:padding="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:weightSum="2"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvComMem1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:layout_alignParentBottom="true"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Members: 0"
                        android:textColor="@color/white"
                        android:textSize="10dp" />


                    <ImageView
                        android:id="@+id/tribe_chat_icon"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.4"
                        android:layout_margin="6dp"
                        android:src="@drawable/chat_01" />


                </LinearLayout>



            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlTribe2"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/ic_light_pink_button_bg"
                android:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ivUnRead2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="3dp"
                    app:cardElevation="5sp"
                    app:cardCornerRadius="50dp"
                    app:cardBackgroundColor="@color/pink"
                    android:layout_alignParentEnd="true" >

                    <TextView
                        android:id="@+id/tvReadCount2"
                        style="@style/font_14sp_roboto_regular_white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_gravity="center"
                        android:textSize="10dp"
                        android:text="0"
                        android:textAlignment="center" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvComName2"
                    style="@style/font_14sp_roboto_medium_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:textAlignment="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:alpha="0.5"
                    android:background="@drawable/dark_gray_rc_bg_8dp"
                    android:gravity="center"
                    android:padding="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:weightSum="2"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvComMem2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:layout_alignParentBottom="true"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Members: 0"
                        android:textColor="@color/white"
                        android:textSize="10dp" />


                    <ImageView
                        android:id="@+id/tribe_chat_icon2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.4"
                        android:layout_margin="6dp"
                        android:src="@drawable/chat_01" />


                </LinearLayout>



            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlTribe3"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/ic_light_orange_button_bg"
                android:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ivUnRead3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="3dp"
                    app:cardElevation="5sp"
                    app:cardCornerRadius="50dp"
                    app:cardBackgroundColor="@color/pink"
                    android:layout_alignParentEnd="true" >

                    <TextView
                        android:id="@+id/tvReadCount3"
                        style="@style/font_14sp_roboto_regular_white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_gravity="center"
                        android:textSize="10dp"
                        android:text="0"
                        android:textAlignment="center" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvComName3"
                    style="@style/font_14sp_roboto_medium_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:textAlignment="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:alpha="0.5"
                    android:background="@drawable/dark_gray_rc_bg_8dp"
                    android:gravity="center"
                    android:padding="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:weightSum="2"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvComMem3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:gravity="center"
                        android:layout_weight="1.6"
                        android:padding="8dp"
                        android:text="Members: 0"
                        android:textColor="@color/white"
                        android:textSize="10dp" />

                    <ImageView
                        android:id="@+id/tribe_chat_icon3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.4"
                        android:layout_margin="6dp"
                        android:src="@drawable/chat_01" />


                </LinearLayout>



            </RelativeLayout>


        </LinearLayout>

    </LinearLayout>
</layout>
