<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="210dp">

        <LinearLayout
            android:id="@+id/banner_layout_one"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/carousel_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/banner_img_one"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:scaleType="fitXY" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/banner_layout_two"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/carousel_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/banner_img_two"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:scaleType="fitXY" />


        </LinearLayout>

        <RelativeLayout
            android:id="@+id/single_policy_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:background="@drawable/user_profile_bg">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="80dp"
                android:layout_alignParentEnd="true"
                android:layout_marginRight="2dp"
                android:src="@drawable/bear_img" />



            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="24dp">

                <ImageView
                    android:id="@+id/btnEditProfile"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginBottom="16dp"
                    android:src="@drawable/ic_edit_profile_white" />

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/profile_img">

                <ImageView
                    android:id="@+id/health_locker"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/health_locker"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="4dp"/>

                <LinearLayout
                    android:id="@+id/profile_detail_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivProfile"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="12dp"
                        android:src="@drawable/user" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/new_user_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_medium"
                                android:textColor="@color/black"
                                android:textSize="22sp"
                                tools:text="Vaibhav Gawde" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/new_user_gender"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_regular"
                                    android:textColor="@color/black"
                                    android:textSize="12sp"
                                    tools:text="Male" />

                                <View
                                    android:id="@+id/separated_view"
                                    android:layout_width="1dp"
                                    android:layout_height="20dp"
                                    android:layout_marginHorizontal="6dp"
                                    android:layout_marginTop="2dp"
                                    android:background="@color/black" />

                                <TextView
                                    android:id="@+id/new_user_age"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_regular"
                                    android:textColor="@color/black"
                                    android:textSize="12sp"
                                    tools:text="29 Yrs" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llPolicyNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:fontFamily="@font/roboto_bold"
                                        android:text="@string/policy_number"
                                        android:gravity="center_vertical"
                                        android:textColor="@color/black"
                                        android:textSize="12sp" />

                                    <RelativeLayout
                                        android:id="@+id/add_policy_layout"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone"
                                        android:layout_marginStart="8dp">

                                        <ImageView
                                            android:layout_width="22dp"
                                            android:layout_height="22dp"
                                            android:src="@drawable/ic_add_circle_outline_24"
                                            android:padding="4dp"
                                            app:tint="@color/white" />

                                    </RelativeLayout>



                                </LinearLayout>


                                <TextView
                                    android:id="@+id/user_policy_num"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_regular"
                                    android:textColor="@color/black"
                                    android:textSize="12sp"
                                    tools:text="12012398/19874569" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llAddPolicy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="36dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/white_rc_bg_8dp"
                                    android:text="+"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:text="Add your policy"
                                    android:textColor="@color/black"
                                    android:textSize="16sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="0dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="14dp"
                    android:weightSum="2">

                    <LinearLayout
                        android:id="@+id/policy_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.7"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:text="@string/policy_exp_date"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/user_policy_expiry_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            tools:text="@string/exp_date" />

                    </LinearLayout>

                    <View
                        android:id="@+id/policy_abha_separator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="10dp"
                        android:layout_weight="0.01"
                        android:background="#6E6363" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="0.7"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:weightSum="2">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="bottom"
                            android:text="@string/abha_id_tv"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/abha_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="bottom"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            tools:text="1201u91356465456564564421" />

                        <RelativeLayout
                            android:id="@+id/add_abha_id"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/ic_add_circle_outline_24"
                                app:tint="@color/white" />

                        </RelativeLayout>


                    </LinearLayout>

                    <RelativeLayout
                        android:id="@+id/rlLinkedPolicies"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="4dp"
                        android:layout_weight="0.5"
                        android:background="@drawable/linked_policy_bg"
                        android:paddingVertical="4dp"
                        android:visibility="visible">

                        <RelativeLayout
                            android:id="@+id/btnLinkedPolicy"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">


                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center"
                                android:text="View all\npolicies"
                                android:textColor="@color/black"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                    </RelativeLayout>


                </LinearLayout>


            </RelativeLayout>


        </RelativeLayout>

    </RelativeLayout>

</layout>
