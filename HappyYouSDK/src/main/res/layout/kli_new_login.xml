<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/new_login_bg">
    <LinearLayout
        android:id="@+id/llHead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"

        >
        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="40dp"
            android:layout_marginStart="35dp"

            android:layout_weight="1"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_policy_kgi_bottom"
            android:backgroundTint="@color/white"
                android:src="@drawable/new_login_top_happy_you_log"
            />
        <ImageView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="-5dp"
            android:src="@drawable/new_login_bear"
            />

    </LinearLayout>
    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollableContent"
        android:layout_above="@+id/getStartedLayout"
        android:layout_width="match_parent"
        android:layout_below="@+id/llHead"
        android:layout_height="wrap_content"
     >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- App Logo and Title -->



            <!-- Benefits Section -->
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               >

               <LinearLayout
                   android:layout_weight="1"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="vertical"
                   android:background="@drawable/new_login_center_bg"
                   android:padding="16dp"
                   android:layout_marginStart="35dp"
                   android:layout_marginEnd="35dp"
                   android:layout_marginBottom="16dp">
                   <TextView
                       android:id="@+id/benefitsHeader"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:drawableLeft="@drawable/new_login_reward_color"
                       android:text=" Get Free Benefits"
                       android:textColor="@color/black"
                       android:textSize="18sp"
                       android:textStyle="bold"
                       android:layout_gravity="center"/>
                   <LinearLayout
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       android:background="@drawable/new_login_blue_border"
                       android:gravity="center"
                       >
                       <TextView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:text="Kickstart Your Journey With"
                           android:textColor="@color/black"
                           android:background="@drawable/edit_text_border_blue_new"
                           android:layout_marginTop="8dp"/>
                       <TextView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:text="150 FREE Points—Instantly Yours!"
                           android:textColor="@color/black"
                           android:textStyle="bold"
                           android:background="@drawable/edit_text_border_blue_new"
                           android:layout_marginBottom="10dp"
                           android:layout_marginTop="8dp"/>
                   </LinearLayout>

                   <LinearLayout
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       android:layout_marginTop="20dp"
                       android:background="@drawable/new_login_orange_border"
                       >
                       <TextView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:text="Your Wellness, Simplified - Track It All:"
                           android:textColor="@color/black"
                           android:layout_gravity="center"
                           android:layout_marginTop="8dp"/>
                       <TextView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:text="Steps, Calories, Water, Sleep"
                           android:layout_gravity="center"
                           android:textColor="@color/black"
                           android:textStyle="bold"
                           android:layout_marginBottom="10dp"
                           android:layout_marginTop="8dp"/>
                   </LinearLayout>
                   <LinearLayout
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       android:layout_marginTop="20dp"
                       android:background="@drawable/new_login_yellow_border"
                       android:gravity="center"
                       >
                       <TextView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:text="Enjoy 1 Year Of Free Tele-Consultation For"
                           android:textColor="@color/black"
                           android:layout_marginTop="8dp"/>
                       <TextView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"

                           android:text="You + 2 Family Members Across 13+ \nSpecialties"
                           android:textColor="@color/black"
                           android:layout_marginBottom="10dp"
                           android:layout_marginTop="8dp"/>
                   </LinearLayout>
                   <LinearLayout
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       android:gravity="center"
                       android:layout_marginTop="20dp"
                       android:background="@drawable/new_login_blue_border"
                       android:layout_gravity="center"
                       >
                       <TextView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:text="Earn Big: Accumulate"
                           android:textColor="@color/black"
                           android:layout_marginTop="8dp"/>
                       <TextView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:text="10,000 Points Worth Rewards Over Time!"
                           android:textColor="@color/black"
                           android:layout_marginBottom="10dp"
                           android:layout_marginTop="8dp"/>
                   </LinearLayout>
               </LinearLayout>

           </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Get Started Section with Rounded Top -->
    <LinearLayout
        android:layout_alignParentBottom="true"
        android:id="@+id/getStartedLayout"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:background="@drawable/new_login_bottom"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/getStartedHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get Started"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:gravity="center"/>

        <EditText
            android:id="@+id/edtMobileNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Your Mobile Number"
            android:inputType="phone"
            android:background="@drawable/new_login_edit_text_bg"
            android:padding="12dp"
            android:maxLength="10"
            android:textColorHint="#C5BABA"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnSendOTP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Get OTP"
            android:layout_marginTop="25dp"
            android:background="@drawable/new_login_otp_btn"
            android:backgroundTint="@color/dark_pink"
            android:textColor="@color/white"
            />
    </LinearLayout>
</RelativeLayout>
