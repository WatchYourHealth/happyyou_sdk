<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked state -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" /> <!-- Checkbox filled color when checked -->
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#4FC5CB" /> <!-- Border color -->
        </shape>
    </item>

    <!-- Default unchecked state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" /> <!-- Background color -->
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#4FC5CB" /> <!-- Border color when unchecked -->
        </shape>
    </item>
</selector>
